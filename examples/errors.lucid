# Recoverable error handling with ? in Lucid

class NotFoundError:
    message: str

class InvalidInputError:
    message: str

def parse_positive(s: str):
    val = int(s)
    if val <= 0:
        return InvalidInputError("number must be positive")
    return val

def double_input(s: str):
    val = parse_positive(s)?
    return val * 2

print("Success result:", double_input("21"))
print("Error result:  ", double_input("-5"))
