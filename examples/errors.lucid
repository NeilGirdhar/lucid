class NotFoundError:
    message: str

class PermissionError:
    message: str

def fetch_record(id: int) -> int | NotFoundError | PermissionError:
    if id == 0:
        return NotFoundError("record 0 not found")
    if id < 0:
        return PermissionError("negative id not allowed")
    return id * 10

def process_record(id: int) -> int | NotFoundError | PermissionError:
    val = fetch_record(id)?
    return val + 1

r1 = process_record(5)
print("Processed id 5:", r1)

err1 = process_record(0)
print("Processed id 0:", err1)

err2 = process_record(-1)
print("Processed id -1:", err2)
