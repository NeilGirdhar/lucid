# Fannkuch-Redux Benchmark (Permutation generation and prefix reversals)
import time

def fannkuch(n: int) -> list:
    p = list(range(n))
    q = list(range(n))
    s = list(range(n))
    sign = 1
    maxflips = 0
    sum_flips = 0
    m = n - 1

    while true:
        q0 = p[0]
        if q0 != 0:
            for i in range(1, n):
                q[i] = p[i]
            flips = 1
            while true:
                qq = q[q0]
                if qq == 0:
                    sum_flips += sign * flips
                    if flips > maxflips:
                        maxflips = flips
                    break
                q[q0] = q0
                if q0 >= 3:
                    i = 1
                    j = q0 - 1
                    while true:
                        t = q[i]
                        q[i] = q[j]
                        q[j] = t
                        i += 1
                        j -= 1
                        if i >= j:
                            break
                q0 = qq
                flips += 1

        if sign == 1:
            t = p[0]
            p[0] = p[1]
            p[1] = t
            sign = -1
        else:
            t = p[1]
            p[1] = p[2]
            p[2] = t
            sign = 1
            for i in range(2, n):
                sx = s[i]
                if sx != 0:
                    s[i] = sx - 1
                    break
                if i == m:
                    return [sum_flips, maxflips]
                s[i] = i
                t = p[0]
                for j in range(i + 1):
                    p[j] = p[j + 1]
                p[i + 1] = t

n = 7
t0 = time.time()
res = fannkuch(n)
t1 = time.time()

print("fannkuch(7):", res[0], res[1], "time:", t1 - t0)
