# A shared type representation for self-host/checker.lucid and
# self-host/codegen.lucid, written in Lucid: both phases need to know
# each expression's type (checker to reject a wrong program, codegen to
# pick the right C representation and resolve which `dispatch def`
# overload a call means), so the representation and the class/function
# tables built from it live here once, not duplicated in each.
#
# Deliberately small: `int`, `bool`, `str`, and a named class -- no
# generics, no unions, no inference beyond "what does this literal/
# parameter/field/return type say". A class's fields and a function's
# parameters/return type are always exactly one of these.

from .ast import TypeExpr, NamedType

sealed class LType:
    pass

class IntType(LType):
    pass

class BoolType(LType):
    pass

class StrType(LType):
    pass

class ClassType(LType):
    name: str

# A function/method's return type only, never a parameter, field, local
# variable, or list element type -- `none` isn't a value this subset
# can hold in a variable, only the type of "this call has nothing
# useful to hoist a declaration for". `resolve_type_expr` only produces
# it for a `-> none` (or omitted, see collect_function_signature)
# return-type annotation.
class NoneType(LType):
    pass

# `list[T]` for T in int/bool/str/a class -- no nested list[list[T]]
# (resolve_type_expr rejects it), and no other collection type in this
# subset. Reference semantics, not by-value: Value::List in
# lucid-runtime is Rc<RefCell<Vec<Value>>>, an alias of a list mutates
# every alias (verified: `b = a; b.append(3)` changes `len(a)` too) --
# the first reference-semantics type this subset represents, unlike
# every plain-struct class so far.
class ListType(LType):
    element_type: LType

def type_name(t: LType) -> str:
    match t as result:
        case IntType:
            return "int"
        case BoolType:
            return "bool"
        case StrType:
            return "str"
        case ClassType:
            return result.name
        case ListType:
            return "list[" + type_name(result.element_type) + "]"
        case NoneType:
            return "none"
        case _:
            return "?"

# Like type_name, but for building a C identifier (mangled_name in
# codegen.lucid) -- type_name's `list[int]` has brackets, which aren't
# valid in a C identifier.
def mangle_component(t: LType) -> str:
    match t as result:
        case ListType:
            return "list_" + mangle_component(result.element_type)
        case _:
            return type_name(t)

def types_equal(a: LType, b: LType) -> bool:
    match a as left:
        case IntType:
            match b as right:
                case IntType:
                    return true
                case _:
                    return false
        case BoolType:
            match b as right:
                case BoolType:
                    return true
                case _:
                    return false
        case StrType:
            match b as right:
                case StrType:
                    return true
                case _:
                    return false
        case ClassType:
            match b as right:
                case ClassType:
                    return left.name == right.name
                case _:
                    return false
        case ListType:
            match b as right:
                case ListType:
                    return types_equal(left.element_type, right.element_type)
                case _:
                    return false
        case NoneType:
            match b as right:
                case NoneType:
                    return true
                case _:
                    return false
        case _:
            return false

def type_list_equal(a: list[LType], b: list[LType]) -> bool:
    if len(a) != len(b):
        return false
    i = 0
    while i < len(a):
        if not types_equal(a[i], b[i]):
            return false
        i = i + 1
    return true

def resolve_type_expr(t: TypeExpr | none) -> LType | none:
    match t as result:
        case none:
            return none
        case NamedType:
            if result.name == "int":
                return IntType()
            if result.name == "bool":
                return BoolType()
            if result.name == "str":
                return StrType()
            if result.name == "none":
                return NoneType()
            if result.name == "list" and len(result.args) == 1:
                match resolve_type_expr(result.args[0]) as et:
                    case ListType:
                        return none
                    case NoneType:
                        return none
                    case LType:
                        return ListType(et)
                    case none:
                        return none
            if len(result.name) > 0 and result.name[0] >= "A" and result.name[0] <= "Z":
                return ClassType(result.name)
            return none
        case _:
            return none

class FieldSig:
    name: str
    field_type: LType

class ClassSig:
    name: str
    fields: list[FieldSig]

def field_type(cls: ClassSig, name: str) -> LType | none:
    for f in cls.fields:
        if f.name == name:
            return f.field_type
    return none

# A class is printable in this subset if every field is int/bool/str --
# codegen.lucid's per-class printer only knows how to format those three
# directly; a class-typed field would need its own nested printer call,
# not supported yet.
def is_printable_class(cls: ClassSig) -> bool:
    for f in cls.fields:
        match f.field_type as t:
            case ClassType:
                return false
            case ListType:
                return false
            case _:
                pass
    return true

class FuncSig:
    name: str
    param_types: list[LType]
    return_type: LType

# A function/dispatch name can have more than one FuncSig -- Lucid's
# multiple dispatch (docs/dispatch.md) lets several `dispatch def`s share
# a name, resolved by the STATIC argument types at the call site (this
# subset resolves purely statically, at check/codegen time, not with any
# runtime dispatch mechanism -- correct as long as every call's argument
# types are exactly known, which they always are in an int/bool/str/
# class-only subset with no subtyping).
class FuncTable:
    signatures: dict[str, list[FuncSig]]

def new_func_table() -> FuncTable:
    return FuncTable({:})

def register_signature(table: FuncTable, sig: FuncSig):
    match table.signatures.get(sig.name, none) as existing:
        case list[FuncSig]:
            existing.append(sig)
        case none:
            table.signatures[sig.name] = [sig]

def find_signature(table: FuncTable, name: str, arg_types: list[LType]) -> FuncSig | none:
    match table.signatures.get(name, none) as sigs:
        case list[FuncSig]:
            for sig in sigs:
                if type_list_equal(sig.param_types, arg_types):
                    return sig
            return none
        case none:
            return none

def has_any_signature(table: FuncTable, name: str) -> bool:
    match table.signatures.get(name, none) as sigs:
        case list[FuncSig]:
            return len(sigs) > 0
        case none:
            return false
