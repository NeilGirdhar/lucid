# The deepest proof points in this directory: load other self-hosted
# source files' own class/function definitions into the self-hosted
# parser and interpreter, then call their real functions and check the
# results -- not toy hand-written programs (interpreter_demo.lucid), and
# not just "it didn't crash" (a differential check against the host-run
# equivalent, pairwise, for the lexer section below).
#
# Part 1: load self-host/lexer.lucid's own source -- its Lexer/Token/
# LexError classes, its tokenize()/new_lexer() functions -- and call its
# own tokenize() on a sample program. Compared token-by-token against
# calling the *host-run* tokenize() (imported directly, executed by the
# reference interpreter) on the same sample: this catches an off-by-one
# in string indexing, a wrong self.line/column mutation, or a dict.get()
# default misbehaving, none of which eyeballing a token list would.
#
# Part 2: load self-host/ast.lucid, self-host/lexer.lucid, and
# self-host/parser.lucid together, and call parser.lucid's own parse()
# on a sample program -- one level deeper again: the self-hosted
# interpreter running the self-hosted parser, which itself calls the
# self-hosted lexer, all as interpreted code.
#
# Lucid, running Lucid, running Lucid.

from .parser import parse, ParserError
from .lexer import tokenize, Token, LexError
from .ast import ParsedModule, Stmt, Expr, Assignment, ExprStmt, Ident, Binary, Call, LiteralExpr, IntLit
from .interpreter import new_interpreter, run_statements, call_registered, Value, StrValue, IntValue, ListValue, ObjectValue, EvalError

def load(interp, path: str) -> none | ParseError | ParserError | LexError | EvalError:
    own_source = read_file(path)?
    parsed = parse(own_source)?
    run_statements(interp, parsed.statements)?
    return none

def describe_token_value(v: Value) -> str:
    match v as t:
        case ObjectValue:
            kind = "?"
            text = "?"
            line = "?"
            col = "?"
            match t.fields.get("kind", none) as kv:
                case StrValue:
                    kind = kv.value
                case _:
                    pass
            match t.fields.get("text", none) as tv:
                case StrValue:
                    text = tv.value
                case _:
                    pass
            match t.fields.get("line", none) as lv:
                case IntValue:
                    line = str(lv.value)
                case _:
                    pass
            match t.fields.get("column", none) as cv:
                case IntValue:
                    col = str(cv.value)
                case _:
                    pass
            return kind + "(" + text + ")@" + line + ":" + col
        case _:
            return "<not a token>"

print("--- Part 1: self-hosted tokenize(), checked against the host-run tokenize() ---")
sample = "def greet(name: str) -> str:\n    return \"Hello, \" + name\n"

interp1 = new_interpreter()
match load(interp1, "self-host/lexer.lucid") as load_outcome:
    case none:
        pass
    case ParseError:
        print("READ ERROR:", load_outcome.message)
    case ParserError:
        print("PARSE ERROR:", load_outcome.message)
    case LexError:
        print("LEX ERROR:", load_outcome.message, "at", load_outcome.line, load_outcome.column)
    case EvalError:
        print("EVAL ERROR:", load_outcome.message, "at", load_outcome.span.line, load_outcome.span.column)

tokenize_args: list[Value] = [StrValue(sample)]
match call_registered(interp1, "tokenize", tokenize_args) as interpreted_result:
    case ListValue:
        match tokenize(sample) as host_tokens:
            case LexError:
                print("host tokenize() failed:", host_tokens.message)
            case list[Token]:
                if len(interpreted_result.items) != len(host_tokens):
                    print("FAIL: token count differs -- interpreted", len(interpreted_result.items), "host", len(host_tokens))
                else:
                    i = 0
                    all_match = true
                    while i < len(host_tokens):
                        interpreted_desc = describe_token_value(interpreted_result.items[i])
                        host_tok = host_tokens[i]
                        host_desc = host_tok.kind + "(" + host_tok.text + ")@" + str(host_tok.line) + ":" + str(host_tok.column)
                        if interpreted_desc == host_desc:
                            print("PASS", i, interpreted_desc)
                        else:
                            print("FAIL", i, "interpreted =", interpreted_desc, "host =", host_desc)
                            all_match = false
                        i = i + 1
                    if all_match:
                        print("(all", len(host_tokens), "tokens match the host-run lexer exactly)")
    case EvalError:
        print("EVAL ERROR calling tokenize():", interpreted_result.message)
    case _:
        print("unexpected result calling tokenize()")

def describe_expr_host(e: Expr) -> str:
    match e as result:
        case Ident:
            return "Ident(" + result.name + ")"
        case LiteralExpr:
            match result.value as lit:
                case IntLit:
                    return "Int(" + str(lit.value) + ")"
                case _:
                    return "Literal(?)"
        case Binary:
            return "Binary(" + result.op + ", " + describe_expr_host(result.left) + ", " + describe_expr_host(result.right) + ")"
        case Call:
            parts: list[str] = []
            for a in result.args:
                parts.append(describe_expr_host(a.value))
            joined = ""
            i = 0
            while i < len(parts):
                if i > 0:
                    joined = joined + ", "
                joined = joined + parts[i]
                i = i + 1
            return "Call(" + describe_expr_host(result.func) + ", [" + joined + "])"
        case _:
            return "Expr(?)"

def describe_stmt_host(s: Stmt) -> str:
    match s as result:
        case Assignment:
            return "Assignment(" + describe_expr_host(result.target) + " = " + describe_expr_host(result.value) + ")"
        case ExprStmt:
            return "ExprStmt(" + describe_expr_host(result.expr) + ")"
        case _:
            return "Stmt(?)"

def field(ov: Value, name: str) -> Value | none:
    match ov as o:
        case ObjectValue:
            return o.fields.get(name, none)
        case _:
            return none

def describe_expr_interp(v: Value) -> str:
    match v as ov:
        case ObjectValue:
            if ov.class_name == "Ident":
                match field(v, "name") as nv:
                    case StrValue:
                        return "Ident(" + nv.value + ")"
                    case _:
                        return "Ident(?)"
            if ov.class_name == "LiteralExpr":
                match field(v, "value") as lit:
                    case ObjectValue:
                        if lit.class_name == "IntLit":
                            match field(lit, "value") as iv:
                                case IntValue:
                                    return "Int(" + str(iv.value) + ")"
                                case _:
                                    return "Int(?)"
                        return "Literal(?)"
                    case _:
                        return "Literal(?)"
            if ov.class_name == "Binary":
                op = "?"
                match field(v, "op") as opv:
                    case StrValue:
                        op = opv.value
                    case _:
                        pass
                left = "?"
                match field(v, "left") as lv:
                    case Value:
                        left = describe_expr_interp(lv)
                    case _:
                        pass
                right = "?"
                match field(v, "right") as rv:
                    case Value:
                        right = describe_expr_interp(rv)
                    case _:
                        pass
                return "Binary(" + op + ", " + left + ", " + right + ")"
            if ov.class_name == "Call":
                func_desc = "?"
                match field(v, "func") as fv:
                    case Value:
                        func_desc = describe_expr_interp(fv)
                    case _:
                        pass
                joined = ""
                match field(v, "args") as argsv:
                    case ListValue:
                        i = 0
                        while i < len(argsv.items):
                            if i > 0:
                                joined = joined + ", "
                            arg_value = "?"
                            match field(argsv.items[i], "value") as av:
                                case Value:
                                    arg_value = describe_expr_interp(av)
                                case _:
                                    pass
                            joined = joined + arg_value
                            i = i + 1
                    case _:
                        pass
                return "Call(" + func_desc + ", [" + joined + "])"
            return ov.class_name + "(?)"
        case _:
            return "<not an object>"

def describe_stmt_interp(v: Value) -> str:
    match v as ov:
        case ObjectValue:
            if ov.class_name == "Assignment":
                target = "?"
                match field(v, "target") as tv:
                    case Value:
                        target = describe_expr_interp(tv)
                    case _:
                        pass
                assigned_value = "?"
                match field(v, "value") as vv:
                    case Value:
                        assigned_value = describe_expr_interp(vv)
                    case _:
                        pass
                return "Assignment(" + target + " = " + assigned_value + ")"
            if ov.class_name == "ExprStmt":
                expr_desc = "?"
                match field(v, "expr") as ev:
                    case Value:
                        expr_desc = describe_expr_interp(ev)
                    case _:
                        pass
                return "ExprStmt(" + expr_desc + ")"
            return ov.class_name + "(?)"
        case _:
            return "<not an object>"

print("")
print("--- Part 2: self-hosted parse(), one level deeper (interpreter running parser running lexer) ---")

interp2 = new_interpreter()
match load(interp2, "self-host/ast.lucid") as ast_outcome:
    case none:
        pass
    case ParseError:
        print("READ ERROR (ast.lucid):", ast_outcome.message)
    case ParserError:
        print("PARSE ERROR (ast.lucid):", ast_outcome.message)
    case LexError:
        print("LEX ERROR (ast.lucid):", ast_outcome.message, "at", ast_outcome.line, ast_outcome.column)
    case EvalError:
        print("EVAL ERROR (ast.lucid):", ast_outcome.message, "at", ast_outcome.span.line, ast_outcome.span.column)
match load(interp2, "self-host/lexer.lucid") as lexer_outcome:
    case none:
        pass
    case ParseError:
        print("READ ERROR (lexer.lucid):", lexer_outcome.message)
    case ParserError:
        print("PARSE ERROR (lexer.lucid):", lexer_outcome.message)
    case LexError:
        print("LEX ERROR (lexer.lucid):", lexer_outcome.message, "at", lexer_outcome.line, lexer_outcome.column)
    case EvalError:
        print("EVAL ERROR (lexer.lucid):", lexer_outcome.message, "at", lexer_outcome.span.line, lexer_outcome.span.column)
match load(interp2, "self-host/parser.lucid") as parser_outcome:
    case none:
        pass
    case ParseError:
        print("READ ERROR (parser.lucid):", parser_outcome.message)
    case ParserError:
        print("PARSE ERROR (parser.lucid):", parser_outcome.message)
    case LexError:
        print("LEX ERROR (parser.lucid):", parser_outcome.message, "at", parser_outcome.line, parser_outcome.column)
    case EvalError:
        print("EVAL ERROR (parser.lucid):", parser_outcome.message, "at", parser_outcome.span.line, parser_outcome.span.column)

parse_sample = "x = 1 + 2\ny = x * 3\nprint(y)\n"
parse_args: list[Value] = [StrValue(parse_sample)]
match call_registered(interp2, "parse", parse_args) as parsed_result:
    case ObjectValue:
        match field(parsed_result, "statements") as stmts_val:
            case ListValue:
                match parse(parse_sample) as host_parsed:
                    case ParsedModule:
                        if len(stmts_val.items) != len(host_parsed.statements):
                            print("FAIL: statement count differs -- interpreted", len(stmts_val.items), "host", len(host_parsed.statements))
                        else:
                            i = 0
                            all_match = true
                            while i < len(host_parsed.statements):
                                interpreted_desc = describe_stmt_interp(stmts_val.items[i])
                                host_desc = describe_stmt_host(host_parsed.statements[i])
                                if interpreted_desc == host_desc:
                                    print("PASS", i, interpreted_desc)
                                else:
                                    print("FAIL", i, "interpreted =", interpreted_desc, "host =", host_desc)
                                    all_match = false
                                i = i + 1
                            if all_match:
                                print("(all", len(host_parsed.statements), "statements match the host-run parser exactly, field by field)")
                    case ParserError:
                        print("host parse() failed:", host_parsed.message)
                    case LexError:
                        print("host parse() failed (lex):", host_parsed.message)
            case _:
                print("'statements' field missing or wrong shape")
    case EvalError:
        print("EVAL ERROR calling parse():", parsed_result.message)
    case _:
        print("parse() did not return a ParsedModule (a ParserError/LexError propagated instead)")
