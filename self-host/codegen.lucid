# A C code generator for self-host/ast.lucid, written in Lucid: the code
# generation phase self-host/checker.lucid's own subset is scoped for,
# mirroring compiler/crates/lucid-codegen (which also emits C and shells
# out to a system C compiler -- Lucid has no subprocess/exec builtin by
# design, so *invoking* that compiler is necessarily a driver step
# outside Lucid, the same way it is a driver step outside the
# Rust-implemented codegen's own Lucid-facing surface; see
# compile_demo.lucid for the driver that writes this module's C output to
# a file and actually compiles and runs it). self-host/types.lucid holds
# the shared type representation and class/function tables both this
# file and self-host/checker.lucid build from the same AST -- codegen
# assumes its input already passed checker.lucid (it doesn't re-report
# errors; an unsupported construct becomes a C comment, not a rejection).
#
# Deliberately a small subset, not feature parity with lucid-codegen (a
# ~16,000-line crate with dynamic LucidVal boxing, generic numeric
# promotion, exception unwinding, and far more): `int`/`bool` are a C
# `long`, `str` a `const char*`, a class a plain (not heap-allocated) C
# struct passed and returned by value; arithmetic/comparison/logical
# operators on int/bool map straight to their C equivalents (`//`/`%`
# through two `static` helpers -- Lucid's are Euclidean, unlike C's
# truncating or Python's floored division: the remainder is always in
# [0, |b|) regardless of either operand's sign); a binary operator on two
# class-typed operands, or a call to a name with more than one
# `dispatch def`, resolves to one specific C function chosen by the
# static argument types, name-mangled by them (`__add___Vector2D_
# Vector2D`) since C has no overloading of its own; a Lucid function
# literally named `main` becomes C's own `int main(void)`; `print(...)`
# takes any number of int/bool/str arguments, each formatted by its own
# inferred type. Left for later: inheritance, generics, methods with
# `self`, collections, closures, exceptions, `?`, comprehensions --
# everything else checker.lucid's header comment's Rust counterpart
# covers, since codegen never accepts more than checker.lucid does.
# Also assumes (not yet enforced by checker.lucid) that every local
# variable is declared once, at the top level of its function body, not
# inside a nested if/while -- C's block scoping would otherwise make a
# variable declared inside one branch invisible after it, unlike Lucid's
# own more permissive same-function visibility.

from .ast import Expr, LiteralExpr, Ident, Binary, Unary, Call, Construct, Attribute, ListExpr, Arg, IntLit, BoolLit, StrLit, Stmt, ClassDef, ClassMember, FieldMember, FunctionStmt, VarDef, Assignment, If, For, While, Return, Break, Continue, Pass, ExprStmt, MetadataStmt, Pattern, IdentPattern, FunctionDef, Param
from .types import LType, IntType, BoolType, StrType, ClassType, type_name, resolve_type_expr, FieldSig, ClassSig, field_type, is_printable_class, FuncSig, FuncTable, new_func_table, register_signature, find_signature

runtime_prelude = "#include <stdio.h>\n#include <string.h>\n#include <stdlib.h>\n\n// Lucid's // and % are Euclidean: the remainder is always in [0, |b|),\n// unlike C's truncating / and % (whose remainder can be negative) and\n// unlike Python's floored // and % (whose remainder takes the sign of\n// the divisor, which can also be negative). Division by zero is\n// undefined behavior here, same as plain C -- this subset doesn't\n// generate the checked-division error path lucid-codegen's own runtime\n// ABI does.\nstatic long lucid_rt_mod(long a, long b) {\n    long r = a % b;\n    if (r < 0) {\n        r += (b < 0) ? -b : b;\n    }\n    return r;\n}\n\nstatic long lucid_rt_floordiv(long a, long b) {\n    long q = a / b;\n    long r = a % b;\n    if (r < 0) {\n        q += (b < 0) ? 1 : -1;\n    }\n    return q;\n}\n\n// str + str is this subset's first heap allocation -- freed nowhere\n// (see self-host/README.md's no-GC/no-arena note: every compiled\n// program runs once and exits).\nstatic const char *lucid_rt_str_concat(const char *a, const char *b) {\n    char *result = malloc(strlen(a) + strlen(b) + 1);\n    strcpy(result, a);\n    strcat(result, b);\n    return result;\n}"

def emit_struct(cls: ClassSig) -> str:
    fields: list[str] = []
    for f in cls.fields:
        fields.append("    " + c_type_of(f.field_type) + " " + f.name + ";")
    return "typedef struct {\n" + join_with(fields, "\n") + "\n} " + cls.name + ";"

# `print()` of a class value emits `ClassName({"field": value, ...})`,
# matching lucid-runtime's own default repr -- fields sorted by name
# (not declaration order): lucid-runtime's Value::Object stores fields
# in a HashMap, whose iteration order this subset's printer has to
# match, and HashMap order isn't declaration order (or even stable
# across runs, before a lucid-runtime fix made it sort by name too). A
# `str` field's value is wrapped in literal `"..."` with no escaping,
# matching lucid-runtime's own (also unescaped) `Debug` for `Str`. Only
# called for a class where is_printable_class(cls) is true -- every
# field int/bool/str, no nested class field to print.
def emit_print_function(cls: ClassSig) -> str:
    names: list[str] = []
    for f in cls.fields:
        names.append(f.name)
    format_parts: list[str] = []
    arg_exprs: list[str] = []
    for name in sorted(names):
        match field_type(cls, name) as ft:
            case StrType:
                format_parts.append("\\\"" + name + "\\\": \\\"%s\\\"")
                arg_exprs.append("value." + name)
            case BoolType:
                format_parts.append("\\\"" + name + "\\\": %s")
                arg_exprs.append("(value." + name + " ? \"true\" : \"false\")")
            case _:
                format_parts.append("\\\"" + name + "\\\": %ld")
                arg_exprs.append("value." + name)
    format_str = "\"" + cls.name + "({" + join_with(format_parts, ", ") + "})\""
    pieces: list[str] = [format_str]
    for a in arg_exprs:
        pieces.append(a)
    printf_call = "printf(" + join_with(pieces, ", ") + ");"
    return "static void lucid_print_" + cls.name + "(" + cls.name + " value) {\n    " + printf_call + "\n}"

def join_with(parts: list[str], sep: str) -> str:
    text = ""
    i = 0
    while i < len(parts):
        if i > 0:
            text = text + sep
        text = text + parts[i]
        i = i + 1
    return text

def dispatch_op_name(op: str) -> str | none:
    if op == "ADD":
        return "__add__"
    if op == "SUB":
        return "__sub__"
    if op == "MUL":
        return "__mul__"
    if op == "FLOOR_DIV":
        return "__floordiv__"
    if op == "MOD":
        return "__mod__"
    return none

def c_binary_op(op: str) -> str:
    if op == "ADD":
        return "+"
    if op == "SUB":
        return "-"
    if op == "MUL":
        return "*"
    if op == "LT":
        return "<"
    if op == "LT_EQ":
        return "<="
    if op == "GT":
        return ">"
    if op == "GT_EQ":
        return ">="
    if op == "EQ":
        return "=="
    if op == "NOT_EQ":
        return "!="
    if op == "AND":
        return "&&"
    if op == "OR":
        return "||"
    return "/* unsupported operator " + op + " */"

def c_type_of(t: LType) -> str:
    match t as result:
        case IntType:
            return "long"
        case BoolType:
            return "long"
        case StrType:
            return "const char *"
        case ClassType:
            return result.name
        case _:
            return "long"

def c_string_literal(s: str) -> str:
    escaped = s.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n").replace("\t", "\\t").replace("\r", "\\r")
    return "\"" + escaped + "\""

# The C name for a specific resolved overload of a Lucid function/
# dispatch name -- C has no overloading, so every signature beyond the
# first `dispatch def` for a name needs its own C identifier, mangled by
# its parameter types.
def mangled_name(table: FuncTable, sig: FuncSig) -> str:
    # C reserves every identifier that starts with two underscores, or
    # with one underscore followed by an uppercase letter (C11 7.1.3) --
    # `sig.name` is an arbitrary Lucid identifier, and Lucid's own dunder
    # convention for dispatch operators (`__add__`, `__mul__`, ...)
    # collides with exactly that reserved space. Every name this function
    # returns is prefixed with `lucid_`, unconditionally, even when a
    # dispatch name has only one registered signature and doesn't
    # strictly need mangling to stay unique -- a name that happens not to
    # collide with another Lucid overload today isn't the same guarantee
    # as never colliding with a reserved C identifier.
    match table.signatures.get(sig.name, none) as sigs:
        case list[FuncSig]:
            if len(sigs) <= 1:
                return "lucid_" + sig.name
        case none:
            pass
    parts: list[str] = ["lucid", sig.name]
    for pt in sig.param_types:
        parts.append(type_name(pt))
    return join_with(parts, "__")

class Codegen:
    functions: FuncTable
    classes: dict[str, ClassSig]

    def collect_declarations(self, stmts: list[Stmt]):
        for stmt in stmts:
            match stmt as result:
                case ClassDef:
                    fields: list[FieldSig] = []
                    for member in result.body:
                        match member as m:
                            case FieldMember:
                                match resolve_type_expr(m.field.type_annotation) as ft:
                                    case LType:
                                        fields.append(FieldSig(m.field.name, ft))
                                    case none:
                                        pass
                            case _:
                                pass
                    self.classes[result.name] = ClassSig(result.name, fields)
                case FunctionStmt:
                    fn = result.function
                    param_types: list[LType] = []
                    for p in fn.params:
                        match resolve_type_expr(p.type_annotation) as pt:
                            case LType:
                                param_types.append(pt)
                            case none:
                                pass
                    return_type: LType = IntType()
                    match resolve_type_expr(fn.return_type) as rt:
                        case LType:
                            return_type = rt
                        case none:
                            pass
                    register_signature(self.functions, FuncSig(fn.name, param_types, return_type))
                case _:
                    pass

    def infer_expr_type(self, expr: Expr, known: dict[str, LType]) -> LType | none:
        match expr as result:
            case LiteralExpr:
                match result.value as lit:
                    case IntLit:
                        return IntType()
                    case BoolLit:
                        return BoolType()
                    case StrLit:
                        return StrType()
                    case _:
                        return none
            case Ident:
                return known.get(result.name, none)
            case Binary:
                left_type = self.infer_expr_type(result.left, known)
                right_type = self.infer_expr_type(result.right, known)
                match left_type as lt:
                    case ClassType:
                        return self.dispatch_return_type(result.op, lt, right_type)
                    case _:
                        pass
                match right_type as rt:
                    case ClassType:
                        return self.dispatch_return_type(result.op, left_type, rt)
                    case _:
                        pass
                if result.op == "AND" or result.op == "OR" or result.op == "EQ" or result.op == "NOT_EQ" or result.op == "LT" or result.op == "LT_EQ" or result.op == "GT" or result.op == "GT_EQ":
                    return BoolType()
                if result.op == "ADD":
                    match left_type as lt:
                        case StrType:
                            match right_type as rt:
                                case StrType:
                                    return StrType()
                                case _:
                                    pass
                        case _:
                            pass
                return IntType()
            case Unary:
                return self.infer_expr_type(result.expr, known)
            case Construct:
                return ClassType(result.class_name)
            case Attribute:
                receiver_type = self.infer_expr_type(result.value, known)
                match receiver_type as rt:
                    case ClassType:
                        match self.classes.get(rt.name, none) as cls:
                            case ClassSig:
                                return field_type(cls, result.attr)
                            case none:
                                return none
                    case _:
                        return none
            case Call:
                match result.func as callee:
                    case Ident:
                        if callee.name == "len":
                            return IntType()
                        arg_types: list[LType] = []
                        for a in result.args:
                            match self.infer_expr_type(a.value, known) as at:
                                case LType:
                                    arg_types.append(at)
                                case none:
                                    pass
                        match find_signature(self.functions, callee.name, arg_types) as sig:
                            case FuncSig:
                                return sig.return_type
                            case none:
                                return none
                    case _:
                        return none
            case _:
                return none

    # Mirrors checker.lucid's check_for_iterable_element_type -- the same
    # two iterable shapes this subset's `for` supports (a list literal, a
    # call to `range`), inferred rather than checked since a program that
    # reaches codegen has already passed the checker.
    def infer_for_iterable_element_type(self, iterable: Expr, known: dict[str, LType]) -> LType | none:
        match iterable as result:
            case ListExpr:
                if len(result.elements) == 0:
                    return none
                return self.infer_expr_type(result.elements[0], known)
            case Call:
                match result.func as callee:
                    case Ident:
                        if callee.name == "range":
                            return IntType()
                    case _:
                        pass
                return none
            case _:
                return none

    def dispatch_return_type(self, op: str, left: LType | none, right: LType | none) -> LType | none:
        match dispatch_op_name(op) as dunder:
            case str:
                match left as lt:
                    case LType:
                        match right as rt:
                            case LType:
                                match find_signature(self.functions, dunder, [lt, rt]) as sig:
                                    case FuncSig:
                                        return sig.return_type
                                    case none:
                                        return none
                            case none:
                                return none
                    case none:
                        return none
            case none:
                return none

    def codegen_expr(self, e: Expr, known: dict[str, LType]) -> str:
        match e as result:
            case LiteralExpr:
                match result.value as lit:
                    case IntLit:
                        return str(lit.value)
                    case BoolLit:
                        if lit.value:
                            return "1"
                        return "0"
                    case StrLit:
                        return c_string_literal(lit.value)
                    case _:
                        return "0 /* unsupported literal */"
            case Ident:
                return result.name
            case Binary:
                left_type = self.infer_expr_type(result.left, known)
                right_type = self.infer_expr_type(result.right, known)
                left_code = self.codegen_expr(result.left, known)
                right_code = self.codegen_expr(result.right, known)
                is_dispatch = false
                match left_type as lt:
                    case ClassType:
                        is_dispatch = true
                    case _:
                        pass
                match right_type as rt:
                    case ClassType:
                        is_dispatch = true
                    case _:
                        pass
                if is_dispatch:
                    match dispatch_op_name(result.op) as dunder:
                        case str:
                            match left_type as lt:
                                case LType:
                                    match right_type as rt:
                                        case LType:
                                            match find_signature(self.functions, dunder, [lt, rt]) as sig:
                                                case FuncSig:
                                                    name = mangled_name(self.functions, sig)
                                                    return name + "(" + left_code + ", " + right_code + ")"
                                                case none:
                                                    pass
                                        case none:
                                            pass
                                case none:
                                    pass
                        case none:
                            pass
                    return "0 /* unresolved dispatch operator */"
                is_str_operands = false
                match left_type as lt:
                    case StrType:
                        match right_type as rt:
                            case StrType:
                                is_str_operands = true
                            case _:
                                pass
                    case _:
                        pass
                if is_str_operands:
                    cmp = "strcmp(" + left_code + ", " + right_code + ")"
                    if result.op == "EQ":
                        return "(" + cmp + " == 0)"
                    if result.op == "NOT_EQ":
                        return "(" + cmp + " != 0)"
                    if result.op == "LT":
                        return "(" + cmp + " < 0)"
                    if result.op == "LT_EQ":
                        return "(" + cmp + " <= 0)"
                    if result.op == "GT":
                        return "(" + cmp + " > 0)"
                    if result.op == "GT_EQ":
                        return "(" + cmp + " >= 0)"
                    if result.op == "ADD":
                        return "lucid_rt_str_concat(" + left_code + ", " + right_code + ")"
                if result.op == "FLOOR_DIV":
                    return "lucid_rt_floordiv(" + left_code + ", " + right_code + ")"
                if result.op == "MOD":
                    return "lucid_rt_mod(" + left_code + ", " + right_code + ")"
                return "(" + left_code + " " + c_binary_op(result.op) + " " + right_code + ")"
            case Unary:
                inner = self.codegen_expr(result.expr, known)
                if result.op == "NEG":
                    return "(-" + inner + ")"
                if result.op == "NOT":
                    return "(!" + inner + ")"
                return inner
            case Construct:
                match self.classes.get(result.class_name, none) as cls:
                    case ClassSig:
                        args: list[str] = []
                        for a in result.args:
                            args.append(self.codegen_expr(a.value, known))
                        return "((" + result.class_name + "){" + join_with(args, ", ") + "})"
                    case none:
                        return "0 /* unknown class */"
            case Attribute:
                receiver = self.codegen_expr(result.value, known)
                return receiver + "." + result.attr
            case Call:
                match result.func as callee:
                    case Ident:
                        arg_codes: list[str] = []
                        arg_types: list[LType] = []
                        for a in result.args:
                            arg_codes.append(self.codegen_expr(a.value, known))
                            match self.infer_expr_type(a.value, known) as at:
                                case LType:
                                    arg_types.append(at)
                                case none:
                                    pass
                        if callee.name == "print":
                            return self.codegen_print(result.args, known)
                        if callee.name == "len" and len(arg_codes) == 1:
                            return "((long) strlen(" + arg_codes[0] + "))"
                        joined = join_with(arg_codes, ", ")
                        match find_signature(self.functions, callee.name, arg_types) as sig:
                            case FuncSig:
                                name = mangled_name(self.functions, sig)
                                return name + "(" + joined + ")"
                            case none:
                                return callee.name + "(" + joined + ")"
                    case _:
                        return "0 /* unsupported call target */"
            case _:
                return "0 /* unsupported expression */"

    def codegen_print(self, args: list[Arg], known: dict[str, LType]) -> str:
        has_class_arg = false
        for a in args:
            match self.infer_expr_type(a.value, known) as at:
                case ClassType:
                    has_class_arg = true
                case _:
                    pass
        if has_class_arg:
            return self.codegen_print_with_class_args(args, known)
        format_parts: list[str] = []
        value_codes: list[str] = []
        i = 0
        while i < len(args):
            if i > 0:
                format_parts.append(" ")
            arg_type = self.infer_expr_type(args[i].value, known)
            arg_code = self.codegen_expr(args[i].value, known)
            match arg_type as at:
                case StrType:
                    format_parts.append("%s")
                case BoolType:
                    format_parts.append("%s")
                    arg_code = "(" + arg_code + " ? \"true\" : \"false\")"
                case _:
                    format_parts.append("%ld")
            value_codes.append(arg_code)
            i = i + 1
        format_str = c_string_literal(join_with(format_parts, "") + "\n")
        pieces: list[str] = [format_str]
        for v in value_codes:
            pieces.append(v)
        return "printf(" + join_with(pieces, ", ") + ")"

    # `print`'s call site is an expression (codegen_expr's Call arm), so
    # this always has to return one C expression, never a statement
    # sequence -- a C comma expression, evaluating each argument's own
    # `printf(...)` (or, for a class-typed argument, its
    # `lucid_print_<ClassName>` call, always `void`, fine as a non-final
    # comma operand) left to right, with its own inline `printf(" ")`
    # between arguments and a final `printf("\n")`.
    def codegen_print_with_class_args(self, args: list[Arg], known: dict[str, LType]) -> str:
        terms: list[str] = []
        i = 0
        while i < len(args):
            if i > 0:
                terms.append("printf(\" \")")
            arg_type = self.infer_expr_type(args[i].value, known)
            arg_code = self.codegen_expr(args[i].value, known)
            match arg_type as at:
                case ClassType:
                    terms.append("lucid_print_" + at.name + "(" + arg_code + ")")
                case StrType:
                    terms.append("printf(\"%s\", " + arg_code + ")")
                case BoolType:
                    terms.append("printf(\"%s\", (" + arg_code + " ? \"true\" : \"false\"))")
                case _:
                    terms.append("printf(\"%ld\", " + arg_code + ")")
            i = i + 1
        terms.append("printf(\"\\n\")")
        return "(" + join_with(terms, ", ") + ")"

    def ident_pattern_name(self, p: Pattern) -> str:
        match p as result:
            case IdentPattern:
                return result.name
            case _:
                return "_unsupported_pattern"

    def ident_target_name(self, e: Expr) -> str:
        match e as result:
            case Ident:
                return result.name
            case _:
                return "_unsupported_target"

    # `broken_flag` names the C variable that an enclosing loop's
    # `if_broken` clause (if any) checks after the loop exits --
    # `codegen_stmt`'s Break case sets it before emitting `break;`. It
    # names the *innermost* enclosing loop's flag (or none, if that loop
    # has no `if_broken` clause): entering a nested loop's own body
    # always rebinds it to that loop's own flag (or none), per
    # docs/for-and-while.md's "an if_broken clause belongs to the loop
    # immediately before it".
    def codegen_block(self, stmts: list[Stmt], indent: str, known: dict[str, LType], broken_flag: str | none) -> str:
        lines: list[str] = []
        for s in stmts:
            lines.append(self.codegen_stmt(s, indent, known, broken_flag))
        return join_with(lines, "\n")

    def codegen_stmt(self, s: Stmt, indent: str, known: dict[str, LType], broken_flag: str | none) -> str:
        match s as result:
            case VarDef:
                value_code = "0"
                inferred: LType | none = resolve_type_expr(result.type_annotation)
                match result.value as v:
                    case Expr:
                        value_code = self.codegen_expr(v, known)
                        if inferred == none:
                            inferred = self.infer_expr_type(v, known)
                    case none:
                        pass
                name = self.ident_pattern_name(result.pattern)
                match inferred as it:
                    case LType:
                        known[name] = it
                    case none:
                        pass
                return indent + name + " = " + value_code + ";"
            case Assignment:
                value_code = self.codegen_expr(result.value, known)
                name = self.ident_target_name(result.target)
                match self.infer_expr_type(result.value, known) as it:
                    case LType:
                        known[name] = it
                    case none:
                        pass
                return indent + name + " = " + value_code + ";"
            case If:
                cond = self.codegen_expr(result.condition, known)
                then_code = self.codegen_block(result.then_branch, indent + "    ", known, broken_flag)
                text = indent + "if (" + cond + ") {\n" + then_code + "\n" + indent + "}"
                for branch in result.elif_branches:
                    elif_cond = self.codegen_expr(branch.condition, known)
                    elif_code = self.codegen_block(branch.body, indent + "    ", known, broken_flag)
                    text = text + " else if (" + elif_cond + ") {\n" + elif_code + "\n" + indent + "}"
                match result.else_branch as else_body:
                    case list[Stmt]:
                        else_code = self.codegen_block(else_body, indent + "    ", known, broken_flag)
                        text = text + " else {\n" + else_code + "\n" + indent + "}"
                    case none:
                        pass
                return text
            case While:
                cond = self.codegen_expr(result.condition, known)
                match result.if_broken_body as broken_body:
                    case list[Stmt]:
                        loop_flag = "__lucid_broke_" + str(result.span.line) + "_" + str(result.span.column)
                        body = self.codegen_block(result.body, indent + "        ", known, loop_flag)
                        broken_code = self.codegen_block(broken_body, indent + "        ", known, broken_flag)
                        return indent + "{\n" + indent + "    int " + loop_flag + " = 0;\n" + indent + "    while (" + cond + ") {\n" + body + "\n" + indent + "    }\n" + indent + "    if (" + loop_flag + ") {\n" + broken_code + "\n" + indent + "    }\n" + indent + "}"
                    case none:
                        body = self.codegen_block(result.body, indent + "    ", known, none)
                        return indent + "while (" + cond + ") {\n" + body + "\n" + indent + "}"
            case For:
                return self.codegen_for(result, indent, known, broken_flag)
            case Return:
                match result.value as v:
                    case Expr:
                        return indent + "return " + self.codegen_expr(v, known) + ";"
                    case none:
                        return indent + "return;"
            case Break:
                match broken_flag as flag:
                    case str:
                        return indent + flag + " = 1;\n" + indent + "break;"
                    case none:
                        return indent + "break;"
            case Continue:
                return indent + "continue;"
            case Pass:
                return indent + ";"
            case ExprStmt:
                return indent + self.codegen_expr(result.expr, known) + ";"
            case MetadataStmt:
                return ""
            case _:
                return indent + "/* unsupported statement */"

    # This subset's `for` only supports two iterable shapes -- a list
    # literal, compiled to a small fixed-size C array plus an index loop,
    # and a call to `range`, compiled straight to a C counting loop reusing
    # the loop target itself as the counter (already declared `long` at
    # the top of the enclosing function, since IntType is what
    # infer_for_iterable_element_type always gives `range`'s element type)
    # -- see infer_for_iterable_element_type / check_for_iterable_element_type.
    # `if_broken` reuses the same flag-variable trick as While's.
    def codegen_for(self, node: For, indent: str, known: dict[str, LType], broken_flag: str | none) -> str:
        target_name = self.ident_pattern_name(node.target)
        has_if_broken = false
        loop_flag = ""
        match node.if_broken_body as broken_body:
            case list[Stmt]:
                has_if_broken = true
                loop_flag = "__lucid_broke_" + str(node.span.line) + "_" + str(node.span.column)
            case none:
                pass
        inner_flag: str | none = none
        if has_if_broken:
            inner_flag = loop_flag
        body_indent = indent + "    "
        header_indent = indent
        if has_if_broken:
            body_indent = indent + "        "
            header_indent = indent + "    "
        body = self.codegen_block(node.body, body_indent, known, inner_flag)

        loop_text = header_indent + "/* unsupported for-loop iterable */"
        match node.iterable as it:
            case ListExpr:
                elem_type = self.infer_for_iterable_element_type(node.iterable, known)
                ctype = "long"
                match elem_type as et:
                    case LType:
                        ctype = c_type_of(et)
                    case none:
                        pass
                elements: list[str] = []
                for e in it.elements:
                    elements.append(self.codegen_expr(e, known))
                arr_name = "__lucid_for_arr_" + str(node.span.line) + "_" + str(node.span.column)
                idx_name = "__lucid_for_i_" + str(node.span.line) + "_" + str(node.span.column)
                arr_decl = header_indent + ctype + " " + arr_name + "[] = {" + join_with(elements, ", ") + "};"
                loop_open = header_indent + "for (long " + idx_name + " = 0; " + idx_name + " < " + str(len(elements)) + "; " + idx_name + "++) {"
                assign = body_indent + target_name + " = " + arr_name + "[" + idx_name + "];"
                loop_text = arr_decl + "\n" + loop_open + "\n" + assign + "\n" + body + "\n" + header_indent + "}"
            case Call:
                match it.func as callee:
                    case Ident:
                        if callee.name == "range":
                            start_code = "0"
                            stop_code = "0"
                            if len(it.args) == 1:
                                stop_code = self.codegen_expr(it.args[0].value, known)
                            if len(it.args) == 2:
                                start_code = self.codegen_expr(it.args[0].value, known)
                                stop_code = self.codegen_expr(it.args[1].value, known)
                            # Hoist both bounds into their own C locals,
                            # evaluated once, and drive the loop with a
                            # hidden counter rather than `target_name`
                            # itself -- Lucid evaluates range(...)'s
                            # arguments once and re-binds the loop target
                            # fresh each iteration, so a body that
                            # reassigns the target (or a bound expression
                            # with side effects) must not change how many
                            # iterations run.
                            suffix = str(node.span.line) + "_" + str(node.span.column)
                            start_var = "__lucid_for_start_" + suffix
                            stop_var = "__lucid_for_stop_" + suffix
                            idx_name = "__lucid_for_i_" + suffix
                            decls = header_indent + "long " + start_var + " = " + start_code + ";\n" + header_indent + "long " + stop_var + " = " + stop_code + ";"
                            loop_open = header_indent + "for (long " + idx_name + " = " + start_var + "; " + idx_name + " < " + stop_var + "; " + idx_name + "++) {"
                            assign = body_indent + target_name + " = " + idx_name + ";"
                            loop_text = decls + "\n" + loop_open + "\n" + assign + "\n" + body + "\n" + header_indent + "}"
                    case _:
                        pass
            case _:
                pass

        if has_if_broken:
            match node.if_broken_body as broken_body:
                case list[Stmt]:
                    broken_code = self.codegen_block(broken_body, indent + "    ", known, broken_flag)
                    return indent + "{\n" + indent + "    int " + loop_flag + " = 0;\n" + loop_text + "\n" + indent + "    if (" + loop_flag + ") {\n" + broken_code + "\n" + indent + "    }\n" + indent + "}"
                case none:
                    pass
        return loop_text

    def c_param_list(self, params: list[Param]) -> str:
        names: list[str] = []
        for p in params:
            match resolve_type_expr(p.type_annotation) as pt:
                case LType:
                    names.append(c_type_of(pt) + " " + p.name)
                case none:
                    names.append("long " + p.name)
        joined = join_with(names, ", ")
        if joined == "":
            return "void"
        return joined

    def collect_local_names(self, stmts: list[Stmt], names: set[str]):
        # Every local Lucid name stays visible for the rest of its
        # enclosing function, not just the block it's first assigned in
        # (see the header comment) -- so every VarDef/Assignment target
        # anywhere in the body, including nested if/while blocks, becomes
        # one C declaration hoisted to the top of the generated C
        # function, and codegen_stmt itself never declares one.
        for s in stmts:
            match s as result:
                case VarDef:
                    names.add(self.ident_pattern_name(result.pattern))
                case Assignment:
                    names.add(self.ident_target_name(result.target))
                case If:
                    self.collect_local_names(result.then_branch, names)
                    for branch in result.elif_branches:
                        self.collect_local_names(branch.body, names)
                    match result.else_branch as else_body:
                        case list[Stmt]:
                            self.collect_local_names(else_body, names)
                        case none:
                            pass
                case While:
                    self.collect_local_names(result.body, names)
                    match result.if_broken_body as broken_body:
                        case list[Stmt]:
                            self.collect_local_names(broken_body, names)
                        case none:
                            pass
                case For:
                    names.add(self.ident_pattern_name(result.target))
                    self.collect_local_names(result.body, names)
                    match result.if_broken_body as broken_body:
                        case list[Stmt]:
                            self.collect_local_names(broken_body, names)
                        case none:
                            pass
                case _:
                    pass

    def infer_local_types(self, stmts: list[Stmt], known: dict[str, LType]):
        # A first pass purely to learn each local's type before emitting
        # any code, since a name used before its own VarDef/Assignment
        # appears later in the same function (legal in Lucid -- see the
        # header comment) would otherwise codegen with an unknown type.
        # Mirrors codegen_stmt/codegen_expr's own type propagation without
        # emitting anything.
        for s in stmts:
            match s as result:
                case VarDef:
                    inferred: LType | none = resolve_type_expr(result.type_annotation)
                    if inferred == none:
                        match result.value as v:
                            case Expr:
                                inferred = self.infer_expr_type(v, known)
                            case none:
                                pass
                    match inferred as it:
                        case LType:
                            known[self.ident_pattern_name(result.pattern)] = it
                        case none:
                            pass
                case Assignment:
                    match self.infer_expr_type(result.value, known) as it:
                        case LType:
                            known[self.ident_target_name(result.target)] = it
                        case none:
                            pass
                case If:
                    self.infer_local_types(result.then_branch, known)
                    for branch in result.elif_branches:
                        self.infer_local_types(branch.body, known)
                    match result.else_branch as else_body:
                        case list[Stmt]:
                            self.infer_local_types(else_body, known)
                        case none:
                            pass
                case While:
                    self.infer_local_types(result.body, known)
                    match result.if_broken_body as broken_body:
                        case list[Stmt]:
                            self.infer_local_types(broken_body, known)
                        case none:
                            pass
                case For:
                    match self.infer_for_iterable_element_type(result.iterable, known) as et:
                        case LType:
                            known[self.ident_pattern_name(result.target)] = et
                        case none:
                            pass
                    self.infer_local_types(result.body, known)
                    match result.if_broken_body as broken_body:
                        case list[Stmt]:
                            self.infer_local_types(broken_body, known)
                        case none:
                            pass
                case _:
                    pass

    # Shared by codegen_function and codegen_entry_point: two passes --
    # first learn every local's type (needed since a local can be used,
    # in a later statement, before codegen has otherwise seen its own
    # declaration's type -- e.g. a call whose argument type determines
    # dispatch resolution, referencing a variable assigned earlier in
    # the same straight-line body but after codegen_block would have
    # inferred it lazily), then emit, with every local (besides a
    # parameter) declared once, hoisted to the top.
    def codegen_body(self, params: list[Param], body: list[Stmt], known: dict[str, LType]) -> str:
        self.infer_local_types(body, known)
        local_names: set[str] = {}
        self.collect_local_names(body, local_names)
        param_names: set[str] = {}
        for p in params:
            param_names.add(p.name)
        declarations: list[str] = []
        for name in local_names:
            if name not in param_names:
                match known.get(name, none) as t:
                    case LType:
                        declarations.append("    " + c_type_of(t) + " " + name + ";")
                    case none:
                        declarations.append("    long " + name + ";")
        body_code = self.codegen_block(body, "    ", known, none)
        return join_with(declarations, "\n") + "\n" + body_code

    def codegen_function(self, fn: FunctionDef, sig: FuncSig) -> str:
        param_list = self.c_param_list(fn.params)
        known: dict[str, LType] = {:}
        i = 0
        while i < len(fn.params) and i < len(sig.param_types):
            known[fn.params[i].name] = sig.param_types[i]
            i = i + 1
        full_body = self.codegen_body(fn.params, fn.body, known)
        c_name = mangled_name(self.functions, sig)
        return c_type_of(sig.return_type) + " " + c_name + "(" + param_list + ") {\n" + full_body + "\n}"

    # The module's top-level statements -- the only thing `lucid run`
    # actually executes directly, and the only thing that becomes C's
    # own `int main(void)` (see codegen_module's header comment).
    def codegen_entry_point(self, top_level: list[Stmt]) -> str:
        known: dict[str, LType] = {:}
        full_body = self.codegen_body([], top_level, known)
        return "int main(void) {\n" + full_body + "\n}"

    def codegen_forward_decl(self, fn: FunctionDef, sig: FuncSig) -> str:
        return c_type_of(sig.return_type) + " " + mangled_name(self.functions, sig) + "(" + self.c_param_list(fn.params) + ");"

    def signature_for(self, fn: FunctionDef) -> FuncSig | none:
        param_types: list[LType] = []
        for p in fn.params:
            match resolve_type_expr(p.type_annotation) as pt:
                case LType:
                    param_types.append(pt)
                case none:
                    return none
        return_type: LType = IntType()
        match resolve_type_expr(fn.return_type) as rt:
            case LType:
                return_type = rt
            case none:
                pass
        return find_signature(self.functions, fn.name, param_types)

    def codegen_module(self, stmts: list[Stmt]) -> str:
        self.collect_declarations(stmts)
        top_level: list[Stmt] = []
        for stmt in stmts:
            match stmt as result:
                case ClassDef:
                    pass
                case FunctionStmt:
                    pass
                case _:
                    top_level.append(stmt)
        parts: list[str] = [runtime_prelude, ""]
        for stmt in stmts:
            match stmt as result:
                case ClassDef:
                    match self.classes.get(result.name, none) as cls:
                        case ClassSig:
                            parts.append(emit_struct(cls))
                            parts.append("")
                            if is_printable_class(cls):
                                parts.append(emit_print_function(cls))
                                parts.append("")
                        case none:
                            pass
                case _:
                    pass
        # Every Lucid function is an ordinary, mangled C function here --
        # including one literally named `main`, which `lucid run` never
        # auto-invokes and which the reference native backend
        # (compiler/crates/lucid-codegen) always mangles too (`lucid_fn_
        # main`, never bare `main`). C's own `main` is a separate,
        # unconditionally synthesized entry point below, built from the
        # module's top-level statements -- the only thing `lucid run`
        # actually executes on its own, and the only thing that becomes
        # C's `int main(void)`. An earlier draft special-cased a Lucid
        # function named `main` into being that entry point directly,
        # which matched neither the interpreter's nor the reference
        # compiler's actual behavior -- a real semantic divergence, not
        # just an unsupported feature.
        for stmt in stmts:
            match stmt as result:
                case FunctionStmt:
                    match self.signature_for(result.function) as sig:
                        case FuncSig:
                            parts.append(self.codegen_forward_decl(result.function, sig))
                        case none:
                            pass
                case _:
                    pass
        parts.append("")
        for stmt in stmts:
            match stmt as result:
                case FunctionStmt:
                    match self.signature_for(result.function) as sig:
                        case FuncSig:
                            parts.append(self.codegen_function(result.function, sig))
                            parts.append("")
                        case none:
                            pass
                case _:
                    pass
        if len(top_level) > 0:
            parts.append(self.codegen_entry_point(top_level))
            parts.append("")
        return join_with(parts, "\n")


def new_codegen() -> Codegen:
    return Codegen(new_func_table(), {:})

def codegen_module(stmts: list[Stmt]) -> str:
    cg = new_codegen()
    return cg.codegen_module(stmts)
