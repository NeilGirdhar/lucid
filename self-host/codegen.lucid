# A C code generator for self-host/ast.lucid, written in Lucid: the code
# generation phase self-host/checker.lucid's own subset is scoped for,
# mirroring compiler/crates/lucid-codegen (which also emits C and shells
# out to a system C compiler -- Lucid has no subprocess/exec builtin by
# design, so *invoking* that compiler is necessarily a driver step
# outside Lucid, the same way it is a driver step outside the
# Rust-implemented codegen's own Lucid-facing surface; see
# compile_demo.lucid for the driver that writes this module's C output to
# a file and actually compiles and runs it). self-host/types.lucid holds
# the shared type representation and class/function tables both this
# file and self-host/checker.lucid build from the same AST -- codegen
# assumes its input already passed checker.lucid (it doesn't re-report
# errors; an unsupported construct becomes a C comment, not a rejection).
#
# Deliberately a small subset, not feature parity with lucid-codegen (a
# ~16,000-line crate with dynamic LucidVal boxing, generic numeric
# promotion, exception unwinding, and far more): `int`/`bool` are a C
# `long`, `str` a `const char*`, a class a heap-allocated, pointer-typed
# C struct (`ClassName *`, matching lucid-runtime's own reference
# semantics -- see c_type_of's own comment), `list[T]`/`dict[str, V]`
# the same way, and a union return type a small by-value tagged struct
# (see emit_union_type); arithmetic/comparison/logical operators on
# int/bool map straight to their C equivalents (`//`/`%` through two
# `static` helpers -- Lucid's are Euclidean, unlike C's truncating or
# Python's floored division: the remainder is always in [0, |b|)
# regardless of either operand's sign); a binary operator on two
# class-typed operands, or a call to a name with more than one
# `dispatch def`, resolves to one specific C function chosen by the
# static argument types, name-mangled by them (`__add___Vector2D_
# Vector2D`) since C has no overloading of its own; a Lucid function
# literally named `main` becomes C's own `int main(void)`; a method
# compiles to an ordinary C function taking `ClassName *self` explicitly
# (see method_c_name); `match` on a union subject compiles to an
# if/else-if chain on its own `.tag` field, never a C `switch` (see
# codegen_match); `?` desugars to a temp, a tag check with an early
# return, and an unwrap assignment, only as a plain assignment's own
# right-hand side (see codegen_propagate_assignment); `print(...)` takes
# any number of int/bool/str/class arguments, each formatted by its own
# inferred type. Left for later: inheritance, generics, collections
# beyond list[T]/dict[str, V], closures, exceptions, comprehensions --
# everything else checker.lucid's header comment's Rust counterpart
# covers, since codegen never accepts more than checker.lucid does.
# Also assumes (not yet enforced by checker.lucid) that every local
# variable is declared once, at the top level of its function body, not
# inside a nested if/while -- C's block scoping would otherwise make a
# variable declared inside one branch invisible after it, unlike Lucid's
# own more permissive same-function visibility.

from .ast import Expr, LiteralExpr, Ident, Binary, Unary, Call, Construct, Attribute, Index, ListExpr, DictExpr, SetExpr, Arg, IntLit, BoolLit, StrLit, NoneLit, FloatLit, Propagate, Stmt, ClassDef, ClassMember, FieldMember, MethodMember, FunctionStmt, VarDef, Assignment, If, For, While, Return, Break, Continue, Pass, ExprStmt, MetadataStmt, MatchStmt, MatchArm, Pattern, IdentPattern, TypePattern, WildcardPattern, LiteralPattern, FunctionDef, Param, FromImport, Hoisted, hoist_propagate
from .types import LType, IntType, BoolType, StrType, FloatType, ClassType, ListType, DictType, SetType, NoneType, UnionLType, type_name, mangle_component, types_equal, assignable_to, sorted_union_members, resolve_type_expr, FieldSig, ClassSig, field_type, method_signature, is_printable_class, FuncSig, FuncTable, new_func_table, register_signature, find_signature, find_signature_assignable, resolve_all_declarations, inherited_fields, class_assignable_to, is_subclass_of, class_tag, union_has_none_member, union_member_type_equal

runtime_prelude = "#include <stdio.h>\n#include <string.h>\n#include <stdlib.h>\n\n// Lucid's // and % are Euclidean: the remainder is always in [0, |b|),\n// unlike C's truncating / and % (whose remainder can be negative) and\n// unlike Python's floored // and % (whose remainder takes the sign of\n// the divisor, which can also be negative). Division by zero is\n// undefined behavior here, same as plain C -- this subset doesn't\n// generate the checked-division error path lucid-codegen's own runtime\n// ABI does.\nstatic long lucid_rt_mod(long a, long b) {\n    long r = a % b;\n    if (r < 0) {\n        r += (b < 0) ? -b : b;\n    }\n    return r;\n}\n\nstatic long lucid_rt_floordiv(long a, long b) {\n    long q = a / b;\n    long r = a % b;\n    if (r < 0) {\n        q += (b < 0) ? 1 : -1;\n    }\n    return q;\n}\n\n// str + str is this subset's first heap allocation -- freed nowhere\n// (see self-host/README.md's no-GC/no-arena note: every compiled\n// program runs once and exits).\nstatic const char *lucid_rt_str_concat(const char *a, const char *b) {\n    char *result = malloc(strlen(a) + strlen(b) + 1);\n    strcpy(result, a);\n    strcat(result, b);\n    return result;\n}\n\n// s[i] on a str yields a one-character str, matching Lucid's own\n// indexing (not a numeric byte/char code); a negative index counts\n// from the end (s[-1] is the last character), matching the reference\n// interpreter. lucid_rt_chars is a static table of the 256 possible\n// one-character strings, each already NUL-terminated by C's own\n// zero-initialization of static storage -- a fixed-size lookup, not an\n// allocation, unlike lucid_rt_str_concat above.\nstatic char lucid_rt_chars[256][2];\n\nstatic const char *lucid_rt_str_index(const char *s, long i) {\n    long n = (long) strlen(s);\n    long idx = i;\n    if (idx < 0) {\n        idx += n;\n    }\n    if (idx < 0 || idx >= n) {\n        fprintf(stderr, \"Runtime Error: index %ld out of range\\n\", i);\n        exit(1);\n    }\n    unsigned char c = (unsigned char) s[idx];\n    lucid_rt_chars[c][0] = (char) c;\n    return lucid_rt_chars[c];\n}\n\n// str(n)/str(f) -- self-host/checker.lucid's/self-host/codegen.lucid's\n// own dominant `str()` use (`str(expr.span.line)`, `str(err_index)`,\n// `str(lit.value)` for a FloatLit's own float field), the other\n// direction from int(...)/float(...). \"%g\" for a float matches the\n// reference interpreter's own str(3.0) == \"3\" (no trailing \".0\") --\n// the same format print() already uses for a float value.\nstatic const char *lucid_rt_str_of_int(long n) {\n    char *result = malloc(32);\n    snprintf(result, 32, \"%ld\", n);\n    return result;\n}\n\nstatic const char *lucid_rt_str_of_float(double f) {\n    char *result = malloc(32);\n    snprintf(result, 32, \"%g\", f);\n    return result;\n}\n\n// s.endswith(suffix) -- checker.lucid's/codegen.lucid's own dominant\n// `?`-error-recognition heuristic (`mt.name.endswith(\"Error\")`).\nstatic long lucid_rt_str_endswith(const char *s, const char *suffix) {\n    long ls = (long) strlen(s);\n    long lsuf = (long) strlen(suffix);\n    if (lsuf > ls) {\n        return 0;\n    }\n    return strcmp(s + (ls - lsuf), suffix) == 0;\n}"

# `sorted(names)` -- types.lucid's/checker.lucid's own dominant use
# (`sorted_member_names`, `class_tag`), sorting a *fresh copy* of a
# `list[str]` ascending (verified directly against the reference
# interpreter: the original list is untouched). Needs `lucid_list_str`
# to already exist, so unlike every other runtime helper this can't live
# in runtime_prelude itself (emitted before any list[T] type at all) --
# codegen_module appends this right after `emit_list_type(StrType())`
# instead. qsort's own comparator takes `const void *`, matching a
# `lucid_list_str`'s own `items` array element (`const char **`) once
# cast.
sorted_str_prelude = "static int lucid_rt_strcmp_qsort(const void *a, const void *b) {\n    const char *sa = *(const char **) a;\n    const char *sb = *(const char **) b;\n    return strcmp(sa, sb);\n}\n\nstatic lucid_list_str *lucid_rt_sorted_str(lucid_list_str *lst) {\n    lucid_list_str *copy = lucid_list_str_of(lst->len, lst->items);\n    qsort(copy->items, copy->len, sizeof(const char *), lucid_rt_strcmp_qsort);\n    return copy;\n}"

# Every class gets a `typedef struct Name Name;` forward declaration,
# emitted for every class before any class's full struct body -- a
# named (not anonymous) struct tag is what lets one class's field hold
# a pointer to another class declared earlier OR later in the same
# module (codegen_module emits every forward decl first, in one pass,
# specifically so field/struct declaration order never matters here).
def emit_struct_forward_decl(cls: ClassSig) -> str:
    return "typedef struct " + cls.name + " " + cls.name + ";"

# A hidden `long __lucid_tag;` field, inserted right after the fields a
# `sealed_root` class's OWN body declares (`Expr`'s own is just `span`,
# so every `Expr` descendant gets `[span, __lucid_tag, <its own
# fields>]`) -- the same relative position in every descendant's own
# struct, via `inherited_fields` prepending the root's own fields first,
# so it's always readable through a pointer of the sealed root's own
# type (`Expr *`), whatever concrete subclass the pointer actually
# points to, under C11 6.5.2.3p6's "common initial sequence" rule (the
# same reasoning `.span` access through an `Expr *` already relies on).
# `codegen_match`'s own sealed-hierarchy dispatch reads it this way to
# tell which concrete subclass a sealed-base-typed value actually is --
# the one thing plain inheritance (a value only ever flowing *up* the
# hierarchy) can't do on its own. `boundary` is how many of `cls.fields`
# belong to the root itself; a plain (non-sealed-hierarchy) class's own
# `cls.sealed_root` is `none`, so neither of these two functions ever
# has to insert or set one for it.
def sealed_root_boundary(classes: dict[str, ClassSig], cls: ClassSig) -> int:
    match cls.sealed_root as root:
        case str:
            match classes.get(root, none) as root_cls:
                case ClassSig:
                    return len(root_cls.fields)
                case none:
                    return 0
        case none:
            return 0

def emit_struct(classes: dict[str, ClassSig], cls: ClassSig) -> str:
    fields: list[str] = []
    boundary = sealed_root_boundary(classes, cls)
    if boundary == 0 and cls.sealed_root != none:
        fields.append("    long __lucid_tag;")
    i = 0
    while i < len(cls.fields):
        f = cls.fields[i]
        fields.append("    " + c_type_of(f.field_type) + " " + f.name + ";")
        if i + 1 == boundary:
            fields.append("    long __lucid_tag;")
        i = i + 1
    return "struct " + cls.name + " {\n" + join_with(fields, "\n") + "\n};"

# `Construct` (`ClassName(args)`) compiles to a call to this --
# `malloc`, one field assignment per constructor argument (never for
# `__lucid_tag`, which isn't a real Construct argument at all -- it's
# set to this class's own `class_tag` unconditionally, right in the
# constructor body, the same way it's never counted by
# checker.lucid's own check_construct), return the pointer. Leaked,
# like every other allocation in this subset (see self-host/README.md's
# no-GC/no-arena note).
def emit_constructor(classes: dict[str, ClassSig], cls: ClassSig) -> str:
    params: list[str] = []
    assigns: list[str] = []
    boundary = sealed_root_boundary(classes, cls)
    if boundary == 0 and cls.sealed_root != none:
        assigns.append("    p->__lucid_tag = " + str(class_tag(classes, cls.name)) + ";")
    i = 0
    while i < len(cls.fields):
        f = cls.fields[i]
        params.append(c_type_of(f.field_type) + " " + f.name)
        assigns.append("    p->" + f.name + " = " + f.name + ";")
        if i + 1 == boundary:
            assigns.append("    p->__lucid_tag = " + str(class_tag(classes, cls.name)) + ";")
        i = i + 1
    param_list = join_with(params, ", ")
    if param_list == "":
        param_list = "void"
    return "static " + cls.name + " *lucid_new_" + cls.name + "(" + param_list + ") {\n    " + cls.name + " *p = malloc(sizeof(" + cls.name + "));\n" + join_with(assigns, "\n") + "\n    return p;\n}"

# `print()` of a class value emits `ClassName({"field": value, ...})`,
# matching lucid-runtime's own default repr -- fields sorted by name
# (not declaration order): lucid-runtime's Value::Object stores fields
# in a HashMap, whose iteration order this subset's printer has to
# match, and HashMap order isn't declaration order (or even stable
# across runs, before a lucid-runtime fix made it sort by name too). A
# `str` field's value is wrapped in literal `"..."` with no escaping,
# matching lucid-runtime's own (also unescaped) `Debug` for `Str`. Only
# called for a class where is_printable_class(cls) is true -- every
# field int/bool/str, no nested class field to print.
def emit_print_function(cls: ClassSig) -> str:
    names: list[str] = []
    for f in cls.fields:
        names.append(f.name)
    format_parts: list[str] = []
    arg_exprs: list[str] = []
    for name in sorted(names):
        match field_type(cls, name) as ft:
            case StrType:
                format_parts.append("\\\"" + name + "\\\": \\\"%s\\\"")
                arg_exprs.append("value->" + name)
            case BoolType:
                format_parts.append("\\\"" + name + "\\\": %s")
                arg_exprs.append("(value->" + name + " ? \"true\" : \"false\")")
            case FloatType:
                format_parts.append("\\\"" + name + "\\\": %g")
                arg_exprs.append("value->" + name)
            case _:
                format_parts.append("\\\"" + name + "\\\": %ld")
                arg_exprs.append("value->" + name)
    format_str = "\"" + cls.name + "({" + join_with(format_parts, ", ") + "})\""
    pieces: list[str] = [format_str]
    for a in arg_exprs:
        pieces.append(a)
    printf_call = "printf(" + join_with(pieces, ", ") + ");"
    return "static void lucid_print_" + cls.name + "(" + cls.name + " *value) {\n    " + printf_call + "\n}"

# A Lucid local/parameter/match-alias name that happens to collide with
# a C reserved word (`default`, `int`, `float`, ...) would otherwise
# emit straight through as invalid C -- self-host/parser.lucid's own
# `default: Expr | none = none` (a field's default-value expression,
# named the same as its own concept) is a real, previously-undiscovered
# case of exactly this, caught by compiling it. None of Lucid's own
# keywords need escaping here (they can't appear as an identifier in
# valid Lucid source at all), only the C keywords Lucid happens not to
# reserve itself. Applied once, at every point a Lucid-sourced name
# becomes a local/parameter C identifier (never a class, function, or
# field name -- those are already prefixed or mangled elsewhere, so
# immune to this by construction) -- both the declaration site and
# every read go through this, so they always agree on the same escaped
# spelling.
def c_safe_ident(name: str) -> str:
    if name == "auto" or name == "break" or name == "case" or name == "char" or name == "const" or name == "continue" or name == "default" or name == "do" or name == "double" or name == "else" or name == "enum" or name == "extern" or name == "float" or name == "for" or name == "goto" or name == "if" or name == "inline" or name == "int" or name == "long" or name == "register" or name == "restrict" or name == "return" or name == "short" or name == "signed" or name == "sizeof" or name == "static" or name == "struct" or name == "switch" or name == "typedef" or name == "union" or name == "unsigned" or name == "void" or name == "volatile" or name == "while":
        return name + "_"
    return name

def join_with(parts: list[str], sep: str) -> str:
    text = ""
    i = 0
    while i < len(parts):
        if i > 0:
            text = text + sep
        text = text + parts[i]
        i = i + 1
    return text

# A monomorphized C list type for one element LType -- `lucid_list_int`,
# `lucid_list_str`, `lucid_list_Circle`, and so on, named by
# mangle_component(element_type). Heap-allocated and accessed only
# through a pointer (never by value): Value::List in lucid-runtime is
# Rc<RefCell<Vec<Value>>>, reference semantics (an alias of a list
# mutates every alias -- verified directly: `b = a; b.append(3)`
# changes `len(a)` too), unlike every plain-struct class this codegen
# otherwise emits. `int`/`bool`/`str` versions are emitted
# unconditionally, in the prelude, regardless of whether a compiled
# program actually uses `list[int]` -- cheap, and skips having to walk
# a program collecting which element types are actually instantiated
# (which could miss one); a `list[SomeClass]` version is emitted right
# after `SomeClass`'s own struct, in codegen_module.
def emit_list_type(element_type: LType) -> str:
    ctype = c_type_of(element_type)
    name = "lucid_list_" + mangle_component(element_type)
    parts: list[str] = []
    parts.append("typedef struct {\n    " + ctype + " *items;\n    long len;\n    long cap;\n} " + name + ";")
    parts.append("static " + name + " *" + name + "_new(void) {\n    " + name + " *lst = malloc(sizeof(" + name + "));\n    lst->items = NULL;\n    lst->len = 0;\n    lst->cap = 0;\n    return lst;\n}")
    parts.append("static void " + name + "_append(" + name + " *lst, " + ctype + " value) {\n    if (lst->len >= lst->cap) {\n        lst->cap = (lst->cap == 0) ? 4 : lst->cap * 2;\n        lst->items = realloc(lst->items, sizeof(" + ctype + ") * lst->cap);\n    }\n    lst->items[lst->len] = value;\n    lst->len = lst->len + 1;\n}")
    parts.append("static " + ctype + " " + name + "_get(" + name + " *lst, long i) {\n    long idx = i;\n    if (idx < 0) {\n        idx += lst->len;\n    }\n    if (idx < 0 || idx >= lst->len) {\n        fprintf(stderr, \"Runtime Error: index %ld out of range\\n\", i);\n        exit(1);\n    }\n    return lst->items[idx];\n}")
    parts.append("static " + name + " *" + name + "_of(long n, " + ctype + " *src) {\n    " + name + " *lst = " + name + "_new();\n    long i = 0;\n    while (i < n) {\n        " + name + "_append(lst, src[i]);\n        i = i + 1;\n    }\n    return lst;\n}")
    parts.append("static " + ctype + " " + name + "_pop(" + name + " *lst) {\n    if (lst->len == 0) {\n        fprintf(stderr, \"Runtime Error: pop from an empty list\\n\");\n        exit(1);\n    }\n    lst->len = lst->len - 1;\n    return lst->items[lst->len];\n}")
    return join_with(parts, "\n\n")

# A `dict[str, V]` is a heap-allocated, pointer-typed C struct, the same
# representation choice as `list[T]` and for the same reason (reference
# semantics -- see ListType's header comment in types.lucid; Value::Dict
# in lucid-runtime is Rc<RefCell<HashMap<String, Value>>>). Keys are
# always `const char *`, never mangled into the C type name the way an
# element/value type is (`lucid_dict_str_int`, not
# `lucid_dict_str_str_int`) -- this subset's `DictType` only ever has a
# `str` key (see types.lucid's own note on why). `_get`/`_set` are both a
# linear `strcmp` scan, not a hash table -- fine for the small, mostly
# compile-time-constant tables this subset actually compiles
# (self-host/lexer.lucid's own `keywords`/`single`), not a general-
# purpose dict implementation.
#
# `_new`/`_set` (mirroring `lucid_list_T`'s own `_new`/`_append`, a
# `cap`-tracked, `realloc`-doubled growable buffer) exist for
# `checker.lucid`'s/`types.lucid`'s own dominant mutation shape --
# `known[name] = t`, `self.classes[cd.name] = ClassSig(...)` -- a real
# dict[str, T] item write, not just the bulk `_of` construction a dict
# *literal* compiles to (see codegen_stmt's own Assignment arm, `case
# Index:`). `_set` overwrites an existing key's value in place if found,
# otherwise appends a new key/value pair, growing exactly like
# `lucid_list_T_append` does. `_of` itself is now built the same way
# `lucid_list_T_of` already is -- through `_new`+`_set` in a loop, not
# by aliasing the caller's own (typically stack- or static-allocated)
# arrays directly, since those could never be safely `realloc`'d by a
# later `_set` call if this dict is mutated afterward.
def emit_dict_type(value_type: LType) -> str:
    ctype = c_type_of(value_type)
    name = "lucid_dict_str_" + mangle_component(value_type)
    parts: list[str] = []
    parts.append("typedef struct {\n    const char **keys;\n    " + ctype + " *values;\n    long len;\n    long cap;\n} " + name + ";")
    parts.append("static " + name + " *" + name + "_new(void) {\n    " + name + " *d = malloc(sizeof(" + name + "));\n    d->keys = NULL;\n    d->values = NULL;\n    d->len = 0;\n    d->cap = 0;\n    return d;\n}")
    parts.append("static void " + name + "_set(" + name + " *d, const char *key, " + ctype + " value) {\n    long i = 0;\n    while (i < d->len) {\n        if (strcmp(d->keys[i], key) == 0) {\n            d->values[i] = value;\n            return;\n        }\n        i = i + 1;\n    }\n    if (d->len >= d->cap) {\n        d->cap = (d->cap == 0) ? 4 : d->cap * 2;\n        d->keys = realloc(d->keys, sizeof(const char *) * d->cap);\n        d->values = realloc(d->values, sizeof(" + ctype + ") * d->cap);\n    }\n    d->keys[d->len] = key;\n    d->values[d->len] = value;\n    d->len = d->len + 1;\n}")
    parts.append("static " + name + " *" + name + "_of(long n, const char **keys, " + ctype + " *values) {\n    " + name + " *d = " + name + "_new();\n    long i = 0;\n    while (i < n) {\n        " + name + "_set(d, keys[i], values[i]);\n        i = i + 1;\n    }\n    return d;\n}")
    parts.append("static " + ctype + " " + name + "_get(" + name + " *d, const char *key, " + ctype + " default_value) {\n    long i = 0;\n    while (i < d->len) {\n        if (strcmp(d->keys[i], key) == 0) {\n            return d->values[i];\n        }\n        i = i + 1;\n    }\n    return default_value;\n}")
    parts.append("static " + ctype + " " + name + "_index(" + name + " *d, const char *key) {\n    long i = 0;\n    while (i < d->len) {\n        if (strcmp(d->keys[i], key) == 0) {\n            return d->values[i];\n        }\n        i = i + 1;\n    }\n    fprintf(stderr, \"Runtime Error: key %s not found\\n\", key);\n    exit(1);\n}")
    return join_with(parts, "\n\n")

# `set[str]` -- codegen.lucid's own dominant use (`names: set[str] = {}`,
# tracking already-hoisted local names; `seen: set[str]`, types.lucid's
# own resolve_all_declarations, tracking already-inlined files), a
# growable array with a linear `strcmp` membership scan, the same
# discipline (and the same reason -- small, mostly compile-time-constant
# sets) `lucid_dict_str_V`'s own `_get`/`_set` already use. `_add` is a
# no-op if the element is already present, matching how a real Lucid
# `set` never duplicates.
def emit_set_type(element_type: LType) -> str:
    ctype = c_type_of(element_type)
    name = "lucid_set_" + mangle_component(element_type)
    parts: list[str] = []
    parts.append("typedef struct {\n    " + ctype + " *items;\n    long len;\n    long cap;\n} " + name + ";")
    parts.append("static " + name + " *" + name + "_new(void) {\n    " + name + " *s = malloc(sizeof(" + name + "));\n    s->items = NULL;\n    s->len = 0;\n    s->cap = 0;\n    return s;\n}")
    parts.append("static long " + name + "_contains(" + name + " *s, " + ctype + " value) {\n    long i = 0;\n    while (i < s->len) {\n        if (strcmp(s->items[i], value) == 0) {\n            return 1;\n        }\n        i = i + 1;\n    }\n    return 0;\n}")
    parts.append("static void " + name + "_add(" + name + " *s, " + ctype + " value) {\n    if (" + name + "_contains(s, value)) {\n        return;\n    }\n    if (s->len >= s->cap) {\n        s->cap = (s->cap == 0) ? 4 : s->cap * 2;\n        s->items = realloc(s->items, sizeof(" + ctype + ") * s->cap);\n    }\n    s->items[s->len] = value;\n    s->len = s->len + 1;\n}")
    return join_with(parts, "\n\n")

# The C name for a union return type -- `mangle_component(UnionLType(...))`
# already returns "union_LexError_Token" (members canonically sorted, see
# types.lucid's sorted_member_names); this just adds the same `lucid_`
# prefix every other generated type name gets. Shared by c_type_of and
# emit_union_type so the two can never name the same union differently.
def union_c_name(members: list[LType]) -> str:
    return "lucid_" + mangle_component(UnionLType(members))

# A subtype value (`Binary`) flowing into a sealed-base-typed slot
# (`Expr`) -- a Construct argument, a plain function call argument, a
# method call argument, a `list[T].append(...)` argument, a `return`
# value, or an assignment -- needs an explicit C cast: `Binary *` and
# `Expr *` are two separate, unrelated struct types in this codegen (no
# C-level inheritance at all), safe under C11 6.5.2.3p6's "common
# initial sequence" rule for any access to a field the base class itself
# declares (see emit_struct's own comment). `expected`/`actual` are
# whatever checker.lucid already confirmed is a valid (sub)class
# relationship; this only ever needs to *emit* the cast, never validate
# one. A no-op (returns `code` unchanged) whenever `expected` isn't
# itself a class type, or `actual` already names the same class.
def cast_if_needed(expected: LType, actual: LType, code: str) -> str:
    match expected as et:
        case ClassType:
            match actual as at:
                case ClassType:
                    if at.name != et.name:
                        return "(" + c_type_of(et) + ") " + code
                case _:
                    pass
        case _:
            pass
    return code

# Like cast_if_needed, but also covers a plain (concrete) value flowing
# into a *union*-typed slot -- `forward(x: Item | none)` called as
# `forward(Item(5))` or `forward(none)` (self-host/checker.lucid's own
# `expected_return: LType | none` parameter, once a parameter was
# allowed to be a union at all: see method_signature_for/
# collect_function_signature). Mirrors the wrap codegen_expr's own
# Construct case already gives a union-typed *field* constructed from a
# member value -- find the matching member, cast if it's a narrower
# subtype of that member, then wrap into the union's own tag/field
# layout. A no-op when `actual` is already the exact same union (the
# common "just forward this parameter along" case throughout
# checker.lucid/codegen.lucid's own mutually recursive methods).
def cast_or_wrap(classes: dict[str, ClassSig], expected: LType, actual: LType, code: str) -> str:
    match expected as et:
        case UnionLType:
            if types_equal(expected, actual):
                return code
            match find_union_member(classes, et.members, actual) as target:
                case LType:
                    wrap_code = cast_if_needed(target, actual, code)
                    return wrap_union_value(et.members, target, wrap_code)
                case none:
                    return code
        case _:
            return cast_if_needed(expected, actual, code)

# A union type -- `Token | LexError`, `Token | none`, `list[Token] |
# LexError` -- is a plain, by-value (not heap-allocated) tagged C
# struct: an int `tag` plus one field per non-`none` member, named
# positionally (`v0`, `v1`, ...) by that member's own index in
# sorted_union_members(members), the same index `tag` holds when that
# member is the active one. `none` gets a tag value but no field -- it
# carries no data to store, the same reason NoneType itself has no C
# representation as a value. By value, not by pointer: unlike a class or
# list[T]/dict[str, V] (which need reference semantics because a Lucid
# program can alias and mutate them), a union value only ever exists
# transiently, between a call that produces it and the '?'/match
# statement that narrows it immediately -- nothing in this subset ever
# aliases one, so a small by-value struct (an int plus, at most, one
# pointer or long) is both correct and cheap to copy.
def emit_union_type(members: list[LType]) -> str:
    ordered = sorted_union_members(members)
    name = union_c_name(members)
    fields: list[str] = ["    long tag;"]
    i = 0
    while i < len(ordered):
        match ordered[i] as m:
            case NoneType:
                pass
            case _:
                fields.append("    " + c_type_of(m) + " v" + str(i) + ";")
        i = i + 1
    return "typedef struct {\n" + join_with(fields, "\n") + "\n} " + name + ";"

# Which of `members` a value of type `vt` actually belongs in --
# `vt` itself if it's an exact member (the common case), or, for a
# class-typed `vt` that's a *subtype* of one, that member instead
# (`return LiteralExpr(...)` from a `-> Expr | ParserError` method:
# `vt` is `LiteralExpr`, but the member to wrap into, and to tag-check
# against later, is `Expr`). `none` only if checker.lucid's own
# class_assignable_to somehow accepted something this scan can't find a
# home for, which shouldn't happen for a program that passed checking.
def find_union_member(classes: dict[str, ClassSig], members: list[LType], vt: LType) -> LType | none:
    for m in members:
        if types_equal(m, vt):
            return m
    match vt as vtt:
        case ClassType:
            for m in members:
                match m as mt:
                    case ClassType:
                        if is_subclass_of(classes, vtt.name, mt.name):
                            return m
                    case _:
                        pass
        case _:
            pass
    return none

# The tag value (an index into sorted_union_members(members)) a value of
# type `m` gets when wrapped into a union of `members`. Only ever called
# with an `m` checker.lucid has already confirmed is one of `members'`
# own members (assignable_to), so the scan always finds one.
def union_member_index(members: list[LType], m: LType) -> int:
    ordered = sorted_union_members(members)
    i = 0
    while i < len(ordered):
        if types_equal(ordered[i], m):
            return i
        i = i + 1
    return 0

# `sibling.sealed_root == root` -- `union_code` (a union value known to
# have `member_t` as one of its own members) compared for equality
# against `plain_code` (a plain value of exactly `member_t`): true only
# when `union_code`'s own tag matches `member_t`'s position *and* the
# two values' content agrees (`strcmp` for str, `==` directly for
# int/bool -- the only member types this ever needs, matching
# check_binary's own restriction). `negate` builds the `!=` form
# instead -- `!(...)` around the whole conjunction, not a per-piece
# negation, since De Morgan's version would need the tag check negated
# too, which is wrong (the tag mismatching alone already makes `!=`
# true, without needing to compare content at all).
def union_member_eq(u: UnionLType, member_t: LType, union_code: str, plain_code: str, negate: bool) -> str:
    idx = union_member_index(u.members, member_t)
    tag_eq = union_code + ".tag == " + str(idx)
    field_code = union_code + ".v" + str(idx)
    content_eq = "0"
    match member_t as mt:
        case StrType:
            content_eq = "strcmp(" + field_code + ", " + plain_code + ") == 0"
        case _:
            content_eq = "(" + field_code + " == " + plain_code + ")"
    combined = "(" + tag_eq + " && " + content_eq + ")"
    if negate:
        return "(!" + combined + ")"
    return combined

# Wraps `value_code` (a value of type `m`, already codegen'd) into a
# union-of-`members` compound literal -- `(lucid_union_LexError_Token)
# {.tag = 1, .v1 = value_code}`. `m` being NoneType (the `return none`
# case) omits the field entirely, matching emit_union_type's own field
# skip for a `none` member.
def wrap_union_value(members: list[LType], m: LType, value_code: str) -> str:
    i = union_member_index(members, m)
    name = union_c_name(members)
    match m as mt:
        case NoneType:
            return "(" + name + "){.tag = " + str(i) + "}"
        case _:
            return "(" + name + "){.tag = " + str(i) + ", .v" + str(i) + " = " + value_code + "}"

# Used by Codegen.collect_union_types to dedup: is `t` (order-
# insensitively) equal to one already found?
def union_already_found(found: list[UnionLType], t: UnionLType) -> bool:
    for f in found:
        if types_equal(f, t):
            return true
    return false

def sort_union_types(types: list[UnionLType]) -> list[UnionLType]:
    names: list[str] = []
    for t in types:
        names.append(mangle_component(t))
    ordered_names = sorted(names)
    result: list[UnionLType] = []
    for n in ordered_names:
        for t in types:
            if mangle_component(t) == n:
                result.append(t)
    return result

def dispatch_op_name(op: str) -> str | none:
    if op == "ADD":
        return "__add__"
    if op == "SUB":
        return "__sub__"
    if op == "MUL":
        return "__mul__"
    if op == "FLOOR_DIV":
        return "__floordiv__"
    if op == "MOD":
        return "__mod__"
    return none

def c_binary_op(op: str) -> str:
    if op == "ADD":
        return "+"
    if op == "SUB":
        return "-"
    if op == "MUL":
        return "*"
    if op == "LT":
        return "<"
    if op == "LT_EQ":
        return "<="
    if op == "GT":
        return ">"
    if op == "GT_EQ":
        return ">="
    if op == "EQ":
        return "=="
    if op == "NOT_EQ":
        return "!="
    if op == "AND":
        return "&&"
    if op == "OR":
        return "||"
    return "/* unsupported operator " + op + " */"

def c_type_of(t: LType) -> str:
    match t as result:
        case IntType:
            return "long"
        case BoolType:
            return "long"
        case StrType:
            return "const char *"
        case FloatType:
            return "double"
        case ClassType:
            # A pointer, not a by-value struct: lucid-runtime's
            # Value::Object is Rc<RefCell<HashMap>> -- reference
            # semantics, an alias mutates the same fields every other
            # alias sees -- so a class here has to be heap-allocated
            # and passed by pointer, the same representation list[T]
            # already uses and for the same reason (see
            # emit_constructor's header comment).
            return result.name + " *"
        case ListType:
            return "lucid_list_" + mangle_component(result.element_type) + " *"
        case DictType:
            return "lucid_dict_str_" + mangle_component(result.value_type) + " *"
        case SetType:
            return "lucid_set_" + mangle_component(result.element_type) + " *"
        case UnionLType:
            # By value, not by pointer -- see emit_union_type's own
            # header comment for why.
            return union_c_name(result.members)
        case NoneType:
            return "void"
        case _:
            return "long"

def c_string_literal(s: str) -> str:
    escaped = s.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n").replace("\t", "\\t").replace("\r", "\\r")
    return "\"" + escaped + "\""

# The C name for a specific resolved overload of a Lucid function/
# dispatch name -- C has no overloading, so every signature beyond the
# first `dispatch def` for a name needs its own C identifier, mangled by
# its parameter types.
def mangled_name(table: FuncTable, sig: FuncSig) -> str:
    # C reserves every identifier that starts with two underscores, or
    # with one underscore followed by an uppercase letter (C11 7.1.3) --
    # `sig.name` is an arbitrary Lucid identifier, and Lucid's own dunder
    # convention for dispatch operators (`__add__`, `__mul__`, ...)
    # collides with exactly that reserved space. Every name this function
    # returns is prefixed with `lucid_`, unconditionally, even when a
    # dispatch name has only one registered signature and doesn't
    # strictly need mangling to stay unique -- a name that happens not to
    # collide with another Lucid overload today isn't the same guarantee
    # as never colliding with a reserved C identifier.
    match table.signatures.get(sig.name, none) as sigs:
        case list[FuncSig]:
            if len(sigs) <= 1:
                return "lucid_" + sig.name
        case none:
            pass
    parts: list[str] = ["lucid", sig.name]
    for pt in sig.param_types:
        parts.append(type_name(pt))
    return join_with(parts, "__")

# A method's C name, kept out of `mangled_name`/FuncTable entirely --
# there's no overloading to disambiguate (one FuncSig per method name,
# per class, in this subset), and building the name straight from
# `class_name`/`method_name` can never collide with a mangled free
# function's name (those are always `lucid_`-prefixed with no class
# name in the middle) or with another class's same-named method.
def method_c_name(class_name: str, method_name: str) -> str:
    return "lucid_method_" + class_name + "_" + method_name

class Codegen:
    functions: FuncTable
    classes: dict[str, ClassSig]
    # A module-level variable, compiled as a real C global (`static
    # <ctype> <name>;`), initialized by the first statements
    # codegen_entry_point's `main()` runs, and readable from every
    # function/method body afterward -- matching checker.lucid's own
    # module_scope (see its header comment there for why: `x: int = 5`
    # at module level, then `def f() -> int: return x + 1`, is real,
    # verified Lucid, not something checker.lucid rejects). Populated
    # once, in codegen_module, before any class/function/method is
    # emitted; every function/method's own `known` is seeded with a
    # COPY of this (see copy_type_scope) so its own locals never leak
    # back into it. `codegen_entry_point`'s own generated `main()` is
    # the one place that must NOT redeclare these names as its own
    # C locals (they're already declared at file scope) -- see its
    # `exclude` parameter to codegen_body.
    module_scope: dict[str, LType]

    def collect_declarations(self, stmts: list[Stmt]):
        for stmt in stmts:
            match stmt as result:
                case ClassDef:
                    own_fields: list[FieldSig] = []
                    methods: dict[str, FuncSig] = {:}
                    # Mirrors checker.lucid's own collect_class /
                    # resolve_parent -- codegen assumes checker already
                    # rejected more than one base, so it's enough to
                    # look at the first.
                    parent: str | none = none
                    if len(result.bases) > 0:
                        match resolve_type_expr(result.bases[0]) as bt:
                            case ClassType:
                                parent = bt.name
                            case _:
                                pass
                    for member in result.body:
                        match member as m:
                            case FieldMember:
                                match resolve_type_expr(m.field.type_annotation) as ft:
                                    case LType:
                                        own_fields.append(FieldSig(m.field.name, ft))
                                    case none:
                                        pass
                            case MethodMember:
                                mparam_types: list[LType] = []
                                mi = 1
                                while mi < len(m.method.params):
                                    match resolve_type_expr(m.method.params[mi].type_annotation) as mpt:
                                        case LType:
                                            mparam_types.append(mpt)
                                        case none:
                                            pass
                                    mi = mi + 1
                                mreturn_type: LType = NoneType()
                                if m.method.return_type != none:
                                    match resolve_type_expr(m.method.return_type) as mrt:
                                        case LType:
                                            mreturn_type = mrt
                                        case none:
                                            pass
                                methods[m.method.name] = FuncSig(m.method.name, mparam_types, mreturn_type)
                            case _:
                                pass
                    sealed_root: str | none = none
                    if result.is_sealed:
                        sealed_root = result.name
                    else:
                        match parent as p:
                            case str:
                                match self.classes.get(p, none) as parent_cls:
                                    case ClassSig:
                                        sealed_root = parent_cls.sealed_root
                                    case none:
                                        pass
                            case none:
                                pass
                    self.classes[result.name] = ClassSig(result.name, inherited_fields(self.classes, parent, own_fields), methods, parent, sealed_root)
                case FunctionStmt:
                    fn = result.function
                    param_types: list[LType] = []
                    for p in fn.params:
                        match resolve_type_expr(p.type_annotation) as pt:
                            case LType:
                                param_types.append(pt)
                            case none:
                                pass
                    # An omitted return-type annotation means `-> none`
                    # (see checker.lucid's collect_function_signature
                    # for why) -- codegen.lucid keeps its own copy of
                    # this table rather than reusing checker.lucid's,
                    # so it needs the same default.
                    return_type: LType = NoneType()
                    if fn.return_type != none:
                        match resolve_type_expr(fn.return_type) as rt:
                            case LType:
                                return_type = rt
                            case none:
                                pass
                    register_signature(self.functions, FuncSig(fn.name, param_types, return_type))
                case _:
                    pass

    def infer_expr_type(self, expr: Expr, known: dict[str, LType]) -> LType | none:
        match expr as result:
            case LiteralExpr:
                match result.value as lit:
                    case IntLit:
                        return IntType()
                    case BoolLit:
                        return BoolType()
                    case StrLit:
                        return StrType()
                    case FloatLit:
                        return FloatType()
                    case NoneLit:
                        # Only ever meaningful wrapped into a union
                        # return type (see codegen_stmt's Return arm) --
                        # matching checker.lucid's own check_expr, which
                        # is what lets `return none` from a `-> Token |
                        # none` method reach codegen at all.
                        return NoneType()
                    case _:
                        return none
            case Ident:
                return known.get(c_safe_ident(result.name), none)
            case Propagate:
                return self.infer_propagate_ok_type(result, known)
            case Binary:
                left_type = self.infer_expr_type(result.left, known)
                right_type = self.infer_expr_type(result.right, known)
                match left_type as lt:
                    case ClassType:
                        return self.dispatch_return_type(result.op, lt, right_type)
                    case _:
                        pass
                match right_type as rt:
                    case ClassType:
                        return self.dispatch_return_type(result.op, left_type, rt)
                    case _:
                        pass
                if result.op == "AND" or result.op == "OR" or result.op == "EQ" or result.op == "NOT_EQ" or result.op == "LT" or result.op == "LT_EQ" or result.op == "GT" or result.op == "GT_EQ" or result.op == "IN" or result.op == "NOT_IN":
                    return BoolType()
                if result.op == "ADD":
                    match left_type as lt:
                        case StrType:
                            match right_type as rt:
                                case StrType:
                                    return StrType()
                                case _:
                                    pass
                        case _:
                            pass
                return IntType()
            case Unary:
                return self.infer_expr_type(result.expr, known)
            case Construct:
                return ClassType(result.class_name)
            case Attribute:
                receiver_type = self.infer_expr_type(result.value, known)
                match receiver_type as rt:
                    case ClassType:
                        match self.classes.get(rt.name, none) as cls:
                            case ClassSig:
                                return field_type(cls, result.attr)
                            case none:
                                return none
                    case _:
                        return none
            case Index:
                match self.infer_expr_type(result.value, known) as rt:
                    case StrType:
                        return StrType()
                    case ListType:
                        return rt.element_type
                    case DictType:
                        return rt.value_type
                    case _:
                        return none
            case ListExpr:
                # This must be the list literal's OWN type -- ListType
                # wrapping the element type -- not the bare element type
                # (a real, previously-undiscovered miscompile: `xs = [1,
                # 2, 3]` with no declared annotation hoisted `xs` as
                # `long` instead of `lucid_list_int *`, and
                # `xs.append(4)` compiled to a bare "unsupported method
                # call" comment, since `known["xs"]` ended up `IntType()`
                # instead of `ListType(IntType())`). No test program
                # before this one used a non-empty list literal as a
                # VarDef's value with no explicit `list[T]` annotation --
                # every one either declared the type explicitly or only
                # used a non-empty literal inside `for`, which has its
                # own separate, already-correct
                # infer_for_iterable_element_type.
                if len(result.elements) == 0:
                    return none
                match self.infer_expr_type(result.elements[0], known) as et:
                    case LType:
                        return ListType(et)
                    case none:
                        return none
            case DictExpr:
                if len(result.entries) == 0:
                    return none
                match self.infer_expr_type(result.entries[0].value, known) as vt:
                    case LType:
                        return DictType(vt)
                    case none:
                        return none
            case SetExpr:
                if len(result.elements) == 0:
                    return none
                match self.infer_expr_type(result.elements[0], known) as set_et2:
                    case LType:
                        return SetType(set_et2)
                    case none:
                        return none
            case Call:
                match result.func as callee:
                    case Ident:
                        if callee.name == "len":
                            return IntType()
                        if callee.name == "int":
                            return IntType()
                        if callee.name == "float":
                            return FloatType()
                        if callee.name == "str":
                            return StrType()
                        if callee.name == "sorted" and len(result.args) == 1:
                            match self.infer_expr_type(result.args[0].value, known) as sorted_at:
                                case ListType:
                                    return sorted_at
                                case _:
                                    pass
                            return none
                        # Mirrors codegen_expr's own Call-Ident case (and
                        # checker.lucid's check_call): peek at the
                        # callee's first registered signature so an
                        # empty list/dict/set literal argument
                        # (`resolve_all_declarations(stmts, {})`) infers
                        # from the matching parameter's own declared
                        # type -- without this, `infer_expr_type` on the
                        # empty literal returns `none`, silently
                        # *dropping* that argument from `arg_types`
                        # (case none: pass) rather than just mistyping
                        # it, so `find_signature_assignable` sees the
                        # wrong arity entirely and the whole call's own
                        # return type comes back `none`.
                        infer_param_types: list[LType] = []
                        match self.functions.signatures.get(callee.name, none) as infer_sigs:
                            case list[FuncSig]:
                                if len(infer_sigs) > 0:
                                    infer_param_types = infer_sigs[0].param_types
                            case none:
                                pass
                        arg_types: list[LType] = []
                        ii = 0
                        for a in result.args:
                            expected_ipt: LType | none = none
                            if ii < len(infer_param_types):
                                expected_ipt = infer_param_types[ii]
                            inferred_at: LType | none = none
                            match a.value as iav:
                                case ListExpr:
                                    if len(iav.elements) == 0:
                                        match expected_ipt as iept:
                                            case ListType:
                                                inferred_at = iept
                                            case _:
                                                inferred_at = self.infer_expr_type(iav, known)
                                    else:
                                        inferred_at = self.infer_expr_type(iav, known)
                                case DictExpr:
                                    if len(iav.entries) == 0:
                                        match expected_ipt as iept2:
                                            case DictType:
                                                inferred_at = iept2
                                            case _:
                                                inferred_at = self.infer_expr_type(iav, known)
                                    else:
                                        inferred_at = self.infer_expr_type(iav, known)
                                case SetExpr:
                                    if len(iav.elements) == 0:
                                        match expected_ipt as iept3:
                                            case SetType:
                                                inferred_at = iept3
                                            case _:
                                                inferred_at = self.infer_expr_type(iav, known)
                                    else:
                                        inferred_at = self.infer_expr_type(iav, known)
                                case _:
                                    inferred_at = self.infer_expr_type(iav, known)
                            match inferred_at as at:
                                case LType:
                                    arg_types.append(at)
                                case none:
                                    pass
                            ii = ii + 1
                        match find_signature_assignable(self.classes, self.functions, callee.name, arg_types) as sig:
                            case FuncSig:
                                return sig.return_type
                            case none:
                                return none
                    case Attribute:
                        match self.infer_expr_type(callee.value, known) as rt:
                            case ClassType:
                                match self.classes.get(rt.name, none) as cls:
                                    case ClassSig:
                                        match method_signature(cls, callee.attr) as sig:
                                            case FuncSig:
                                                return sig.return_type
                                            case none:
                                                return none
                                    case none:
                                        return none
                            case StrType:
                                if callee.attr == "endswith":
                                    return BoolType()
                                return none
                            case ListType:
                                if callee.attr == "pop":
                                    return rt.element_type
                                # list[T].append(...) is a statement in
                                # practice (its result is always
                                # discarded), but codegen_expr still
                                # needs SOME type for it -- none is
                                # fine, since nothing hoists a
                                # declaration from a call whose result
                                # isn't assigned.
                                return none
                            case DictType:
                                if callee.attr == "get" and len(result.args) == 2:
                                    # Mirrors checker.lucid's own
                                    # check_call DictType case: a bare
                                    # `none` default (`self.classes.get(
                                    # cd.name, none)`) means the result
                                    # is `V | none`, not just `V` --
                                    # codegen_expr's own `.get()` call
                                    # site has to agree, or a `match`/`!=
                                    # none` on the result narrows against
                                    # the wrong (non-union) type.
                                    match result.args[1].value as default_v:
                                        case LiteralExpr:
                                            match default_v.value as lit:
                                                case NoneLit:
                                                    opt_members: list[LType] = []
                                                    opt_members.append(rt.value_type)
                                                    opt_members.append(NoneType())
                                                    return UnionLType(opt_members)
                                                case _:
                                                    pass
                                        case _:
                                            pass
                                    return rt.value_type
                                return none
                            case _:
                                return none
                    case _:
                        return none
            case _:
                return none

    # Mirrors checker.lucid's check_propagate -- the single non-error
    # member's type, inferred (not checked, since a program that reaches
    # codegen has already passed the checker) purely so a `?`-RHS
    # Assignment's own target gets the right type hoisted by
    # infer_local_types before codegen_stmt ever emits the desugared
    # statement sequence (see codegen_propagate_assignment).
    def infer_propagate_ok_type(self, prop: Propagate, known: dict[str, LType]) -> LType | none:
        match self.infer_expr_type(prop.expr, known) as it:
            case UnionLType:
                ok_types: list[LType] = []
                for m in it.members:
                    match m as mt:
                        case ClassType:
                            if not mt.name.endswith("Error"):
                                ok_types.append(mt)
                        case _:
                            ok_types.append(mt)
                if len(ok_types) == 1:
                    return ok_types[0]
                return none
            case _:
                return none

    # Mirrors checker.lucid's check_for_iterable_element_type -- the same
    # two iterable shapes this subset's `for` supports (a list literal, a
    # call to `range`), inferred rather than checked since a program that
    # reaches codegen has already passed the checker.
    def infer_for_iterable_element_type(self, iterable: Expr, known: dict[str, LType]) -> LType | none:
        match iterable as result:
            case ListExpr:
                if len(result.elements) == 0:
                    return none
                return self.infer_expr_type(result.elements[0], known)
            case Call:
                match result.func as callee:
                    case Ident:
                        if callee.name == "range":
                            return IntType()
                    case _:
                        pass
                # Any other call (not `range`) whose own return type is a
                # list[T]/set[T]/dict[str, T] -- see codegen_for's own
                # matching fix for why this can't just error out here.
                match self.infer_expr_type(iterable, known) as cit2:
                    case ListType:
                        return cit2.element_type
                    case SetType:
                        return cit2.element_type
                    case DictType:
                        return StrType()
                    case _:
                        return none
            case _:
                match self.infer_expr_type(iterable, known) as it:
                    case ListType:
                        return it.element_type
                    case SetType:
                        return it.element_type
                    case DictType:
                        return StrType()
                    case _:
                        return none

    def dispatch_return_type(self, op: str, left: LType | none, right: LType | none) -> LType | none:
        match dispatch_op_name(op) as dunder:
            case str:
                match left as lt:
                    case LType:
                        match right as rt:
                            case LType:
                                match find_signature(self.functions, dunder, [lt, rt]) as sig:
                                    case FuncSig:
                                        return sig.return_type
                                    case none:
                                        return none
                            case none:
                                return none
                    case none:
                        return none
            case none:
                return none

    def codegen_expr(self, e: Expr, known: dict[str, LType]) -> str:
        match e as result:
            case LiteralExpr:
                match result.value as lit:
                    case IntLit:
                        return str(lit.value)
                    case BoolLit:
                        if lit.value:
                            return "1"
                        return "0"
                    case StrLit:
                        return c_string_literal(lit.value)
                    case FloatLit:
                        return str(lit.value)
                    case _:
                        return "0 /* unsupported literal */"
            case Ident:
                return c_safe_ident(result.name)
            case Binary:
                left_type = self.infer_expr_type(result.left, known)
                right_type = self.infer_expr_type(result.right, known)
                left_code = self.codegen_expr(result.left, known)
                right_code = self.codegen_expr(result.right, known)
                is_dispatch = false
                match left_type as lt:
                    case ClassType:
                        is_dispatch = true
                    case _:
                        pass
                match right_type as rt:
                    case ClassType:
                        is_dispatch = true
                    case _:
                        pass
                if is_dispatch:
                    match dispatch_op_name(result.op) as dunder:
                        case str:
                            match left_type as lt:
                                case LType:
                                    match right_type as rt:
                                        case LType:
                                            match find_signature(self.functions, dunder, [lt, rt]) as sig:
                                                case FuncSig:
                                                    name = mangled_name(self.functions, sig)
                                                    return name + "(" + left_code + ", " + right_code + ")"
                                                case none:
                                                    pass
                                        case none:
                                            pass
                                case none:
                                    pass
                        case none:
                            pass
                    return "0 /* unresolved dispatch operator */"
                is_str_operands = false
                match left_type as lt:
                    case StrType:
                        match right_type as rt:
                            case StrType:
                                is_str_operands = true
                            case _:
                                pass
                    case _:
                        pass
                if is_str_operands:
                    cmp = "strcmp(" + left_code + ", " + right_code + ")"
                    if result.op == "EQ":
                        return "(" + cmp + " == 0)"
                    if result.op == "NOT_EQ":
                        return "(" + cmp + " != 0)"
                    if result.op == "LT":
                        return "(" + cmp + " < 0)"
                    if result.op == "LT_EQ":
                        return "(" + cmp + " <= 0)"
                    if result.op == "GT":
                        return "(" + cmp + " > 0)"
                    if result.op == "GT_EQ":
                        return "(" + cmp + " >= 0)"
                    if result.op == "ADD":
                        return "lucid_rt_str_concat(" + left_code + ", " + right_code + ")"
                if result.op == "EQ" or result.op == "NOT_EQ":
                    # `self.classes.get(cd.name, none) != none` --
                    # checker.lucid's own check_binary now accepts this
                    # (a union with `none` as a member, compared against
                    # a bare `none` literal on the other side) -- neither
                    # operand's own C representation is a plain scalar
                    # here (the union side is a tagged struct, and C has
                    # no `!=`/`==` on structs at all), so this compiles
                    # to a tag check against whichever member index is
                    # `none`, never the generic fallback below.
                    cmp_op = "=="
                    if result.op == "NOT_EQ":
                        cmp_op = "!="
                    right_is_none = false
                    match right_type as rnt:
                        case NoneType:
                            right_is_none = true
                        case _:
                            pass
                    left_is_none = false
                    match left_type as lnt:
                        case NoneType:
                            left_is_none = true
                        case _:
                            pass
                    match left_type as ult:
                        case UnionLType:
                            if union_has_none_member(ult) and right_is_none:
                                return "(" + left_code + ".tag " + cmp_op + " " + str(union_member_index(ult.members, NoneType())) + ")"
                        case _:
                            pass
                    match right_type as urt:
                        case UnionLType:
                            if union_has_none_member(urt) and left_is_none:
                                return "(" + right_code + ".tag " + cmp_op + " " + str(union_member_index(urt.members, NoneType())) + ")"
                        case _:
                            pass
                    # `sibling.sealed_root == root` (`types.lucid`'s own
                    # class_tag) -- generalizes the `none` case just
                    # above: one side a union whose own member type
                    # matches the other side's exact type (int/bool/str
                    # only, same restriction the plain EQ/NOT_EQ rule
                    # above already has). Compiles to a tag check plus a
                    # content compare (`strcmp` for str, `==`/`!=`
                    # directly for int/bool) -- true only when the union
                    # side is actually that member *and* its value
                    # matches; false outright whenever the union side is
                    # its `none` member or any other member, with no
                    # content compare needed for that case at all.
                    match left_type as ult2:
                        case UnionLType:
                            match right_type as rt_concrete:
                                case LType:
                                    if union_member_type_equal(ult2, rt_concrete):
                                        return union_member_eq(ult2, rt_concrete, left_code, right_code, result.op == "NOT_EQ")
                                case none:
                                    pass
                        case _:
                            pass
                    match right_type as urt2:
                        case UnionLType:
                            match left_type as lt_concrete:
                                case LType:
                                    if union_member_type_equal(urt2, lt_concrete):
                                        return union_member_eq(urt2, lt_concrete, right_code, left_code, result.op == "NOT_EQ")
                                case none:
                                    pass
                        case _:
                            pass
                if result.op == "IN" or result.op == "NOT_IN":
                    # `path not in seen` (`types.lucid`'s own
                    # resolve_all_declarations) -- membership in a
                    # set[T], compiled to the matching
                    # `lucid_set_<T>_contains` call.
                    match right_type as rst:
                        case SetType:
                            set_name3 = "lucid_set_" + mangle_component(rst.element_type)
                            contains_expr = set_name3 + "_contains(" + right_code + ", " + left_code + ")"
                            if result.op == "NOT_IN":
                                return "(!" + contains_expr + ")"
                            return "(" + contains_expr + " != 0)"
                        case _:
                            pass
                if result.op == "FLOOR_DIV":
                    return "lucid_rt_floordiv(" + left_code + ", " + right_code + ")"
                if result.op == "MOD":
                    return "lucid_rt_mod(" + left_code + ", " + right_code + ")"
                return "(" + left_code + " " + c_binary_op(result.op) + " " + right_code + ")"
            case Unary:
                inner = self.codegen_expr(result.expr, known)
                if result.op == "NEG":
                    return "(-" + inner + ")"
                if result.op == "NOT":
                    return "(!" + inner + ")"
                return inner
            case Construct:
                match self.classes.get(result.class_name, none) as cls:
                    case ClassSig:
                        args: list[str] = []
                        i = 0
                        while i < len(result.args) and i < len(cls.fields):
                            av = result.args[i].value
                            field_type_i = cls.fields[i].field_type
                            arg_code = "0"
                            # Mirrors checker.lucid's own check_construct
                            # bidirectional handling: an empty list/dict
                            # literal argument (`Stack([], 0)`) needs the
                            # field's own declared type to know which
                            # `_new()`/`_of(0, ...)` to emit, the same
                            # reason codegen_stmt's VarDef arm special-
                            # cases an empty literal.
                            match av as avr:
                                case ListExpr:
                                    if len(avr.elements) == 0:
                                        match field_type_i as ft:
                                            case ListType:
                                                arg_code = "lucid_list_" + mangle_component(ft.element_type) + "_new()"
                                            case _:
                                                arg_code = self.codegen_expr(av, known)
                                    else:
                                        arg_code = self.codegen_expr(av, known)
                                case DictExpr:
                                    if len(avr.entries) == 0:
                                        match field_type_i as ft:
                                            case DictType:
                                                arg_code = "lucid_dict_str_" + mangle_component(ft.value_type) + "_of(0, (const char *[]){0}, (" + c_type_of(ft.value_type) + "[]){0})"
                                            case _:
                                                arg_code = self.codegen_expr(av, known)
                                    else:
                                        arg_code = self.codegen_expr(av, known)
                                case _:
                                    arg_code = self.codegen_expr(av, known)
                            # A field declared as a sealed base
                            # (`left: Expr`) constructed from a concrete
                            # subtype value (`Binary(span, some_literal_
                            # expr, "+", other)`) needs an explicit C
                            # cast: `LiteralExpr *` and `Expr *` are two
                            # separate, unrelated struct types in this
                            # codegen (see c_type_of's own ClassType
                            # case), not related by any C-level
                            # inheritance -- checker.lucid's
                            # class_assignable_to already confirmed this
                            # is a real subtype relationship (`Expr`'s
                            # own fields, here just `span`, are always
                            # the *first* fields of every subclass's own
                            # struct too, via inherited_fields, so this
                            # cast is safe under C11 6.5.2.3p6's "common
                            # initial sequence" rule for any access to a
                            # field `Expr` itself declares -- it is NOT
                            # safe to cast back down to a *different*
                            # concrete subtype without a real runtime
                            # tag, which this subset doesn't have; see
                            # self-host/README.md's Status section).
                            match field_type_i as ft2:
                                case ClassType:
                                    match self.infer_expr_type(av, known) as at2:
                                        case ClassType:
                                            if at2.name != ft2.name:
                                                arg_code = "(" + c_type_of(ft2) + ") " + arg_code
                                        case _:
                                            pass
                                case UnionLType:
                                    # A union-typed field (self-host/
                                    # ast.lucid's own `alias: str | none`
                                    # and its many siblings) constructed
                                    # from a member value (`ImportedName
                                    # (name, none)`, `alias` here a bare
                                    # `none` literal, not the whole
                                    # `str | none` union) needs the same
                                    # wrap codegen_stmt's Return/
                                    # Assignment arms already give a
                                    # narrower value assigned into an
                                    # established union.
                                    match self.infer_expr_type(av, known) as at3:
                                        case UnionLType:
                                            pass
                                        case LType:
                                            match find_union_member(self.classes, ft2.members, at3) as target4:
                                                case LType:
                                                    wrap_code4 = arg_code
                                                    match at3 as at3t:
                                                        case ClassType:
                                                            match target4 as tt4:
                                                                case ClassType:
                                                                    if at3t.name != tt4.name:
                                                                        wrap_code4 = "(" + c_type_of(tt4) + ") " + arg_code
                                                                case _:
                                                                    pass
                                                        case _:
                                                            pass
                                                    arg_code = wrap_union_value(ft2.members, target4, wrap_code4)
                                                case none:
                                                    pass
                                        case none:
                                            pass
                                case _:
                                    pass
                            args.append(arg_code)
                            i = i + 1
                        return "lucid_new_" + result.class_name + "(" + join_with(args, ", ") + ")"
                    case none:
                        return "0 /* unknown class */"
            case Attribute:
                receiver = self.codegen_expr(result.value, known)
                return receiver + "->" + result.attr
            case Index:
                receiver_code = self.codegen_expr(result.value, known)
                index_code = self.codegen_expr(result.index, known)
                match self.infer_expr_type(result.value, known) as rt:
                    case ListType:
                        name = "lucid_list_" + mangle_component(rt.element_type)
                        return name + "_get(" + receiver_code + ", " + index_code + ")"
                    case DictType:
                        # `copied[key] = scope[key]` -- a direct dict
                        # item read, distinct from `.get(key, default)`
                        # (see check_expr's own Index/DictType case).
                        dname = "lucid_dict_str_" + mangle_component(rt.value_type)
                        return dname + "_index(" + receiver_code + ", " + index_code + ")"
                    case _:
                        return "lucid_rt_str_index(" + receiver_code + ", " + index_code + ")"
            case ListExpr:
                match self.infer_expr_type(e, known) as lt:
                    case ListType:
                        et = lt.element_type
                        name = "lucid_list_" + mangle_component(et)
                        if len(result.elements) == 0:
                            return name + "_new()"
                        elems: list[str] = []
                        for e in result.elements:
                            elems.append(self.codegen_expr(e, known))
                        ctype = c_type_of(et)
                        return name + "_of(" + str(len(elems)) + ", (" + ctype + "[]){" + join_with(elems, ", ") + "})"
                    case _:
                        return "0 /* unsupported list literal */"
            case DictExpr:
                match self.infer_expr_type(e, known) as dt:
                    case DictType:
                        vt = dt.value_type
                        name = "lucid_dict_str_" + mangle_component(vt)
                        if len(result.entries) == 0:
                            return name + "_of(0, (const char *[]){0}, (" + c_type_of(vt) + "[]){0})"
                        key_codes: list[str] = []
                        value_codes: list[str] = []
                        for entry in result.entries:
                            key_codes.append(self.codegen_expr(entry.key, known))
                            value_codes.append(self.codegen_expr(entry.value, known))
                        vtype = c_type_of(vt)
                        return name + "_of(" + str(len(key_codes)) + ", (const char *[]){" + join_with(key_codes, ", ") + "}, (" + vtype + "[]){" + join_with(value_codes, ", ") + "})"
                    case _:
                        return "0 /* unsupported dict literal */"
            case SetExpr:
                # `names: set[str] = {}` -- codegen.lucid's own dominant
                # (and only, so far) set-literal shape is always empty,
                # populated afterward via `.add(...)`; a non-empty set
                # literal has no expression-level C equivalent without a
                # GNU statement expression, so it's honestly left
                # unsupported rather than half-built.
                match self.infer_expr_type(e, known) as st:
                    case SetType:
                        if len(result.elements) == 0:
                            return "lucid_set_" + mangle_component(st.element_type) + "_new()"
                        return "0 /* unsupported non-empty set literal */"
                    case _:
                        return "0 /* unsupported set literal */"
            case Call:
                match result.func as callee:
                    case Ident:
                        # Mirrors checker.lucid's own check_call: peek at
                        # the callee's first registered signature so an
                        # empty list/dict/set literal argument
                        # (`resolve_all_declarations(stmts, {})`) can
                        # codegen from the matching parameter's own
                        # declared type, the same bidirectional trick a
                        # VarDef/Construct argument already gets.
                        callee_param_types2: list[LType] = []
                        match self.functions.signatures.get(callee.name, none) as callee_sigs2:
                            case list[FuncSig]:
                                if len(callee_sigs2) > 0:
                                    callee_param_types2 = callee_sigs2[0].param_types
                            case none:
                                pass
                        arg_codes: list[str] = []
                        arg_types: list[LType] = []
                        ci = 0
                        for a in result.args:
                            expected_pt: LType | none = none
                            if ci < len(callee_param_types2):
                                expected_pt = callee_param_types2[ci]
                            arg_code3 = "0"
                            arg_type3: LType | none = none
                            match a.value as av3:
                                case ListExpr:
                                    if len(av3.elements) == 0:
                                        match expected_pt as ept4:
                                            case ListType:
                                                arg_code3 = "lucid_list_" + mangle_component(ept4.element_type) + "_new()"
                                                arg_type3 = ept4
                                            case _:
                                                arg_code3 = self.codegen_expr(av3, known)
                                                arg_type3 = self.infer_expr_type(av3, known)
                                    else:
                                        arg_code3 = self.codegen_expr(av3, known)
                                        arg_type3 = self.infer_expr_type(av3, known)
                                case DictExpr:
                                    if len(av3.entries) == 0:
                                        match expected_pt as ept5:
                                            case DictType:
                                                arg_code3 = "lucid_dict_str_" + mangle_component(ept5.value_type) + "_of(0, (const char *[]){0}, (" + c_type_of(ept5.value_type) + "[]){0})"
                                                arg_type3 = ept5
                                            case _:
                                                arg_code3 = self.codegen_expr(av3, known)
                                                arg_type3 = self.infer_expr_type(av3, known)
                                    else:
                                        arg_code3 = self.codegen_expr(av3, known)
                                        arg_type3 = self.infer_expr_type(av3, known)
                                case SetExpr:
                                    if len(av3.elements) == 0:
                                        match expected_pt as ept6:
                                            case SetType:
                                                arg_code3 = "lucid_set_" + mangle_component(ept6.element_type) + "_new()"
                                                arg_type3 = ept6
                                            case _:
                                                arg_code3 = self.codegen_expr(av3, known)
                                                arg_type3 = self.infer_expr_type(av3, known)
                                    else:
                                        arg_code3 = self.codegen_expr(av3, known)
                                        arg_type3 = self.infer_expr_type(av3, known)
                                case _:
                                    arg_code3 = self.codegen_expr(av3, known)
                                    arg_type3 = self.infer_expr_type(av3, known)
                            arg_codes.append(arg_code3)
                            match arg_type3 as at:
                                case LType:
                                    arg_types.append(at)
                                case none:
                                    pass
                            ci = ci + 1
                        if callee.name == "print":
                            return self.codegen_print(result.args, known)
                        if callee.name == "len" and len(result.args) == 1:
                            match self.infer_expr_type(result.args[0].value, known) as at:
                                case ListType:
                                    return "(" + arg_codes[0] + "->len)"
                                case _:
                                    return "((long) strlen(" + arg_codes[0] + "))"
                        # `int(tok.text)`/`float(tok.text)` -- str-to-
                        # number conversion, the C standard library
                        # functions this subset's own runtime prelude
                        # doesn't need to define itself, since <stdlib.h>
                        # is already included for malloc/realloc.
                        if callee.name == "int" and len(result.args) == 1:
                            return "(atol(" + arg_codes[0] + "))"
                        if callee.name == "float" and len(result.args) == 1:
                            return "(strtod(" + arg_codes[0] + ", NULL))"
                        # `str(n)` -- the other direction, a number-to-
                        # str conversion (checker.lucid's/codegen.lucid's
                        # own dominant use); dispatches on the argument's
                        # own static type since C has no single runtime
                        # helper polymorphic over int/double.
                        if callee.name == "str" and len(result.args) == 1:
                            match self.infer_expr_type(result.args[0].value, known) as st:
                                case FloatType:
                                    return "lucid_rt_str_of_float(" + arg_codes[0] + ")"
                                case _:
                                    return "lucid_rt_str_of_int(" + arg_codes[0] + ")"
                        # `sorted(names)` -- a fresh, ascending-sorted
                        # copy of a list[str] (verified directly against
                        # the reference interpreter: the original list is
                        # untouched).
                        if callee.name == "sorted" and len(result.args) == 1:
                            return "lucid_rt_sorted_str(" + arg_codes[0] + ")"
                        match find_signature_assignable(self.classes, self.functions, callee.name, arg_types) as sig:
                            case FuncSig:
                                # A subtype argument value (`Binary`,
                                # say) flowing into a sealed-base-typed
                                # parameter (`Expr`) needs the same
                                # explicit cast a sealed-base-typed
                                # Construct argument already gets (see
                                # codegen_expr's own Construct case) --
                                # `Binary *` and `Expr *` are unrelated C
                                # struct types here. A concrete value
                                # flowing into a *union*-typed parameter
                                # (`expected_return: LType | none`, once
                                # a parameter was allowed to be a union
                                # at all) needs the matching wrap
                                # instead -- see cast_or_wrap's own
                                # header comment.
                                cast_codes: list[str] = []
                                i = 0
                                while i < len(arg_codes) and i < len(sig.param_types):
                                    cast_code = arg_codes[i]
                                    if i < len(arg_types):
                                        cast_code = cast_or_wrap(self.classes, sig.param_types[i], arg_types[i], cast_code)
                                    cast_codes.append(cast_code)
                                    i = i + 1
                                name = mangled_name(self.functions, sig)
                                return name + "(" + join_with(cast_codes, ", ") + ")"
                            case none:
                                return callee.name + "(" + join_with(arg_codes, ", ") + ")"
                    case Attribute:
                        receiver_code = self.codegen_expr(callee.value, known)
                        match self.infer_expr_type(callee.value, known) as rt:
                            case StrType:
                                if callee.attr == "endswith" and len(result.args) == 1:
                                    suffix_code = self.codegen_expr(result.args[0].value, known)
                                    return "lucid_rt_str_endswith(" + receiver_code + ", " + suffix_code + ")"
                                return "0 /* unsupported str method */"
                            case ListType:
                                name = "lucid_list_" + mangle_component(rt.element_type)
                                if callee.attr == "append" and len(result.args) == 1:
                                    value_code = self.codegen_expr(result.args[0].value, known)
                                    match self.infer_expr_type(result.args[0].value, known) as at3:
                                        case LType:
                                            value_code = cast_if_needed(rt.element_type, at3, value_code)
                                        case none:
                                            pass
                                    return name + "_append(" + receiver_code + ", " + value_code + ")"
                                if callee.attr == "pop" and len(result.args) == 0:
                                    return name + "_pop(" + receiver_code + ")"
                                return "0 /* unsupported list method */"
                            case ClassType:
                                method_arg_codes: list[str] = [receiver_code]
                                match self.classes.get(rt.name, none) as method_cls:
                                    case ClassSig:
                                        match method_signature(method_cls, callee.attr) as method_sig:
                                            case FuncSig:
                                                mi = 0
                                                while mi < len(result.args):
                                                    a = result.args[mi]
                                                    arg_code2 = self.codegen_expr(a.value, known)
                                                    if mi < len(method_sig.param_types):
                                                        match self.infer_expr_type(a.value, known) as at4:
                                                            case LType:
                                                                arg_code2 = cast_or_wrap(self.classes, method_sig.param_types[mi], at4, arg_code2)
                                                            case none:
                                                                pass
                                                    method_arg_codes.append(arg_code2)
                                                    mi = mi + 1
                                            case none:
                                                for a in result.args:
                                                    method_arg_codes.append(self.codegen_expr(a.value, known))
                                    case none:
                                        for a in result.args:
                                            method_arg_codes.append(self.codegen_expr(a.value, known))
                                return method_c_name(rt.name, callee.attr) + "(" + join_with(method_arg_codes, ", ") + ")"
                            case DictType:
                                if callee.attr == "get" and len(result.args) == 2:
                                    key_code = self.codegen_expr(result.args[0].value, known)
                                    name = "lucid_dict_str_" + mangle_component(rt.value_type)
                                    match result.args[1].value as default_v:
                                        case LiteralExpr:
                                            match default_v.value as lit:
                                                case NoneLit:
                                                    # `self.classes.get(
                                                    # cd.name, none)` --
                                                    # infer_expr_type's
                                                    # own DictType.get()
                                                    # case already made
                                                    # this a `V | none`
                                                    # union (see its
                                                    # header comment);
                                                    # the dict's own
                                                    # `_get` always
                                                    # returns a bare
                                                    # `ctype` though (a
                                                    # pointer for every
                                                    # class/list value
                                                    # type this shape
                                                    # actually needs), so
                                                    # the call site has
                                                    # to build the tagged
                                                    # union struct itself
                                                    # -- a NULL sentinel
                                                    # default doubles as
                                                    # "not found", no
                                                    # GNU statement
                                                    # expression needed
                                                    # since `_get` is a
                                                    # pure lookup, safe
                                                    # to call twice.
                                                    call_expr = name + "_get(" + receiver_code + ", " + key_code + ", NULL)"
                                                    opt_members2: list[LType] = []
                                                    opt_members2.append(rt.value_type)
                                                    opt_members2.append(NoneType())
                                                    found_code = wrap_union_value(opt_members2, rt.value_type, call_expr)
                                                    missing_code = wrap_union_value(opt_members2, NoneType(), "")
                                                    return "((" + call_expr + " != NULL) ? " + found_code + " : " + missing_code + ")"
                                                case _:
                                                    pass
                                        case _:
                                            pass
                                    default_code = self.codegen_expr(result.args[1].value, known)
                                    return name + "_get(" + receiver_code + ", " + key_code + ", " + default_code + ")"
                                return "0 /* unsupported dict method */"
                            case SetType:
                                if callee.attr == "add" and len(result.args) == 1:
                                    value_code2 = self.codegen_expr(result.args[0].value, known)
                                    match self.infer_expr_type(result.args[0].value, known) as at5:
                                        case LType:
                                            value_code2 = cast_if_needed(rt.element_type, at5, value_code2)
                                        case none:
                                            pass
                                    set_name2 = "lucid_set_" + mangle_component(rt.element_type)
                                    return set_name2 + "_add(" + receiver_code + ", " + value_code2 + ")"
                                return "0 /* unsupported set method */"
                            case _:
                                return "0 /* unsupported method call */"
                    case _:
                        return "0 /* unsupported call target */"
            case _:
                return "0 /* unsupported expression */"

    def codegen_print(self, args: list[Arg], known: dict[str, LType]) -> str:
        has_class_arg = false
        for a in args:
            match self.infer_expr_type(a.value, known) as at:
                case ClassType:
                    has_class_arg = true
                case _:
                    pass
        if has_class_arg:
            return self.codegen_print_with_class_args(args, known)
        format_parts: list[str] = []
        value_codes: list[str] = []
        i = 0
        while i < len(args):
            if i > 0:
                format_parts.append(" ")
            arg_type = self.infer_expr_type(args[i].value, known)
            arg_code = self.codegen_expr(args[i].value, known)
            match arg_type as at:
                case StrType:
                    format_parts.append("%s")
                case BoolType:
                    format_parts.append("%s")
                    arg_code = "(" + arg_code + " ? \"true\" : \"false\")"
                case FloatType:
                    format_parts.append("%g")
                case _:
                    format_parts.append("%ld")
                    # A varargs call only promotes int to int, never on
                    # to long -- an int-typed C expression here (a bare
                    # negative literal like `(-1)`, which defaults to
                    # int in C, unlike a runtime-computed `long` value)
                    # read back through "%ld" is undefined behavior, a
                    # real, previously-undiscovered miscompile caught by
                    # `print(-1)` printing a garbage value instead of
                    # -1. The explicit cast is correct whether or not
                    # `arg_code` was already `long`.
                    arg_code = "(long) " + arg_code
            value_codes.append(arg_code)
            i = i + 1
        format_str = c_string_literal(join_with(format_parts, "") + "\n")
        pieces: list[str] = [format_str]
        for v in value_codes:
            pieces.append(v)
        return "printf(" + join_with(pieces, ", ") + ")"

    # `print`'s call site is an expression (codegen_expr's Call arm), so
    # this always has to return one C expression, never a statement
    # sequence -- a C comma expression, evaluating each argument's own
    # `printf(...)` (or, for a class-typed argument, its
    # `lucid_print_<ClassName>` call, always `void`, fine as a non-final
    # comma operand) left to right, with its own inline `printf(" ")`
    # between arguments and a final `printf("\n")`.
    def codegen_print_with_class_args(self, args: list[Arg], known: dict[str, LType]) -> str:
        terms: list[str] = []
        i = 0
        while i < len(args):
            if i > 0:
                terms.append("printf(\" \")")
            arg_type = self.infer_expr_type(args[i].value, known)
            arg_code = self.codegen_expr(args[i].value, known)
            match arg_type as at:
                case ClassType:
                    terms.append("lucid_print_" + at.name + "(" + arg_code + ")")
                case StrType:
                    terms.append("printf(\"%s\", " + arg_code + ")")
                case BoolType:
                    terms.append("printf(\"%s\", (" + arg_code + " ? \"true\" : \"false\"))")
                case _:
                    # Same int-under-"%ld" varargs fix as codegen_print's
                    # own (no-class-argument) path -- see its comment.
                    terms.append("printf(\"%ld\", (long) " + arg_code + ")")
            i = i + 1
        terms.append("printf(\"\\n\")")
        return "(" + join_with(terms, ", ") + ")"

    def ident_pattern_name(self, p: Pattern) -> str:
        match p as result:
            case IdentPattern:
                return c_safe_ident(result.name)
            case _:
                return "_unsupported_pattern"

    def ident_target_name(self, e: Expr) -> str:
        match e as result:
            case Ident:
                return c_safe_ident(result.name)
            case _:
                return "_unsupported_target"

    # `broken_flag` names the C variable that an enclosing loop's
    # `if_broken` clause (if any) checks after the loop exits --
    # `codegen_stmt`'s Break case sets it before emitting `break;`. It
    # names the *innermost* enclosing loop's flag (or none, if that loop
    # has no `if_broken` clause): entering a nested loop's own body
    # always rebinds it to that loop's own flag (or none), per
    # docs/for-and-while.md's "an if_broken clause belongs to the loop
    # immediately before it".
    def codegen_block(self, stmts: list[Stmt], indent: str, known: dict[str, LType], broken_flag: str | none, expected_return: LType | none) -> str:
        lines: list[str] = []
        for s in stmts:
            lines.append(self.codegen_stmt(s, indent, known, broken_flag, expected_return))
        return join_with(lines, "\n")

    def codegen_stmt(self, s: Stmt, indent: str, known: dict[str, LType], broken_flag: str | none, expected_return: LType | none) -> str:
        match s as result:
            case VarDef:
                value_code = "0"
                inferred: LType | none = resolve_type_expr(result.type_annotation)
                match result.value as v:
                    case ListExpr:
                        # Mirrors check_stmt's VarDef handling: an empty
                        # list literal can't infer its own element type
                        # from codegen_expr's usual
                        # infer_expr_type(expr)-driven path (nothing to
                        # look at), so a declared list[T] type drives
                        # codegen directly here instead.
                        if len(v.elements) == 0:
                            match inferred as it:
                                case ListType:
                                    lname = "lucid_list_" + mangle_component(it.element_type)
                                    value_code = lname + "_new()"
                                case _:
                                    value_code = self.codegen_expr(v, known)
                        else:
                            value_code = self.codegen_expr(v, known)
                            if inferred == none:
                                inferred = self.infer_expr_type(v, known)
                    case DictExpr:
                        # Same bidirectional case as the empty list
                        # literal above, for the same reason.
                        if len(v.entries) == 0:
                            match inferred as it:
                                case DictType:
                                    dname = "lucid_dict_str_" + mangle_component(it.value_type)
                                    value_code = dname + "_of(0, (const char *[]){0}, (" + c_type_of(it.value_type) + "[]){0})"
                                case _:
                                    value_code = self.codegen_expr(v, known)
                        else:
                            value_code = self.codegen_expr(v, known)
                            if inferred == none:
                                inferred = self.infer_expr_type(v, known)
                    case SetExpr:
                        # Same bidirectional case as the empty list/dict
                        # literal above -- `names: set[str] = {}`
                        # (codegen.lucid's own dominant shape) is always
                        # empty at the literal.
                        if len(v.elements) == 0:
                            match inferred as it:
                                case SetType:
                                    value_code = "lucid_set_" + mangle_component(it.element_type) + "_new()"
                                case _:
                                    value_code = self.codegen_expr(v, known)
                        else:
                            value_code = self.codegen_expr(v, known)
                            if inferred == none:
                                inferred = self.infer_expr_type(v, known)
                    case Expr:
                        value_code = self.codegen_expr(v, known)
                        initializer_type = self.infer_expr_type(v, known)
                        if inferred == none:
                            inferred = initializer_type
                        else:
                            # A declared union type (`x: Item | none =
                            # none`) whose initializer's own type is
                            # narrower (a member, or NoneType for a bare
                            # `none` literal) needs the same wrap
                            # codegen_stmt's Assignment/Return arms
                            # already give a narrower value assigned
                            # into an established union -- otherwise the
                            # raw, unwrapped initializer (here, `0 /*
                            # unsupported literal */` for a `none`
                            # literal) gets assigned straight into the
                            # union-typed C local, which doesn't
                            # type-check.
                            match inferred as decl_t:
                                case UnionLType:
                                    match initializer_type as it2:
                                        case LType:
                                            if not types_equal(decl_t, it2):
                                                match find_union_member(self.classes, decl_t.members, it2) as target2:
                                                    case LType:
                                                        wrap_code2 = value_code
                                                        match it2 as it2t:
                                                            case ClassType:
                                                                match target2 as tt2:
                                                                    case ClassType:
                                                                        if it2t.name != tt2.name:
                                                                            wrap_code2 = "(" + c_type_of(tt2) + ") " + value_code
                                                                    case _:
                                                                        pass
                                                            case _:
                                                                pass
                                                        value_code = wrap_union_value(decl_t.members, target2, wrap_code2)
                                                    case none:
                                                        pass
                                        case none:
                                            pass
                                case ClassType:
                                    # `exception_type: TypeExpr =
                                    # NamedType(...)` (self-host/
                                    # parser.lucid's own
                                    # `parse_try_stmt`) -- a declared
                                    # plain (non-union) sealed-base type
                                    # whose initializer's own static type
                                    # is a narrower concrete subtype,
                                    # needing the same explicit cast a
                                    # later plain reassignment already
                                    # gets (see codegen_stmt's own
                                    # Assignment arm) -- a real,
                                    # previously-undiscovered gap this
                                    # VarDef case never covered at all,
                                    # caught by compiling parser.lucid
                                    # itself.
                                    match initializer_type as it3:
                                        case ClassType:
                                            if it3.name != decl_t.name:
                                                value_code = "(" + c_type_of(decl_t) + ") " + value_code
                                        case _:
                                            pass
                                case _:
                                    pass
                    case none:
                        pass
                name = self.ident_pattern_name(result.pattern)
                match inferred as it:
                    case LType:
                        known[name] = it
                    case none:
                        pass
                return indent + name + " = " + value_code + ";"
            case Assignment:
                match result.value as rhs:
                    case Propagate:
                        return self.codegen_propagate_assignment(result, rhs, indent, known, expected_return)
                    case _:
                        pass
                prelude = ""
                rhs_expr = result.value
                ok_var = "__lucid_hoist_" + str(result.value.span.line) + "_" + str(result.value.span.column)
                match hoist_propagate(result.value, Ident(result.value.span, ok_var)) as h:
                    case Hoisted:
                        match self.codegen_hoisted_prelude(h.prop, ok_var, indent, known, expected_return) as p:
                            case str:
                                prelude = p + "\n"
                                rhs_expr = h.replaced
                            case none:
                                pass
                    case none:
                        pass
                value_code = self.codegen_expr(rhs_expr, known)
                match result.target as target:
                    case Attribute:
                        # A field write, not a local binding -- `known`
                        # is untouched (there's no local name here to
                        # register a type for).
                        receiver_code = self.codegen_expr(target.value, known)
                        # A union-typed field (self-host/ast.lucid's own
                        # `alias: str | none` and its many siblings)
                        # assigned a member value needs the same wrap
                        # every other union-typed slot in this codegen
                        # gets -- see codegen_expr's own Construct case
                        # for the identical shape at construction time
                        # instead of assignment.
                        match self.infer_expr_type(target.value, known) as receiver_t:
                            case ClassType:
                                match self.classes.get(receiver_t.name, none) as receiver_cls:
                                    case ClassSig:
                                        match field_type(receiver_cls, target.attr) as ft5:
                                            case UnionLType:
                                                match self.infer_expr_type(rhs_expr, known) as vt5:
                                                    case UnionLType:
                                                        pass
                                                    case LType:
                                                        match find_union_member(self.classes, ft5.members, vt5) as target5:
                                                            case LType:
                                                                wrap_code5 = value_code
                                                                match vt5 as vt5t:
                                                                    case ClassType:
                                                                        match target5 as tt5:
                                                                            case ClassType:
                                                                                if vt5t.name != tt5.name:
                                                                                    wrap_code5 = "(" + c_type_of(tt5) + ") " + value_code
                                                                            case _:
                                                                                pass
                                                                    case _:
                                                                        pass
                                                                value_code = wrap_union_value(ft5.members, target5, wrap_code5)
                                                            case none:
                                                                pass
                                                    case none:
                                                        pass
                                            case _:
                                                pass
                                    case none:
                                        pass
                            case _:
                                pass
                        return prelude + indent + receiver_code + "->" + target.attr + " = " + value_code + ";"
                    case Index:
                        # `known[name] = t` / `self.classes[cd.name] =
                        # ClassSig(...)` (checker.lucid's own dominant
                        # dict-mutation shape) -- compiles to the
                        # matching `lucid_dict_str_<V>_set` call
                        # (checker.lucid's own check_stmt Assignment arm
                        # only accepts this when the receiver is a
                        # dict[str, T] in the first place).
                        dict_receiver_code = self.codegen_expr(target.value, known)
                        key_code = self.codegen_expr(target.index, known)
                        match self.infer_expr_type(target.value, known) as dict_rt:
                            case DictType:
                                dict_name = "lucid_dict_str_" + mangle_component(dict_rt.value_type)
                                match self.infer_expr_type(rhs_expr, known) as dict_vt:
                                    case LType:
                                        value_code = cast_if_needed(dict_rt.value_type, dict_vt, value_code)
                                    case none:
                                        pass
                                return prelude + indent + dict_name + "_set(" + dict_receiver_code + ", " + key_code + ", " + value_code + ");"
                            case _:
                                return prelude + indent + "/* unsupported index assignment */;"
                    case _:
                        name = self.ident_target_name(result.target)
                        match self.infer_expr_type(rhs_expr, known) as it:
                            case LType:
                                # Mirrors checker.lucid's own bind():
                                # when this name's established type
                                # (from its VarDef's declared type, or an
                                # earlier assignment -- already in
                                # `known`, via infer_local_types' own
                                # pre-pass) is a wider union than this
                                # particular value's own type, keep the
                                # established union in `known` (a later
                                # read, or a later reassignment back to a
                                # different member, still needs to see
                                # it) and wrap this value into it instead
                                # of overwriting -- the same
                                # Return-statement wrapping
                                # codegen_stmt's own Return arm already
                                # does, just at an Assignment instead.
                                match known.get(name, none) as existing:
                                    case UnionLType:
                                        if not types_equal(existing, it):
                                            match find_union_member(self.classes, existing.members, it) as target3:
                                                case LType:
                                                    wrap_code3 = value_code
                                                    match it as itt3:
                                                        case ClassType:
                                                            match target3 as tt3:
                                                                case ClassType:
                                                                    if itt3.name != tt3.name:
                                                                        wrap_code3 = "(" + c_type_of(tt3) + ") " + value_code
                                                                case _:
                                                                    pass
                                                        case _:
                                                            pass
                                                    value_code = wrap_union_value(existing.members, target3, wrap_code3)
                                                case none:
                                                    pass
                                    case ClassType:
                                        # Mirrors checker.lucid's own
                                        # bind() -- reassigning a name
                                        # already established as a plain
                                        # sealed-base class with a
                                        # concrete subtype value needs
                                        # the same explicit cast a union
                                        # member or a Construct argument
                                        # does (see codegen_expr's own
                                        # Construct case).
                                        match it as itt4:
                                            case ClassType:
                                                if itt4.name != existing.name:
                                                    value_code = "(" + c_type_of(existing) + ") " + value_code
                                            case _:
                                                pass
                                    case none:
                                        known[name] = it
                                    case _:
                                        pass
                            case none:
                                pass
                        return prelude + indent + name + " = " + value_code + ";"
            case If:
                cond = self.codegen_expr(result.condition, known)
                then_code = self.codegen_block(result.then_branch, indent + "    ", known, broken_flag, expected_return)
                text = indent + "if (" + cond + ") {\n" + then_code + "\n" + indent + "}"
                for branch in result.elif_branches:
                    elif_cond = self.codegen_expr(branch.condition, known)
                    elif_code = self.codegen_block(branch.body, indent + "    ", known, broken_flag, expected_return)
                    text = text + " else if (" + elif_cond + ") {\n" + elif_code + "\n" + indent + "}"
                match result.else_branch as else_body:
                    case list[Stmt]:
                        else_code = self.codegen_block(else_body, indent + "    ", known, broken_flag, expected_return)
                        text = text + " else {\n" + else_code + "\n" + indent + "}"
                    case none:
                        pass
                return text
            case While:
                cond = self.codegen_expr(result.condition, known)
                match result.if_broken_body as broken_body:
                    case list[Stmt]:
                        loop_flag = "__lucid_broke_" + str(result.span.line) + "_" + str(result.span.column)
                        body = self.codegen_block(result.body, indent + "        ", known, loop_flag, expected_return)
                        broken_code = self.codegen_block(broken_body, indent + "        ", known, broken_flag, expected_return)
                        return indent + "{\n" + indent + "    int " + loop_flag + " = 0;\n" + indent + "    while (" + cond + ") {\n" + body + "\n" + indent + "    }\n" + indent + "    if (" + loop_flag + ") {\n" + broken_code + "\n" + indent + "    }\n" + indent + "}"
                    case none:
                        body = self.codegen_block(result.body, indent + "    ", known, none, expected_return)
                        return indent + "while (" + cond + ") {\n" + body + "\n" + indent + "}"
            case For:
                return self.codegen_for(result, indent, known, broken_flag, expected_return)
            case Return:
                match result.value as v:
                    case Propagate:
                        return self.codegen_propagate_return(v, indent, known, expected_return)
                    case Expr:
                        prelude = ""
                        rv = v
                        ok_var = "__lucid_hoist_" + str(v.span.line) + "_" + str(v.span.column)
                        match hoist_propagate(v, Ident(v.span, ok_var)) as h:
                            case Hoisted:
                                match self.codegen_hoisted_prelude(h.prop, ok_var, indent, known, expected_return) as p:
                                    case str:
                                        prelude = p + "\n"
                                        rv = h.replaced
                                    case none:
                                        pass
                            case none:
                                pass
                        value_code = self.codegen_expr(rv, known)
                        match expected_return as rt:
                            case UnionLType:
                                # The value's own static type is usually
                                # exactly one union member (`return
                                # LexError(...)`, `return none`), needing
                                # a wrap into the declared union return
                                # type's own tagged struct -- but it can
                                # also already BE that exact union
                                # (`return self.next_token()` from
                                # inside `next_token` itself, a real
                                # program shape in self-host/lexer.lucid:
                                # a method returning its own call, whose
                                # inferred type is already `Token |
                                # LexError`), in which case wrapping
                                # again would nest a union inside its own
                                # `.v0` field and fail to compile --
                                # checker.lucid's own Return-checking
                                # (check_stmt's assignable_to) accepts
                                # both shapes because types_equal's own
                                # first branch already covers "same
                                # union", so codegen has to make the same
                                # distinction explicitly here, not just
                                # membership.
                                match self.infer_expr_type(rv, known) as vt:
                                    case UnionLType:
                                        if not types_equal(vt, rt):
                                            return prelude + self.codegen_union_narrowing_return(result.span.line, result.span.column, vt, rt, value_code, indent)
                                    case LType:
                                        match find_union_member(self.classes, rt.members, vt) as target:
                                            case LType:
                                                wrap_code = value_code
                                                # A class-typed value
                                                # narrower than the
                                                # union member it
                                                # belongs in (a
                                                # `LiteralExpr` for an
                                                # `Expr` member) needs
                                                # the same explicit cast
                                                # codegen_expr's own
                                                # Construct case gives a
                                                # sealed-base field --
                                                # see its comment for why
                                                # this is safe.
                                                match vt as vtt:
                                                    case ClassType:
                                                        match target as tt:
                                                            case ClassType:
                                                                if vtt.name != tt.name:
                                                                    wrap_code = "(" + c_type_of(tt) + ") " + value_code
                                                            case _:
                                                                pass
                                                    case _:
                                                        pass
                                                value_code = wrap_union_value(rt.members, target, wrap_code)
                                            case none:
                                                pass
                                    case none:
                                        pass
                            case ClassType:
                                # The declared return type is a plain
                                # (non-union) class, but the returned
                                # value's own static type can still be a
                                # narrower subtype (`-> Expr` returning a
                                # `LiteralExpr`) -- same cast, no
                                # union-wrap needed since there's no
                                # tagged struct here at all, just a
                                # pointer type mismatch C itself would
                                # otherwise reject.
                                match self.infer_expr_type(rv, known) as vt:
                                    case ClassType:
                                        if vt.name != rt.name:
                                            value_code = "(" + c_type_of(rt) + ") " + value_code
                                    case _:
                                        pass
                            case _:
                                pass
                        return prelude + indent + "return " + value_code + ";"
                    case none:
                        return indent + "return;"
            case Break:
                match broken_flag as flag:
                    case str:
                        return indent + flag + " = 1;\n" + indent + "break;"
                    case none:
                        return indent + "break;"
            case Continue:
                return indent + "continue;"
            case Pass:
                return indent + ";"
            case ExprStmt:
                match result.expr as e:
                    case Propagate:
                        return self.codegen_propagate_exprstmt(e, indent, known, expected_return)
                    case _:
                        prelude6 = ""
                        expr6 = result.expr
                        ok_var6 = "__lucid_hoist_" + str(result.expr.span.line) + "_" + str(result.expr.span.column)
                        match hoist_propagate(result.expr, Ident(result.expr.span, ok_var6)) as h6:
                            case Hoisted:
                                match self.codegen_hoisted_prelude(h6.prop, ok_var6, indent, known, expected_return) as p6:
                                    case str:
                                        prelude6 = p6 + "\n"
                                        expr6 = h6.replaced
                                    case none:
                                        pass
                            case none:
                                pass
                        return prelude6 + indent + self.codegen_expr(expr6, known) + ";"
            case MetadataStmt:
                return ""
            case FromImport:
                # Already handled by codegen_module's own call to
                # resolve_all_declarations -- emits nothing here, the
                # same as Pass, so a `from .lexer import ...` statement
                # among a module's own top-level statements doesn't
                # reach codegen_entry_point's body as a real C statement.
                return ""
            case MatchStmt:
                return self.codegen_match(result, indent, known, broken_flag, expected_return)
            case _:
                return indent + "/* unsupported statement */"

    # Desugars `name = expr?` (checker.lucid's check_rhs_expr only
    # allows '?' here -- see its own header comment) into the statement
    # sequence docs/question-mark-operator.md's own desugaring describes,
    # built directly in C since a GNU statement-expression is off the
    # table: evaluate `expr` once into a temp of its own (source) union
    # type, check its tag against the one error member, return early
    # (wrapped into the enclosing function's own union return type) if
    # it's active, otherwise assign the temp's ok-member field to the
    # assignment's target. `?`'s error-recognition (a class name ending
    # in "Error") and the exactly-one-error/exactly-one-ok requirement
    # both mirror check_propagate exactly, since codegen never re-checks
    # anything checker.lucid already approved -- see this method's own
    # narrower restriction (checker.lucid's check_propagate note) on why
    # this subset requires exactly one error member, not "at least one"
    # the way compiler/crates/lucid-checker itself allows.
    def codegen_propagate_assignment(self, assign: Assignment, prop: Propagate, indent: str, known: dict[str, LType], expected_return: LType | none) -> str:
        match self.infer_expr_type(prop.expr, known) as it:
            case UnionLType:
                ok_types: list[LType] = []
                err_types: list[LType] = []
                for m in it.members:
                    match m as mt:
                        case ClassType:
                            if mt.name.endswith("Error"):
                                err_types.append(mt)
                            else:
                                ok_types.append(mt)
                        case _:
                            ok_types.append(mt)
                if len(ok_types) != 1 or len(err_types) != 1:
                    return indent + "/* unsupported '?' */"
                ok_type = ok_types[0]
                err_type = err_types[0]
                temp = "__lucid_prop_" + str(prop.span.line) + "_" + str(prop.span.column)
                inner_code = self.codegen_expr(prop.expr, known)
                err_index = union_member_index(it.members, err_type)
                ok_index = union_member_index(it.members, ok_type)
                err_field = temp + ".v" + str(err_index)
                wrapped_err = err_field
                match expected_return as rt:
                    case UnionLType:
                        wrapped_err = wrap_union_value(rt.members, err_type, err_field)
                    case _:
                        pass
                name = self.ident_target_name(assign.target)
                union_ctype = union_c_name(it.members)
                decl = indent + union_ctype + " " + temp + " = " + inner_code + ";"
                check = indent + "if (" + temp + ".tag == " + str(err_index) + ") {\n" + indent + "    return " + wrapped_err + ";\n" + indent + "}"
                ok_field = temp + ".v" + str(ok_index)
                # Mirrors codegen_stmt's own Assignment arm: `value:
                # Expr | none = none` then `value = self.parse_expr()?`
                # (self-host/parser.lucid's own `parse_statement`, a
                # real previously-undiscovered miscompile caught by
                # compiling it) needs the unwrapped ok value wrapped
                # into the *established* wider union, not assigned raw
                # -- a bare `value = temp.v0;` would assign an `Expr *`
                # straight into a `lucid_union_Expr_none` struct
                # variable, a real C type error, not just a style
                # mismatch. An established plain class needs the same
                # subtype cast a plain reassignment already gets.
                wrapped_ok = ok_field
                match known.get(name, none) as existing:
                    case UnionLType:
                        if not types_equal(existing, it):
                            match find_union_member(self.classes, existing.members, ok_type) as target2:
                                case LType:
                                    ok_wrap_code = ok_field
                                    match ok_type as okt2:
                                        case ClassType:
                                            match target2 as tt2:
                                                case ClassType:
                                                    if okt2.name != tt2.name:
                                                        ok_wrap_code = "(" + c_type_of(tt2) + ") " + ok_field
                                                case _:
                                                    pass
                                        case _:
                                            pass
                                    wrapped_ok = wrap_union_value(existing.members, target2, ok_wrap_code)
                                case none:
                                    pass
                    case ClassType:
                        match ok_type as okt3:
                            case ClassType:
                                if okt3.name != existing.name:
                                    wrapped_ok = "(" + c_type_of(existing) + ") " + ok_field
                            case _:
                                pass
                    case none:
                        known[name] = ok_type
                    case _:
                        pass
                unwrap = indent + name + " = " + wrapped_ok + ";"
                return decl + "\n" + check + "\n" + unwrap
            case _:
                return indent + "/* unsupported '?' */"

    # `return expr?` -- the same desugaring as codegen_propagate_
    # assignment (see its own comment for the ok/err-type split and the
    # temp/tag-check shape), except there's no name to unwrap into: the
    # ok value is returned directly, wrapped into `expected_return` the
    # same way codegen_stmt's own Return arm wraps an ordinary
    # expression value (a union member gets tagged, or a subtype gets an
    # explicit cast -- see its own comments for why each is safe).
    # `self-host/parser.lucid`'s own dominant `?` shape (`return
    # self.parse_expr()?`, docs/question-mark-operator.md's own example
    # shape) is exactly this.
    # `return some_call()` where the call's own return type is a
    # union that's a strict *subset* of the enclosing function's own
    # declared union return type -- self-host/parser.lucid's own `def
    # parse(...) -> ParsedModule | ParserError | LexError: ... return
    # parser.parse_module()` (`parse_module`'s own return type is the
    # narrower `ParsedModule | ParserError`, no `LexError`). Checker.lucid's
    # own class_assignable_to accepts this (every member of the
    # narrower union satisfies the wider one), but the two unions are
    # two genuinely different tagged structs in the generated C (a
    # different member set means a different struct layout and
    # different tag values), so simply returning the narrower value
    # as-is -- what codegen_stmt's Return arm does for the "same exact
    # union" case -- would be a real C type error here. This evaluates
    # the narrower value into its own temp once, then an if/else-if
    # chain on *its own* tag re-wraps whichever member is active into
    # the wider union's own tag/field layout (find_union_member/
    # wrap_union_value, the same helpers an ordinary member-to-union
    # wrap already uses) and returns that -- called instead of the
    # ordinary single-expression `return`, so it owns emitting the
    # `return` statement(s) itself, for each possible tag.
    def codegen_union_narrowing_return(self, span_line: int, span_column: int, narrow: UnionLType, wide: UnionLType, value_code: str, indent: str) -> str:
        temp = "__lucid_conv_" + str(span_line) + "_" + str(span_column)
        narrow_ctype = union_c_name(narrow.members)
        decl = indent + narrow_ctype + " " + temp + " = " + value_code + ";"
        ordered = sorted_union_members(narrow.members)
        branches: list[str] = []
        i = 0
        while i < len(ordered):
            m = ordered[i]
            match find_union_member(self.classes, wide.members, m) as target:
                case LType:
                    field_code = temp + ".v" + str(i)
                    wrap_code = field_code
                    match m as mt:
                        case ClassType:
                            match target as tt:
                                case ClassType:
                                    if mt.name != tt.name:
                                        wrap_code = "(" + c_type_of(tt) + ") " + field_code
                                case _:
                                    pass
                        case _:
                            pass
                    wrapped = wrap_union_value(wide.members, target, wrap_code)
                    branches.append("if (" + temp + ".tag == " + str(i) + ") {\n" + indent + "    return " + wrapped + ";\n" + indent + "}")
                case none:
                    pass
            i = i + 1
        return decl + "\n" + indent + join_with(branches, " else ")

    def codegen_propagate_return(self, prop: Propagate, indent: str, known: dict[str, LType], expected_return: LType | none) -> str:
        match self.infer_expr_type(prop.expr, known) as it:
            case UnionLType:
                ok_types: list[LType] = []
                err_types: list[LType] = []
                for m in it.members:
                    match m as mt:
                        case ClassType:
                            if mt.name.endswith("Error"):
                                err_types.append(mt)
                            else:
                                ok_types.append(mt)
                        case _:
                            ok_types.append(mt)
                if len(ok_types) != 1 or len(err_types) != 1:
                    return indent + "/* unsupported '?' */"
                ok_type = ok_types[0]
                err_type = err_types[0]
                temp = "__lucid_prop_" + str(prop.span.line) + "_" + str(prop.span.column)
                inner_code = self.codegen_expr(prop.expr, known)
                err_index = union_member_index(it.members, err_type)
                ok_index = union_member_index(it.members, ok_type)
                err_field = temp + ".v" + str(err_index)
                ok_field = temp + ".v" + str(ok_index)
                wrapped_err = err_field
                wrapped_ok = ok_field
                match expected_return as rt:
                    case UnionLType:
                        wrapped_err = wrap_union_value(rt.members, err_type, err_field)
                        match find_union_member(self.classes, rt.members, ok_type) as target:
                            case LType:
                                ok_wrap_code = ok_field
                                match ok_type as okt:
                                    case ClassType:
                                        match target as tt:
                                            case ClassType:
                                                if okt.name != tt.name:
                                                    ok_wrap_code = "(" + c_type_of(tt) + ") " + ok_field
                                            case _:
                                                pass
                                    case _:
                                        pass
                                wrapped_ok = wrap_union_value(rt.members, target, ok_wrap_code)
                            case none:
                                pass
                    case ClassType:
                        match ok_type as okt2:
                            case ClassType:
                                if okt2.name != rt.name:
                                    wrapped_ok = "(" + c_type_of(rt) + ") " + ok_field
                            case _:
                                pass
                    case _:
                        pass
                union_ctype = union_c_name(it.members)
                decl = indent + union_ctype + " " + temp + " = " + inner_code + ";"
                check = indent + "if (" + temp + ".tag == " + str(err_index) + ") {\n" + indent + "    return " + wrapped_err + ";\n" + indent + "}"
                final_return = indent + "return " + wrapped_ok + ";"
                return decl + "\n" + check + "\n" + final_return
            case _:
                return indent + "/* unsupported '?' */"

    # `expr?` as a bare expression statement -- self-host/parser.lucid's
    # own single most common '?' shape by far (`self.consume_stmt_end()?`,
    # a validation call whose own ok value, typically `none`, is
    # discarded either way, same as any other expression statement's
    # value). Same temp/tag-check/early-return shape as
    # codegen_propagate_assignment/codegen_propagate_return, minus
    # whatever those two do with the ok value afterward -- there's
    # nowhere for it to go here, so it's simply never read out of the
    # temp at all.
    def codegen_propagate_exprstmt(self, prop: Propagate, indent: str, known: dict[str, LType], expected_return: LType | none) -> str:
        match self.infer_expr_type(prop.expr, known) as it:
            case UnionLType:
                ok_types: list[LType] = []
                err_types: list[LType] = []
                for m in it.members:
                    match m as mt:
                        case ClassType:
                            if mt.name.endswith("Error"):
                                err_types.append(mt)
                            else:
                                ok_types.append(mt)
                        case _:
                            ok_types.append(mt)
                if len(ok_types) != 1 or len(err_types) != 1:
                    return indent + "/* unsupported '?' */"
                err_type = err_types[0]
                temp = "__lucid_prop_" + str(prop.span.line) + "_" + str(prop.span.column)
                inner_code = self.codegen_expr(prop.expr, known)
                err_index = union_member_index(it.members, err_type)
                err_field = temp + ".v" + str(err_index)
                wrapped_err = err_field
                match expected_return as rt:
                    case UnionLType:
                        wrapped_err = wrap_union_value(rt.members, err_type, err_field)
                    case _:
                        pass
                union_ctype = union_c_name(it.members)
                decl = indent + union_ctype + " " + temp + " = " + inner_code + ";"
                check = indent + "if (" + temp + ".tag == " + str(err_index) + ") {\n" + indent + "    return " + wrapped_err + ";\n" + indent + "}"
                return decl + "\n" + check
            case _:
                return indent + "/* unsupported '?' */"

    # The codegen counterpart of ast.lucid's own hoist_propagate:
    # `?` nested inside a Call/Construct argument or a Binary operand
    # (`body.append(self.parse_class_member()?)`,
    # `module_name + self.parse_dotted_name()?` -- self-host/
    # parser.lucid's own two nested shapes) is desugared by emitting the
    # same temp/tag-check/early-return block codegen_propagate_exprstmt
    # already builds for a bare `expr?` statement, immediately followed
    # by one more plain C declaration unwrapping the ok value into
    # `ok_var` -- a real local, declared right where it's used (C99/C11
    # allows a declaration mid-block; every other propagate temp in this
    # file already relies on the same thing). The caller then codegens
    # the statement's own hoisted expression tree (Hoisted.replaced)
    # exactly like any other expression: `ok_var` reads back as a plain
    # `Ident`, needing no special case anywhere in codegen_expr, since a
    # C variable's name already matches its Lucid name.
    def codegen_hoisted_prelude(self, prop: Propagate, ok_var: str, indent: str, known: dict[str, LType], expected_return: LType | none) -> str | none:
        match self.infer_expr_type(prop.expr, known) as it:
            case UnionLType:
                ok_types: list[LType] = []
                err_types: list[LType] = []
                for m in it.members:
                    match m as mt:
                        case ClassType:
                            if mt.name.endswith("Error"):
                                err_types.append(mt)
                            else:
                                ok_types.append(mt)
                        case _:
                            ok_types.append(mt)
                if len(ok_types) != 1 or len(err_types) != 1:
                    return none
                ok_type = ok_types[0]
                err_type = err_types[0]
                temp = "__lucid_prop_" + str(prop.span.line) + "_" + str(prop.span.column)
                inner_code = self.codegen_expr(prop.expr, known)
                err_index = union_member_index(it.members, err_type)
                ok_index = union_member_index(it.members, ok_type)
                err_field = temp + ".v" + str(err_index)
                wrapped_err = err_field
                match expected_return as rt:
                    case UnionLType:
                        wrapped_err = wrap_union_value(rt.members, err_type, err_field)
                    case _:
                        pass
                union_ctype = union_c_name(it.members)
                decl = indent + union_ctype + " " + temp + " = " + inner_code + ";"
                check = indent + "if (" + temp + ".tag == " + str(err_index) + ") {\n" + indent + "    return " + wrapped_err + ";\n" + indent + "}"
                ok_decl = indent + c_type_of(ok_type) + " " + ok_var + " = " + temp + ".v" + str(ok_index) + ";"
                known[ok_var] = ok_type
                return decl + "\n" + check + "\n" + ok_decl
            case _:
                return none

    # A minimal `match`: an if/else-if chain on the subject's own `.tag`
    # field, not a C `switch` -- a `break`/`continue` inside an arm has
    # to mean whatever loop encloses the match (see check_match's own
    # header comment in checker.lucid for why a switch would be wrong
    # here), and an if/else-if chain preserves that for free. The
    # subject is evaluated into its own temp once (matching
    # codegen_propagate_assignment's shape) so a multi-arm match doesn't
    # re-evaluate a subject with side effects once per arm. Each arm's
    # own alias (if the pattern narrows to a real value, i.e. not
    # `case none:`) is declared *inside* that arm's own C block, not
    # hoisted with the rest of the function's locals -- checker.lucid's
    # check_match narrows it to a different type per arm, which would
    # break this subset's "one C declaration per local name" invariant
    # if it were hoisted the normal way (see collect_local_names/
    # infer_local_types, which both skip a MatchStmt entirely for
    # exactly this reason -- the alias never becomes an ordinary hoisted
    # local at all).
    def codegen_match(self, m: MatchStmt, indent: str, known: dict[str, LType], broken_flag: str | none, expected_return: LType | none) -> str:
        subject_code = self.codegen_expr(m.subject, known)
        match self.infer_expr_type(m.subject, known) as st:
            case UnionLType:
                temp = "__lucid_match_" + str(m.span.line) + "_" + str(m.span.column)
                decl = indent + union_c_name(st.members) + " " + temp + " = " + subject_code + ";"
                branches: list[str] = []
                for arm in m.arms:
                    branches.append(self.codegen_match_arm(arm, st, temp, m.subject_alias, indent, known, broken_flag, expected_return))
                # `branches` are each a bare "if (...) { ... }" with no
                # leading indent (unlike codegen_stmt's If arm, which
                # only ever indents its own first "if" once) -- joined
                # with " else " and indented here, once, so a two-plus-
                # arm match doesn't end up with indent re-inserted after
                # every "else " the way naively indenting each arm on
                # its own would.
                return decl + "\n" + indent + join_with(branches, " else ")
            case ClassType:
                match self.classes.get(st.name, none) as cls:
                    case ClassSig:
                        match cls.sealed_root as root:
                            case str:
                                return self.codegen_sealed_match(m, root, subject_code, indent, known, broken_flag, expected_return)
                            case none:
                                return indent + "/* unsupported match subject */"
                    case none:
                        return indent + "/* unsupported match subject */"
            case _:
                # checker.lucid's check_match rejects a match on
                # anything but a union or a sealed-hierarchy class
                # subject outright -- there's no tag to switch on
                # otherwise (see its own header comment) -- so a
                # program that reaches codegen never hits this arm.
                return indent + "/* unsupported match subject */"

    # `match` on a sealed-base-typed subject (checker.lucid's own
    # check_sealed_match already confirmed every arm is either a
    # class-name pattern within the same hierarchy as `root`, or a
    # required trailing wildcard) -- an if/else-if chain on the
    # subject's own hidden `__lucid_tag` field, read through a pointer
    # of the sealed root's own type (`Expr *`), safe for any concrete
    # subclass under C11 6.5.2.3p6 (see emit_struct's own comment). The
    # subject is evaluated into its own `root *` temp once, the same
    # "don't re-evaluate a subject with side effects once per arm"
    # reasoning codegen_match's own union case already uses.
    def codegen_sealed_match(self, m: MatchStmt, root: str, subject_code: str, indent: str, known: dict[str, LType], broken_flag: str | none, expected_return: LType | none) -> str:
        temp = "__lucid_match_" + str(m.span.line) + "_" + str(m.span.column)
        decl = indent + root + " *" + temp + " = " + subject_code + ";"
        branches: list[str] = []
        for arm in m.arms:
            branches.append(self.codegen_sealed_match_arm(arm, root, temp, m.subject_alias, indent, known, broken_flag, expected_return))
        return decl + "\n" + indent + join_with(branches, " else ")

    # A concrete-class arm narrows `temp` (typed as the sealed root's
    # own pointer type) down to the arm's own concrete subclass with an
    # explicit C cast (`(Binary *) temp`) -- the reverse direction of
    # the cast codegen_expr's own Construct case gives a sealed-base
    # field, and only safe here because check_sealed_match already
    # confirmed the tag check just above it in the generated C -- an
    # unconditional cast with no tag check at all would be unsound the
    # same way an unchecked C union access always is. A wildcard arm
    # narrows to nothing (its own tag check is always true, matching
    # codegen_match_arm's identical wildcard handling for the union
    # case), so its own alias, if any, is never bound -- reading it
    # would be an ordinary "undefined name", the same as any other
    # unbound alias in this subset.
    def codegen_sealed_match_arm(self, arm: MatchArm, root: str, temp: str, subject_alias: str | none, indent: str, known: dict[str, LType], broken_flag: str | none, expected_return: LType | none) -> str:
        arm_known: dict[str, LType] = copy_type_scope(known)
        narrowed: str | none = none
        match arm.pattern as pat:
            case TypePattern:
                match resolve_type_expr(pat.type_expr) as nt:
                    case ClassType:
                        narrowed = nt.name
                    case _:
                        pass
            case WildcardPattern:
                pass
            case _:
                pass
        tag_check = "1"
        prelude = ""
        match narrowed as concrete_name:
            case str:
                tag_check = temp + "->__lucid_tag == " + str(class_tag(self.classes, concrete_name))
                match subject_alias as alias_name:
                    case str:
                        safe_alias = c_safe_ident(alias_name)
                        prelude = indent + "    " + concrete_name + " *" + safe_alias + " = (" + concrete_name + " *) " + temp + ";\n"
                        arm_known[safe_alias] = ClassType(concrete_name)
                    case none:
                        pass
            case none:
                # `match m as mt: case ClassType: ... case _:
                # ok_types.append(mt)` (checker.lucid's own
                # check_propagate) -- a wildcard arm's own alias binds
                # to the sealed root type itself, un-narrowed (see
                # check_sealed_match's own comment on why this went
                # unnoticed until now): `temp` is already exactly that
                # pointer type, so no cast is needed, just a plain alias.
                match arm.pattern as p2:
                    case WildcardPattern:
                        match subject_alias as alias_name2:
                            case str:
                                safe_alias2 = c_safe_ident(alias_name2)
                                prelude = indent + "    " + root + " *" + safe_alias2 + " = " + temp + ";\n"
                                arm_known[safe_alias2] = ClassType(root)
                            case none:
                                pass
                    case _:
                        pass
        body = self.codegen_block(arm.body, indent + "    ", arm_known, broken_flag, expected_return)
        return "if (" + tag_check + ") {\n" + prelude + body + "\n" + indent + "}"

    # `subject_type` is always the subject's own UnionLType (see
    # codegen_match's only call site) -- narrowed here down to the one
    # member `arm.pattern` names (or, for `case none:`, NoneType, which
    # gets a tag check but no field access -- 'none' carries no data,
    # the same reason emit_union_type skips a field for it). The narrowed
    # alias (if `m`'s subject_alias names one, and the pattern isn't
    # `case none:`, which has nothing to bind -- see check_match's own
    # note on why 'none' is never bound) is declared as a plain C local
    # *inside* this arm's own `{ }` block, not hoisted with the rest of
    # the function's locals, since it has a different type in each arm.
    def codegen_match_arm(self, arm: MatchArm, subject_type: UnionLType, temp: str, subject_alias: str | none, indent: str, known: dict[str, LType], broken_flag: str | none, expected_return: LType | none) -> str:
        arm_known: dict[str, LType] = copy_type_scope(known)
        narrowed: LType | none = none
        match arm.pattern as pat:
            case TypePattern:
                match resolve_type_expr(pat.type_expr) as nt:
                    case LType:
                        narrowed = nt
                    case none:
                        pass
            case LiteralPattern:
                narrowed = NoneType()
            case WildcardPattern:
                pass
            case _:
                pass
        tag_check = "1"
        prelude = ""
        match narrowed as nt2:
            case NoneType:
                tag_check = temp + ".tag == " + str(union_member_index(subject_type.members, nt2))
            case LType:
                # `nt2` isn't always literally one of `subject_type`'s
                # own members -- `types.lucid`'s own `LType | none` (a
                # union whose `LType` member is itself a sealed class
                # hierarchy) is matched with one arm per *concrete*
                # subclass (`case ClassType:`, `case ListType:`, ...),
                # each a subtype of the actual member (`LType`), not the
                # member itself -- the same "pattern nested one level
                # deeper than the union's own member set" shape
                # check_match's own class_assignable_to check now
                # allows. find_union_member locates that actual member
                # (here, LType) for the tag check and the union field's
                # own C type; an explicit downcast narrows the read
                # value down to `nt2`'s own concrete type, sound only
                # because the tag check just confirmed which member is
                # active -- the same reasoning codegen_sealed_match's
                # own downcast relies on, one level further in.
                match find_union_member(self.classes, subject_type.members, nt2) as member_type:
                    case LType:
                        field_index = union_member_index(subject_type.members, member_type)
                        tag_check = temp + ".tag == " + str(field_index)
                        match subject_alias as alias_name:
                            case str:
                                safe_alias = c_safe_ident(alias_name)
                                field_code = temp + ".v" + str(field_index)
                                prelude = indent + "    " + c_type_of(nt2) + " " + safe_alias + " = " + cast_if_needed(nt2, member_type, field_code) + ";\n"
                                arm_known[safe_alias] = nt2
                            case none:
                                pass
                    case none:
                        pass
            case none:
                pass
        body = self.codegen_block(arm.body, indent + "    ", arm_known, broken_flag, expected_return)
        return "if (" + tag_check + ") {\n" + prelude + body + "\n" + indent + "}"

    # This subset's `for` only supports two iterable shapes -- a list
    # literal, compiled to a small fixed-size C array plus an index loop,
    # and a call to `range`, compiled straight to a C counting loop reusing
    # the loop target itself as the counter (already declared `long` at
    # the top of the enclosing function, since IntType is what
    # infer_for_iterable_element_type always gives `range`'s element type)
    # -- see infer_for_iterable_element_type / check_for_iterable_element_type.
    # `if_broken` reuses the same flag-variable trick as While's.
    def codegen_for(self, node: For, indent: str, known: dict[str, LType], broken_flag: str | none, expected_return: LType | none) -> str:
        target_name = self.ident_pattern_name(node.target)
        has_if_broken = false
        loop_flag = ""
        match node.if_broken_body as broken_body:
            case list[Stmt]:
                has_if_broken = true
                loop_flag = "__lucid_broke_" + str(node.span.line) + "_" + str(node.span.column)
            case none:
                pass
        inner_flag: str | none = none
        if has_if_broken:
            inner_flag = loop_flag
        body_indent = indent + "    "
        header_indent = indent
        if has_if_broken:
            body_indent = indent + "        "
            header_indent = indent + "    "
        body = self.codegen_block(node.body, body_indent, known, inner_flag, expected_return)

        loop_text = header_indent + "/* unsupported for-loop iterable */"
        match node.iterable as it:
            case ListExpr:
                elem_type = self.infer_for_iterable_element_type(node.iterable, known)
                ctype = "long"
                match elem_type as et:
                    case LType:
                        ctype = c_type_of(et)
                    case none:
                        pass
                elements: list[str] = []
                for e in it.elements:
                    elements.append(self.codegen_expr(e, known))
                arr_name = "__lucid_for_arr_" + str(node.span.line) + "_" + str(node.span.column)
                idx_name = "__lucid_for_i_" + str(node.span.line) + "_" + str(node.span.column)
                arr_decl = header_indent + ctype + " " + arr_name + "[] = {" + join_with(elements, ", ") + "};"
                loop_open = header_indent + "for (long " + idx_name + " = 0; " + idx_name + " < " + str(len(elements)) + "; " + idx_name + "++) {"
                assign = body_indent + target_name + " = " + arr_name + "[" + idx_name + "];"
                loop_text = arr_decl + "\n" + loop_open + "\n" + assign + "\n" + body + "\n" + header_indent + "}"
            case Call:
                is_range_call = false
                match it.func as callee:
                    case Ident:
                        if callee.name == "range":
                            is_range_call = true
                            start_code = "0"
                            stop_code = "0"
                            if len(it.args) == 1:
                                stop_code = self.codegen_expr(it.args[0].value, known)
                            if len(it.args) == 2:
                                start_code = self.codegen_expr(it.args[0].value, known)
                                stop_code = self.codegen_expr(it.args[1].value, known)
                            # Hoist both bounds into their own C locals,
                            # evaluated once, and drive the loop with a
                            # hidden counter rather than `target_name`
                            # itself -- Lucid evaluates range(...)'s
                            # arguments once and re-binds the loop target
                            # fresh each iteration, so a body that
                            # reassigns the target (or a bound expression
                            # with side effects) must not change how many
                            # iterations run.
                            suffix = str(node.span.line) + "_" + str(node.span.column)
                            start_var = "__lucid_for_start_" + suffix
                            stop_var = "__lucid_for_stop_" + suffix
                            idx_name = "__lucid_for_i_" + suffix
                            decls = header_indent + "long " + start_var + " = " + start_code + ";\n" + header_indent + "long " + stop_var + " = " + stop_code + ";"
                            loop_open = header_indent + "for (long " + idx_name + " = " + start_var + "; " + idx_name + " < " + stop_var + "; " + idx_name + "++) {"
                            assign = body_indent + target_name + " = " + idx_name + ";"
                            loop_text = decls + "\n" + loop_open + "\n" + assign + "\n" + body + "\n" + header_indent + "}"
                    case _:
                        pass
                if not is_range_call:
                    # `for n in sorted_names(result.members):`
                    # (`types.lucid`'s own `mangle_component`) -- any
                    # other call (not `range`), whose own return type is
                    # a list[T]/set[T]/dict[str, T], is iterated exactly
                    # like the general (non-Call, non-literal) case just
                    # below -- this used to leave `loop_text` as the
                    # "unsupported" placeholder for anything but `range`.
                    match self.infer_expr_type(node.iterable, known) as ctype:
                        case ListType:
                            csuffix = str(node.span.line) + "_" + str(node.span.column)
                            clist_var = "__lucid_for_list_" + csuffix
                            cidx_name = "__lucid_for_i_" + csuffix
                            citerable_code = self.codegen_expr(node.iterable, known)
                            clist_ctype = "lucid_list_" + mangle_component(ctype.element_type) + " *"
                            cdecl = header_indent + clist_ctype + " " + clist_var + " = " + citerable_code + ";"
                            cloop_open = header_indent + "for (long " + cidx_name + " = 0; " + cidx_name + " < " + clist_var + "->len; " + cidx_name + "++) {"
                            cassign = body_indent + target_name + " = " + clist_var + "->items[" + cidx_name + "];"
                            loop_text = cdecl + "\n" + cloop_open + "\n" + cassign + "\n" + body + "\n" + header_indent + "}"
                        case SetType:
                            csuffix2 = str(node.span.line) + "_" + str(node.span.column)
                            cset_var = "__lucid_for_set_" + csuffix2
                            cidx_name2 = "__lucid_for_i_" + csuffix2
                            citerable_code2 = self.codegen_expr(node.iterable, known)
                            cset_ctype = "lucid_set_" + mangle_component(ctype.element_type) + " *"
                            cdecl2 = header_indent + cset_ctype + " " + cset_var + " = " + citerable_code2 + ";"
                            cloop_open2 = header_indent + "for (long " + cidx_name2 + " = 0; " + cidx_name2 + " < " + cset_var + "->len; " + cidx_name2 + "++) {"
                            cassign2 = body_indent + target_name + " = " + cset_var + "->items[" + cidx_name2 + "];"
                            loop_text = cdecl2 + "\n" + cloop_open2 + "\n" + cassign2 + "\n" + body + "\n" + header_indent + "}"
                        case DictType:
                            csuffix3 = str(node.span.line) + "_" + str(node.span.column)
                            cdict_var = "__lucid_for_dict_" + csuffix3
                            cidx_name3 = "__lucid_for_i_" + csuffix3
                            citerable_code3 = self.codegen_expr(node.iterable, known)
                            cdict_ctype = "lucid_dict_str_" + mangle_component(ctype.value_type) + " *"
                            cdecl3 = header_indent + cdict_ctype + " " + cdict_var + " = " + citerable_code3 + ";"
                            cloop_open3 = header_indent + "for (long " + cidx_name3 + " = 0; " + cidx_name3 + " < " + cdict_var + "->len; " + cidx_name3 + "++) {"
                            cassign3 = body_indent + target_name + " = " + cdict_var + "->keys[" + cidx_name3 + "];"
                            loop_text = cdecl3 + "\n" + cloop_open3 + "\n" + cassign3 + "\n" + body + "\n" + header_indent + "}"
                        case _:
                            pass
            case _:
                # A list[T]/set[T]-typed value, or a dict[str, T]'s own
                # keys, that isn't a literal in this `for` -- a variable,
                # a field, a call -- iterated by index over the
                # underlying struct's own `->len` plus `->items` (list,
                # set) or `->keys` (dict, self-host/checker.lucid's own
                # dominant `for cname in self.classes:` shape, once
                # class/list-valued dicts made this a real need),
                # evaluated once into a hoisted pointer (matching how
                # `range(...)`'s bounds are hoisted above: the iterable
                # expression, if it has any side effect, shouldn't run
                # once per iteration).
                match self.infer_expr_type(node.iterable, known) as rtype:
                    case ListType:
                        suffix = str(node.span.line) + "_" + str(node.span.column)
                        list_var = "__lucid_for_list_" + suffix
                        idx_name = "__lucid_for_i_" + suffix
                        iterable_code = self.codegen_expr(node.iterable, known)
                        list_ctype = "lucid_list_" + mangle_component(rtype.element_type) + " *"
                        decl = header_indent + list_ctype + " " + list_var + " = " + iterable_code + ";"
                        loop_open = header_indent + "for (long " + idx_name + " = 0; " + idx_name + " < " + list_var + "->len; " + idx_name + "++) {"
                        assign = body_indent + target_name + " = " + list_var + "->items[" + idx_name + "];"
                        loop_text = decl + "\n" + loop_open + "\n" + assign + "\n" + body + "\n" + header_indent + "}"
                    case SetType:
                        suffix2 = str(node.span.line) + "_" + str(node.span.column)
                        set_var = "__lucid_for_set_" + suffix2
                        idx_name2 = "__lucid_for_i_" + suffix2
                        iterable_code2 = self.codegen_expr(node.iterable, known)
                        set_ctype = "lucid_set_" + mangle_component(rtype.element_type) + " *"
                        decl2 = header_indent + set_ctype + " " + set_var + " = " + iterable_code2 + ";"
                        loop_open2 = header_indent + "for (long " + idx_name2 + " = 0; " + idx_name2 + " < " + set_var + "->len; " + idx_name2 + "++) {"
                        assign2 = body_indent + target_name + " = " + set_var + "->items[" + idx_name2 + "];"
                        loop_text = decl2 + "\n" + loop_open2 + "\n" + assign2 + "\n" + body + "\n" + header_indent + "}"
                    case DictType:
                        suffix3 = str(node.span.line) + "_" + str(node.span.column)
                        dict_var = "__lucid_for_dict_" + suffix3
                        idx_name3 = "__lucid_for_i_" + suffix3
                        iterable_code3 = self.codegen_expr(node.iterable, known)
                        dict_ctype = "lucid_dict_str_" + mangle_component(rtype.value_type) + " *"
                        decl3 = header_indent + dict_ctype + " " + dict_var + " = " + iterable_code3 + ";"
                        loop_open3 = header_indent + "for (long " + idx_name3 + " = 0; " + idx_name3 + " < " + dict_var + "->len; " + idx_name3 + "++) {"
                        assign3 = body_indent + target_name + " = " + dict_var + "->keys[" + idx_name3 + "];"
                        loop_text = decl3 + "\n" + loop_open3 + "\n" + assign3 + "\n" + body + "\n" + header_indent + "}"
                    case _:
                        pass

        if has_if_broken:
            match node.if_broken_body as broken_body:
                case list[Stmt]:
                    broken_code = self.codegen_block(broken_body, indent + "    ", known, broken_flag, expected_return)
                    return indent + "{\n" + indent + "    int " + loop_flag + " = 0;\n" + loop_text + "\n" + indent + "    if (" + loop_flag + ") {\n" + broken_code + "\n" + indent + "    }\n" + indent + "}"
                case none:
                    pass
        return loop_text

    def c_param_list(self, params: list[Param]) -> str:
        names: list[str] = []
        for p in params:
            match resolve_type_expr(p.type_annotation) as pt:
                case LType:
                    names.append(c_type_of(pt) + " " + c_safe_ident(p.name))
                case none:
                    names.append("long " + c_safe_ident(p.name))
        joined = join_with(names, ", ")
        if joined == "":
            return "void"
        return joined

    def collect_local_names(self, stmts: list[Stmt], names: set[str]):
        # Every local Lucid name stays visible for the rest of its
        # enclosing function, not just the block it's first assigned in
        # (see the header comment) -- so every VarDef/Assignment target
        # anywhere in the body, including nested if/while blocks, becomes
        # one C declaration hoisted to the top of the generated C
        # function, and codegen_stmt itself never declares one.
        for s in stmts:
            match s as result:
                case VarDef:
                    names.add(self.ident_pattern_name(result.pattern))
                case Assignment:
                    match result.target as target:
                        case Attribute:
                            # A field write, not a local -- nothing to
                            # hoist a declaration for.
                            pass
                        case Index:
                            # A dict item write (`known[name] = t`) --
                            # same as Attribute, not a local.
                            pass
                        case _:
                            names.add(self.ident_target_name(result.target))
                case If:
                    self.collect_local_names(result.then_branch, names)
                    for branch in result.elif_branches:
                        self.collect_local_names(branch.body, names)
                    match result.else_branch as else_body:
                        case list[Stmt]:
                            self.collect_local_names(else_body, names)
                        case none:
                            pass
                case While:
                    self.collect_local_names(result.body, names)
                    match result.if_broken_body as broken_body:
                        case list[Stmt]:
                            self.collect_local_names(broken_body, names)
                        case none:
                            pass
                case For:
                    names.add(self.ident_pattern_name(result.target))
                    self.collect_local_names(result.body, names)
                    match result.if_broken_body as broken_body:
                        case list[Stmt]:
                            self.collect_local_names(broken_body, names)
                        case none:
                            pass
                case MatchStmt:
                    # NOT the subject_alias itself -- codegen_match_arm
                    # declares that inline, inside each arm's own C
                    # block, since it has a different type per arm (see
                    # its own header comment); only an ordinary local a
                    # match arm's body happens to declare or assign
                    # needs hoisting the normal way.
                    for arm in result.arms:
                        self.collect_local_names(arm.body, names)
                case _:
                    pass

    def infer_local_types(self, stmts: list[Stmt], known: dict[str, LType]):
        # A first pass purely to learn each local's type before emitting
        # any code, since a name used before its own VarDef/Assignment
        # appears later in the same function (legal in Lucid -- see the
        # header comment) would otherwise codegen with an unknown type.
        # Mirrors codegen_stmt/codegen_expr's own type propagation without
        # emitting anything.
        for s in stmts:
            match s as result:
                case VarDef:
                    inferred: LType | none = resolve_type_expr(result.type_annotation)
                    if inferred == none:
                        match result.value as v:
                            case Expr:
                                inferred = self.infer_expr_type(v, known)
                            case none:
                                pass
                    match inferred as it:
                        case LType:
                            known[self.ident_pattern_name(result.pattern)] = it
                        case none:
                            pass
                case Assignment:
                    match result.target as target:
                        case Attribute:
                            pass
                        case Index:
                            pass
                        case _:
                            match self.infer_expr_type(result.value, known) as it:
                                case LType:
                                    # Mirrors checker.lucid's own bind():
                                    # a name already established (by an
                                    # earlier VarDef/Assignment in this
                                    # same pre-pass) as a wider union
                                    # keeps that union -- this specific
                                    # assignment's own narrower type
                                    # (including NoneType, a
                                    # reassignment back to `none`) must
                                    # not downgrade it, or codegen_body's
                                    # declaration loop would hoist the
                                    # wrong C type from whichever
                                    # assignment happened to run last in
                                    # this pass.
                                    name = self.ident_target_name(result.target)
                                    match known.get(name, none) as existing:
                                        case UnionLType:
                                            pass
                                        case ClassType:
                                            # Same reasoning, one level
                                            # narrower: an established
                                            # plain sealed-base class
                                            # (`Expr`) reassigned a
                                            # concrete subtype
                                            # (`LiteralExpr`) later
                                            # keeps the wider type too.
                                            if not class_assignable_to(self.classes, it, existing):
                                                known[name] = it
                                        case _:
                                            known[name] = it
                                case none:
                                    pass
                case If:
                    self.infer_local_types(result.then_branch, known)
                    for branch in result.elif_branches:
                        self.infer_local_types(branch.body, known)
                    match result.else_branch as else_body:
                        case list[Stmt]:
                            self.infer_local_types(else_body, known)
                        case none:
                            pass
                case While:
                    self.infer_local_types(result.body, known)
                    match result.if_broken_body as broken_body:
                        case list[Stmt]:
                            self.infer_local_types(broken_body, known)
                        case none:
                            pass
                case For:
                    match self.infer_for_iterable_element_type(result.iterable, known) as et:
                        case LType:
                            known[self.ident_pattern_name(result.target)] = et
                        case none:
                            pass
                    self.infer_local_types(result.body, known)
                    match result.if_broken_body as broken_body:
                        case list[Stmt]:
                            self.infer_local_types(broken_body, known)
                        case none:
                            pass
                case MatchStmt:
                    # Same reasoning as collect_local_names's own
                    # MatchStmt case -- the subject_alias isn't an
                    # ordinary local here either. But unlike
                    # collect_local_names (which only needs *names*),
                    # this pre-pass needs each arm's own alias correctly
                    # *typed* too, mirroring what codegen_match_arm/
                    # codegen_sealed_match_arm actually bind at codegen
                    # time -- otherwise any later local inferred from an
                    # expression built on the alias (`for m in
                    # it.members:` inside a `case UnionLType:` arm,
                    # types.lucid's own dominant shape) silently falls
                    # back to `long`, a real, previously-undiscovered
                    # gap this subset's own `infer_local_types` had from
                    # the start -- masked until checker.lucid/
                    # types.lucid's own sources, which lean on this
                    # shape constantly, started compiling through this
                    # pipeline. Set directly on `known` (not a copy),
                    # mirroring how a plain `for` loop's own target
                    # already works just above -- an alias is never
                    # itself hoisted as a separate C local (see
                    # codegen_match_arm's own comment), so there's
                    # nothing to preserve across arms.
                    match self.infer_expr_type(result.subject, known) as subject_t:
                        case LType:
                            for arm in result.arms:
                                match self.arm_narrowed_type(subject_t, arm.pattern) as narrowed4:
                                    case NoneType:
                                        # `case none:` never binds its own
                                        # alias (see check_match's own
                                        # rule -- 'none' isn't a value
                                        # this subset can bind a name to
                                        # at all), the same reason
                                        # codegen_match_arm's own
                                        # NoneType case never emits a
                                        # prelude either. Binding it here
                                        # anyway (a real bug in this
                                        # fix's own first version) left a
                                        # LATER `case none:` arm's own
                                        # unrelated alias name silently
                                        # overwritten to NoneType in
                                        # `known`, for the rest of the
                                        # pre-pass -- caught by
                                        # checker.lucid's own check_call,
                                        # which reuses the name `at`
                                        # across a `case Attribute:` arm
                                        # sibling to the one that
                                        # actually needed it typed.
                                        pass
                                    case LType:
                                        match result.subject_alias as alias4:
                                            case str:
                                                known[c_safe_ident(alias4)] = narrowed4
                                            case none:
                                                pass
                                    case none:
                                        pass
                                self.infer_local_types(arm.body, known)
                        case none:
                            for arm in result.arms:
                                self.infer_local_types(arm.body, known)
                case _:
                    pass

    # The type an arm's own alias narrows to, mirroring codegen_match_arm
    # (a union subject) and codegen_sealed_match_arm (a sealed-class
    # subject, where a wildcard arm binds the root type itself, unnarrowed
    # -- see check_sealed_match's own comment on why) -- used only by
    # infer_local_types' own MatchStmt case, to correctly type-infer any
    # local declared from an expression built on the alias.
    def arm_narrowed_type(self, subject_type: LType, pat: Pattern) -> LType | none:
        match subject_type as st:
            case UnionLType:
                match pat as p:
                    case TypePattern:
                        return resolve_type_expr(p.type_expr)
                    case LiteralPattern:
                        return NoneType()
                    case _:
                        return none
            case ClassType:
                match pat as p2:
                    case TypePattern:
                        return resolve_type_expr(p2.type_expr)
                    case WildcardPattern:
                        return st
                    case _:
                        return none
            case _:
                return none

    # Shared by codegen_function and codegen_entry_point: two passes --
    # first learn every local's type (needed since a local can be used,
    # in a later statement, before codegen has otherwise seen its own
    # declaration's type -- e.g. a call whose argument type determines
    # dispatch resolution, referencing a variable assigned earlier in
    # the same straight-line body but after codegen_block would have
    # inferred it lazily), then emit, with every local (besides a
    # parameter) declared once, hoisted to the top.
    # `exclude` is only ever non-empty for codegen_entry_point's own
    # call: a top-level name is already declared as a real C global
    # (see module_scope's header comment), so `main()`'s own body must
    # not ALSO hoist a local declaration for it -- that would shadow
    # the global with an uninitialized local for the rest of `main()`,
    # so the initializing assignment further down in the same body
    # would write to the wrong variable. Every other caller
    # (codegen_function, codegen_method) passes an empty set here.
    def codegen_body(self, params: list[Param], body: list[Stmt], known: dict[str, LType], exclude: set[str], expected_return: LType | none) -> str:
        self.infer_local_types(body, known)
        local_names: set[str] = {}
        self.collect_local_names(body, local_names)
        param_names: set[str] = {}
        for p in params:
            param_names.add(c_safe_ident(p.name))
        declarations: list[str] = []
        for name in local_names:
            if name not in param_names and name not in exclude:
                match known.get(name, none) as t:
                    case LType:
                        declarations.append("    " + c_type_of(t) + " " + name + ";")
                    case none:
                        declarations.append("    long " + name + ";")
        body_code = self.codegen_block(body, "    ", known, none, expected_return)
        return join_with(declarations, "\n") + "\n" + body_code

    def codegen_function(self, fn: FunctionDef, sig: FuncSig) -> str:
        param_list = self.c_param_list(fn.params)
        known: dict[str, LType] = copy_type_scope(self.module_scope)
        i = 0
        while i < len(fn.params) and i < len(sig.param_types):
            known[c_safe_ident(fn.params[i].name)] = sig.param_types[i]
            i = i + 1
        full_body = self.codegen_body(fn.params, fn.body, known, {}, sig.return_type)
        c_name = mangled_name(self.functions, sig)
        return c_type_of(sig.return_type) + " " + c_name + "(" + param_list + ") {\n" + full_body + "\n}"

    # The module's top-level statements -- the only thing `lucid run`
    # actually executes directly, and the only thing that becomes C's
    # own `int main(void)` (see codegen_module's header comment). No
    # enclosing function to return from, so no expected_return either --
    # checker.lucid already rejects a `return` outside a function, and a
    # top-level `?` is rejected the same way (check_propagate's own
    # `expected_return` is `none` here for exactly that reason).
    def codegen_entry_point(self, top_level: list[Stmt]) -> str:
        known: dict[str, LType] = {:}
        module_names: set[str] = {}
        for name in self.module_scope:
            module_names.add(name)
        full_body = self.codegen_body([], top_level, known, module_names, none)
        return "int main(void) {\n" + full_body + "\n}"

    def codegen_forward_decl(self, fn: FunctionDef, sig: FuncSig) -> str:
        return c_type_of(sig.return_type) + " " + mangled_name(self.functions, sig) + "(" + self.c_param_list(fn.params) + ");"

    def signature_for(self, fn: FunctionDef) -> FuncSig | none:
        param_types: list[LType] = []
        for p in fn.params:
            match resolve_type_expr(p.type_annotation) as pt:
                case LType:
                    param_types.append(pt)
                case none:
                    return none
        return find_signature(self.functions, fn.name, param_types)

    # Every distinct union type this module's registered functions,
    # methods, and class fields actually use -- collect_declarations
    # already built self.functions/self.classes from every
    # FunctionStmt/ClassDef in the module, so scanning those two tables
    # directly is a complete enumeration, not a second AST walk that
    # could miss one. A union-typed *field* (self-host/ast.lucid's own
    # `alias: str | none`) needs its own struct emitted here exactly
    # like a union *return* type does -- easy to miss, since nothing
    # about a field union shows up in either table's own return-type
    # slot; a first draft only scanned return types and left
    # `lucid_union_Item_none` undeclared the moment any class actually
    # used one only as a field, never as a return type. Deduplicated by
    # types_equal (order-insensitive -- see UnionLType's own header
    # comment) and sorted by mangled name, both for the same
    # reproducible-output reason self.module_scope's own emission sorts.
    # A union type used only as a *local variable's* own declared type
    # (`default: Item | none = none`, self-host/parser.lucid's own
    # `parse_class_member`/`parse_raw_function`) is neither a function/
    # method return type nor a class field -- a third union-usage site
    # collect_union_types' own signature/field scan can't see at all,
    # since a local's declared type never reaches self.functions or
    # self.classes. Left `lucid_union_Item_none` undeclared the moment
    # any local used one only this way, a real, previously-undiscovered
    # gap caught by compiling self-host/parser.lucid itself. Walks
    # every FunctionDef/method body and the module's own top-level
    # statements (all reachable from `all_decls`, the same statement
    # list codegen_module already has on hand), recursing the same way
    # collect_local_names does.
    def collect_var_union_types(self, stmts: list[Stmt], found: list[UnionLType]):
        for s in stmts:
            match s as result:
                case VarDef:
                    match resolve_type_expr(result.type_annotation) as t:
                        case UnionLType:
                            if not union_already_found(found, t):
                                found.append(t)
                        case _:
                            pass
                case FunctionStmt:
                    self.collect_var_union_types(result.function.body, found)
                case ClassDef:
                    for member in result.body:
                        match member as m:
                            case MethodMember:
                                self.collect_var_union_types(m.method.body, found)
                            case _:
                                pass
                case If:
                    self.collect_var_union_types(result.then_branch, found)
                    for branch in result.elif_branches:
                        self.collect_var_union_types(branch.body, found)
                    match result.else_branch as else_body:
                        case list[Stmt]:
                            self.collect_var_union_types(else_body, found)
                        case none:
                            pass
                case While:
                    self.collect_var_union_types(result.body, found)
                    match result.if_broken_body as broken_body:
                        case list[Stmt]:
                            self.collect_var_union_types(broken_body, found)
                        case none:
                            pass
                case For:
                    self.collect_var_union_types(result.body, found)
                    match result.if_broken_body as broken_body:
                        case list[Stmt]:
                            self.collect_var_union_types(broken_body, found)
                        case none:
                            pass
                case MatchStmt:
                    for arm in result.arms:
                        self.collect_var_union_types(arm.body, found)
                case _:
                    pass

    def collect_union_types(self) -> list[UnionLType]:
        found: list[UnionLType] = []
        for name in self.functions.signatures:
            match self.functions.signatures.get(name, none) as sigs:
                case list[FuncSig]:
                    for sig in sigs:
                        self.note_union_type(sig.return_type, found)
                        for pt in sig.param_types:
                            self.note_union_type(pt, found)
                case none:
                    pass
        for cname in self.classes:
            match self.classes.get(cname, none) as cls:
                case ClassSig:
                    for mname in cls.methods:
                        match cls.methods.get(mname, none) as sig:
                            case FuncSig:
                                self.note_union_type(sig.return_type, found)
                                for pt in sig.param_types:
                                    self.note_union_type(pt, found)
                            case none:
                                pass
                    for f in cls.fields:
                        self.note_union_type(f.field_type, found)
                case none:
                    pass
        return sort_union_types(found)

    # `expected_return: LType | none` (checker.lucid's own dominant
    # union-typed *parameter*, once a function/method parameter's type
    # was allowed to be a union at all -- see method_signature_for/
    # collect_function_signature) needs its own tagged struct exactly
    # like a union return type or field does -- collect_union_types'
    # own scan didn't look at param_types at all before, only
    # return_type, since nothing compiled through this pipeline had a
    # union-typed parameter yet.
    def note_union_type(self, t: LType, found: list[UnionLType]):
        match t as ut:
            case UnionLType:
                if not union_already_found(found, ut):
                    found.append(ut)
            case _:
                pass

    # Every dict[str, V] value type registered anywhere -- function/
    # method signatures, class fields, and (like collect_var_union_types)
    # every VarDef's own declared type -- deduplicated by types_equal.
    # Only a ListType value type actually needs its own call to
    # emit_dict_type here (see codegen_module's own call site); a
    # ClassType one is already covered unconditionally, the same way
    # every class's own list type is.
    def collect_dict_value_types(self, all_decls: list[Stmt]) -> list[LType]:
        found: list[LType] = []
        for name in self.functions.signatures:
            match self.functions.signatures.get(name, none) as sigs:
                case list[FuncSig]:
                    for sig in sigs:
                        self.note_dict_value_type(sig.return_type, found)
                        for pt in sig.param_types:
                            self.note_dict_value_type(pt, found)
                case none:
                    pass
        for cname in self.classes:
            match self.classes.get(cname, none) as cls:
                case ClassSig:
                    for mname in cls.methods:
                        match cls.methods.get(mname, none) as sig:
                            case FuncSig:
                                self.note_dict_value_type(sig.return_type, found)
                                for pt in sig.param_types:
                                    self.note_dict_value_type(pt, found)
                            case none:
                                pass
                    for f in cls.fields:
                        self.note_dict_value_type(f.field_type, found)
                case none:
                    pass
        self.collect_var_dict_value_types(all_decls, found)
        return found

    def note_dict_value_type(self, t: LType, found: list[LType]):
        match t as dt:
            case DictType:
                already = false
                for f in found:
                    if types_equal(f, dt.value_type):
                        already = true
                if not already:
                    found.append(dt.value_type)
            case _:
                pass

    def collect_var_dict_value_types(self, stmts: list[Stmt], found: list[LType]):
        for s in stmts:
            match s as result:
                case VarDef:
                    match resolve_type_expr(result.type_annotation) as t:
                        case LType:
                            self.note_dict_value_type(t, found)
                        case none:
                            pass
                case FunctionStmt:
                    self.collect_var_dict_value_types(result.function.body, found)
                case ClassDef:
                    for member in result.body:
                        match member as m:
                            case MethodMember:
                                self.collect_var_dict_value_types(m.method.body, found)
                            case _:
                                pass
                case If:
                    self.collect_var_dict_value_types(result.then_branch, found)
                    for branch in result.elif_branches:
                        self.collect_var_dict_value_types(branch.body, found)
                    match result.else_branch as else_body:
                        case list[Stmt]:
                            self.collect_var_dict_value_types(else_body, found)
                        case none:
                            pass
                case While:
                    self.collect_var_dict_value_types(result.body, found)
                    match result.if_broken_body as broken_body:
                        case list[Stmt]:
                            self.collect_var_dict_value_types(broken_body, found)
                        case none:
                            pass
                case For:
                    self.collect_var_dict_value_types(result.body, found)
                    match result.if_broken_body as broken_body:
                        case list[Stmt]:
                            self.collect_var_dict_value_types(broken_body, found)
                        case none:
                            pass
                case MatchStmt:
                    for arm in result.arms:
                        self.collect_var_dict_value_types(arm.body, found)
                case _:
                    pass

    def codegen_module(self, stmts: list[Stmt]) -> str:
        # Everything `stmts`' own `from .x import ...` statements pull
        # in, transitively (see resolve_all_declarations's own comment
        # in types.lucid) -- unlike checker.lucid's own check_module,
        # codegen actually has to EMIT C for these too, not just
        # register their signatures: self-host/parser.lucid calls
        # `tokenize`, imported from self-host/lexer.lucid, so the
        # generated C for parser.lucid needs tokenize's own C function
        # (and everything it calls -- Lexer's methods, Token/LexError's
        # structs, ...) inlined directly, the same way it would need to
        # be if there were no separate compilation/linking step at all
        # (there isn't one in this subset -- see the header comment).
        # `all_decls` (imported class/function declarations, then this
        # module's own) feeds every pass below that emits a
        # struct/function/method body. A module-level VarDef/Assignment
        # among the imported statements (self-host/lexer.lucid's own
        # `keywords`) is different -- not a declaration these passes
        # know how to skip cleanly, but a real C global that needs
        # declaring *and* initializing, exactly like this module's own
        # top-level statements -- so it goes into `top_level` instead,
        # ahead of this module's own (an imported global must exist
        # before anything in this module's own top-level code could
        # read it).
        imported: list[Stmt] = resolve_all_declarations(stmts, {})
        self.collect_declarations(imported)
        self.collect_declarations(stmts)
        all_decls: list[Stmt] = []
        for d in imported:
            all_decls.append(d)
        for s in stmts:
            all_decls.append(s)
        top_level: list[Stmt] = []
        for stmt in imported:
            match stmt as result:
                case ClassDef:
                    pass
                case FunctionStmt:
                    pass
                case _:
                    top_level.append(stmt)
        for stmt in stmts:
            match stmt as result:
                case ClassDef:
                    pass
                case FunctionStmt:
                    pass
                case _:
                    top_level.append(stmt)
        # Learn every module-level name's type before emitting anything
        # that might reference one (a function/method body, or a later
        # top-level statement) -- reusing the exact machinery a
        # function's own local-variable pre-pass already uses
        # (infer_local_types), since "the module's top-level statements"
        # and "a function's own body" are the same kind of statement
        # list here.
        self.infer_local_types(top_level, self.module_scope)
        parts: list[str] = [runtime_prelude, ""]
        # Every class's forward decl (`typedef struct Name Name;`)
        # first, in one pass, before any class's full struct body --
        # this is what lets a field hold a pointer to a class declared
        # earlier or later in the same module (a named struct tag needs
        # only to have been forward-declared to be a valid pointer
        # target, unlike an anonymous by-value struct).
        for stmt in all_decls:
            match stmt as result:
                case ClassDef:
                    match self.classes.get(result.name, none) as cls:
                        case ClassSig:
                            parts.append(emit_struct_forward_decl(cls))
                        case none:
                            pass
                case _:
                    pass
        parts.append("")
        parts.append(emit_list_type(IntType()))
        parts.append("")
        parts.append(emit_list_type(BoolType()))
        parts.append("")
        parts.append(emit_list_type(StrType()))
        parts.append("")
        parts.append(sorted_str_prelude)
        parts.append("")
        parts.append(emit_dict_type(IntType()))
        parts.append("")
        parts.append(emit_dict_type(BoolType()))
        parts.append("")
        parts.append(emit_dict_type(StrType()))
        parts.append("")
        parts.append(emit_set_type(StrType()))
        parts.append("")
        # `lucid_list_<ClassName>` for every class, before any union type
        # or full class struct body -- a union member can itself be
        # `list[SomeClass]` (self-host/lexer.lucid's own `tokenize`,
        # `list[Token] | LexError`), so the list type has to exist
        # before the union struct that references it, the same way it
        # needs to exist before any *other* class's own struct field of
        # that list type. Like the union structs below, this only needs
        # every class's own forward declaration (a list holds a pointer
        # array, not the pointee's full layout), never a full struct
        # body -- so it's safe here, ahead of any of those.
        for stmt in all_decls:
            match stmt as result:
                case ClassDef:
                    match self.classes.get(result.name, none) as cls:
                        case ClassSig:
                            parts.append(emit_list_type(ClassType(cls.name)))
                            parts.append("")
                            # `lucid_dict_str_<ClassName>`, unconditionally
                            # for every class, the same reasoning as the
                            # per-class list type right above -- cheap,
                            # and self-host/checker.lucid's own `classes:
                            # dict[str, ClassSig]`/`known: dict[str,
                            # LType]` (and every other `dict[str,
                            # SomeClass]`) needs its value type's own
                            # dict struct to exist somewhere; scanning
                            # which classes are *actually* used as a
                            # dict value (the same way the union-type
                            # scan below has to, since a union's own
                            # member set isn't "every class") would only
                            # save a few unused struct definitions here.
                            parts.append(emit_dict_type(ClassType(cls.name)))
                            parts.append("")
                        case none:
                            pass
                case _:
                    pass
        # A `dict[str, list[T]]` value type (types.lucid's own
        # `FuncTable.signatures: dict[str, list[FuncSig]]`) isn't covered
        # by either the primitive or the per-class dict emission above --
        # collected the same way collect_var_union_types finds a
        # local-only union type, by walking every function/method body
        # and the module's own top-level statements for a VarDef's own
        # declared type, plus every registered signature/field
        # (collect_declarations already built these tables, so no second
        # walk needed for that half). Emitted after the per-class list
        # types above, since a list-valued dict needs its own element's
        # list struct to already exist.
        all_dict_value_types = self.collect_dict_value_types(all_decls)
        for dt in all_dict_value_types:
            match dt as dtt:
                case ListType:
                    parts.append(emit_dict_type(dtt))
                    parts.append("")
                case _:
                    pass
        # Every union type any registered function/method signature or
        # class field actually uses (`Token | LexError`, `Token | none`,
        # `list[Token] | LexError`, self-host/ast.lucid's own `alias:
        # str | none` and its many siblings, ...), each its own tagged
        # struct -- after every list[T]/dict[str, V] type (including a
        # per-class list[T], just emitted above) and class forward
        # declaration a member could possibly need, but before any full
        # class struct body: a union-typed *field* (unlike a union
        # *return* type) needs its own union struct to already exist
        # for the class's own struct to declare a member of it, so this
        # can't wait until after every class's full struct the way it
        # used to when only return types needed one. collect_union_types
        # scans self.functions/self.classes directly -- the exact
        # signature/field tables collect_declarations already built --
        # rather than walking the AST a second time, so it can't miss
        # one a walk over statements might (a signature or field
        # registered from an import, say). Sorted by name, same
        # reproducibility reason as the module-level globals below.
        all_union_types = self.collect_union_types()
        self.collect_var_union_types(all_decls, all_union_types)
        # `d.get(key, none)` on any `dict[str, V]` (checker.lucid's own
        # dominant `.get()` shape once dict[str, V].get() started
        # returning `V | none` for a `none` default -- see check_call's
        # own DictType case) synthesizes a `V | none` union that never
        # appears as an explicit return type, field, or VarDef annotation
        # anywhere in the source -- neither collect_union_types nor
        # collect_var_union_types can find it. Registering `V | none` for
        # every distinct dict value type found above is an
        # over-approximation (a dict that's only ever read with a
        # same-typed default, never `none`, gets an unused union struct
        # too) rather than walking every expression in the module for an
        # actual `.get(key, none)` call site -- harmless, and far simpler
        # than a second full expression-tree walk.
        for dvt in all_dict_value_types:
            opt_dict_members: list[LType] = []
            opt_dict_members.append(dvt)
            opt_dict_members.append(NoneType())
            opt_dict_union = UnionLType(opt_dict_members)
            if not union_already_found(all_union_types, opt_dict_union):
                all_union_types.append(opt_dict_union)
        for u in sort_union_types(all_union_types):
            parts.append(emit_union_type(u.members))
            parts.append("")
        for stmt in all_decls:
            match stmt as result:
                case ClassDef:
                    match self.classes.get(result.name, none) as cls:
                        case ClassSig:
                            parts.append(emit_struct(self.classes, cls))
                            parts.append("")
                            parts.append(emit_constructor(self.classes, cls))
                            parts.append("")
                            if is_printable_class(cls):
                                parts.append(emit_print_function(cls))
                                parts.append("")
                        case none:
                            pass
                case _:
                    pass
        # Every module-level name as a real, uninitialized (per C's own
        # zero-initialization of `static` storage) C global -- declared
        # here, after every struct/list[T]/dict[str, V] type it could
        # possibly need is already defined, and initialized by
        # codegen_entry_point's own generated `main()` instead (C
        # forbids a non-constant initializer on a `static` global, and
        # `lucid_dict_str_str_of(...)`, say, is a function call, not a
        # compile-time constant). Sorted by name -- dict iteration order
        # in this self-hosted compiler's OWN execution isn't guaranteed
        # stable across runs (the reference interpreter's own
        # Value::Dict is a HashMap), and while an unordered set of
        # independent `static` declarations is harmless either way, a
        # reproducible, diffable generated-C file is worth the one
        # extra call.
        names: list[str] = []
        for name in self.module_scope:
            names.append(name)
        for name in sorted(names):
            match self.module_scope.get(name, none) as t:
                case LType:
                    parts.append("static " + c_type_of(t) + " " + name + ";")
                case none:
                    pass
        parts.append("")
        # Every Lucid function is an ordinary, mangled C function here --
        # including one literally named `main`, which `lucid run` never
        # auto-invokes and which the reference native backend
        # (compiler/crates/lucid-codegen) always mangles too (`lucid_fn_
        # main`, never bare `main`). C's own `main` is a separate,
        # unconditionally synthesized entry point below, built from the
        # module's top-level statements -- the only thing `lucid run`
        # actually executes on its own, and the only thing that becomes
        # C's `int main(void)`. An earlier draft special-cased a Lucid
        # function named `main` into being that entry point directly,
        # which matched neither the interpreter's nor the reference
        # compiler's actual behavior -- a real semantic divergence, not
        # just an unsupported feature.
        for stmt in all_decls:
            match stmt as result:
                case FunctionStmt:
                    match self.signature_for(result.function) as sig:
                        case FuncSig:
                            parts.append(self.codegen_forward_decl(result.function, sig))
                        case none:
                            pass
                case _:
                    pass
        # Every method's forward decl too, in this same "before any
        # body" pass -- a method can call another method (including one
        # declared later in the same class, or a method of a class
        # declared later in the module), a free function can call a
        # method, and a method can call a free function, so none of
        # these bodies can assume the others are already declared.
        for stmt in all_decls:
            match stmt as result:
                case ClassDef:
                    match self.classes.get(result.name, none) as cls:
                        case ClassSig:
                            for member in result.body:
                                match member as m:
                                    case MethodMember:
                                        match method_signature(cls, m.method.name) as sig:
                                            case FuncSig:
                                                parts.append(codegen_method_forward_decl(cls, m.method, sig))
                                            case none:
                                                pass
                                    case _:
                                        pass
                        case none:
                            pass
                case _:
                    pass
        parts.append("")
        for stmt in all_decls:
            match stmt as result:
                case FunctionStmt:
                    match self.signature_for(result.function) as sig:
                        case FuncSig:
                            parts.append(self.codegen_function(result.function, sig))
                            parts.append("")
                        case none:
                            pass
                case _:
                    pass
        for stmt in all_decls:
            match stmt as result:
                case ClassDef:
                    match self.classes.get(result.name, none) as cls:
                        case ClassSig:
                            for member in result.body:
                                match member as m:
                                    case MethodMember:
                                        match method_signature(cls, m.method.name) as sig:
                                            case FuncSig:
                                                parts.append(codegen_method(self, cls, m.method, sig))
                                                parts.append("")
                                            case none:
                                                pass
                                    case _:
                                        pass
                        case none:
                            pass
                case _:
                    pass
        if len(top_level) > 0:
            parts.append(self.codegen_entry_point(top_level))
            parts.append("")
        return join_with(parts, "\n")


# Free functions, not `Codegen` methods -- a bound method taking a
# `ClassSig` as its first parameter beyond `self` was rejected with
# "method accepts fewer arguments than supplied" despite a correct
# signature (the same unresolved checker bug documented in self-host/
# README.md for `emit_struct`, and worked around the same way there and
# in checker.lucid's `check_method`). `cg` stands in for the `Codegen`
# instance's own `self` where one of these needs its instance state.

# Like c_param_list, but for a method: `params[0]` is `self`, always
# untyped in this subset (see method_signature_for's header comment in
# checker.lucid), so its C type is built directly from `cls.name` rather
# than resolved from an annotation -- the rest of the list (`params[1:]`)
# is ordinary c_param_list logic. Needs no `Codegen` instance state.
def codegen_method_param_list(cls: ClassSig, params: list[Param]) -> str:
    parts: list[str] = [cls.name + " *self"]
    i = 1
    while i < len(params):
        p = params[i]
        match resolve_type_expr(p.type_annotation) as pt:
            case LType:
                parts.append(c_type_of(pt) + " " + c_safe_ident(p.name))
            case none:
                parts.append("long " + c_safe_ident(p.name))
        i = i + 1
    return join_with(parts, ", ")

def codegen_method(cg: Codegen, cls: ClassSig, fn: FunctionDef, sig: FuncSig) -> str:
    known: dict[str, LType] = copy_type_scope(cg.module_scope)
    known["self"] = ClassType(cls.name)
    i = 1
    while i < len(fn.params) and i - 1 < len(sig.param_types):
        known[c_safe_ident(fn.params[i].name)] = sig.param_types[i - 1]
        i = i + 1
    full_body = cg.codegen_body(fn.params, fn.body, known, {}, sig.return_type)
    c_name = method_c_name(cls.name, fn.name)
    return c_type_of(sig.return_type) + " " + c_name + "(" + codegen_method_param_list(cls, fn.params) + ") {\n" + full_body + "\n}"

def codegen_method_forward_decl(cls: ClassSig, fn: FunctionDef, sig: FuncSig) -> str:
    return c_type_of(sig.return_type) + " " + method_c_name(cls.name, fn.name) + "(" + codegen_method_param_list(cls, fn.params) + ");"

def copy_type_scope(scope: dict[str, LType]) -> dict[str, LType]:
    copied: dict[str, LType] = {:}
    for key in scope:
        copied[key] = scope[key]
    return copied

def new_codegen() -> Codegen:
    return Codegen(new_func_table(), {:}, {:})

def codegen_module(stmts: list[Stmt]) -> str:
    cg = new_codegen()
    return cg.codegen_module(stmts)
