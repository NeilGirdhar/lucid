    sum_via_for = sum_via_for + y
print(sum_via_for)

def sum_list(zs: list[int]) -> int:
    total = 0
    for z in zs:
        total = total + z
    return total

def make_list() -> list[int]:
    result: list[int] = []
    result.append(1)
    result.append(2)
    result.append(3)
    return result

print(sum_list(make_list()))

