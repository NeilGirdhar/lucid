root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.js]
max_line_length = 100
indent_size = 2

[*.json]
indent_size = 2

[*.lucid]
max_line_length = 100
indent_size = 4

[*.md]
max_line_length = 100
indent_size = 4

[*.py]
max_line_length = 100
indent_size = 4

[*.rs]
max_line_length = 100
indent_size = 4

[*.toml]
max_line_length = 120
indent_size = 2

[*.txt]
max_line_length = 100
indent_size = 2

[*.yml]
max_line_length = 100
indent_size = 2
